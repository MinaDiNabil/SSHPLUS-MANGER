mv $_dir1/cabecalho $_dir1/bot $_dir1/open.py $_dir1/proxy.py $_dir1/wsproxy.py $_dir2
_arq_host="/etc/hosts"
_host[0]="d1n212ccp6ldpw.cloudfront.net"
_host[1]="dns.whatsapp.net"
_host[2]="portalrecarga.vivo.com.br/recarga"
_host[3]="navegue.vivo.com.br/controle/"
_host[4]="navegue.vivo.com.br/pre/"
_host[5]="www.whatsapp.net"
_host[6]="/SSHPLUS?"
for host in ${_host[@]}; do
	if [[ "$(grep -w "$host" $_arq_host | wc -l)" = "0" ]]; then
		sed -i "3i\127.0.0.1 $host" $_arq_host
	fi
done
[[ ! -e /etc/autostart ]] && {
	echo '#!/bin/bash
clear
#INICIO AUTOMATICO' >/etc/autostart
	chmod +x /etc/autostart
} || {
	[[ $(ps x | grep "bot_plus" | grep -v grep | wc -l) != '0' ]] && wget -qO- https://raw.githubusercontent.com/MinaDiNabil/SSHPLUS-MANGER/main/Install/ShellBot.sh
	for proc in $(ps x | grep 'dmS' | grep -v 'grep' | awk {'print $1'}); do
		screen -r -S "$proc" -X quit	
done
	screen -wipe >/dev/null
	echo '#!/bin/bash
clear
#INICIO AUTOMATICO' >/etc/autostart
	chmod +x /etc/autostart
}
crontab -r >/dev/null 2>&1
(
	crontab -l 2>/dev/null
	echo "@daily /bin/verifatt"
	echo "@reboot /etc/autostart"
	echo "* * * * * /etc/autostart"
	echo "0 */6 * * * /bin/uexpired"
) | crontab -
echo "$_lvk" | sed -n '1 p' | cut -d' ' -f2 >/bin/versao && cat /bin/versao >/home/sshplus
wget https://github.com/MinaDiNabil/SSHPLUS-MANGER/raw/main/Install/jq-linux64 >/dev/null 2>&1
chmod +x jq-linux64 && mv jq-linux64 $(which jq)

# Apply system optimizations for better performance and stability
cat >> /etc/sysctl.conf << 'SYSCTL_EOF'
# SSHPLUS Basic Optimizations
net.core.somaxconn = 65535
net.core.netdev_max_backlog = 65536
net.ipv4.tcp_rmem = 4096 87380 16777216
net.ipv4.tcp_wmem = 4096 65536 16777216
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_fin_timeout = 15
net.ipv4.tcp_keepalive_time = 600
net.ipv4.tcp_keepalive_intvl = 60
net.ipv4.tcp_keepalive_probes = 3
net.ipv4.ip_local_port_range = 1024 65535
net.ipv4.tcp_syncookies = 1
net.ipv4.tcp_max_syn_backlog = 8192
net.ipv4.ip_forward = 1
fs.file-max = 2097152
vm.swappiness = 10
SYSCTL_EOF
sysctl -p >/dev/null 2>&1

# Increase file descriptor limits
cat >> /etc/security/limits.conf << 'LIMITS_EOF'
* soft nofile 524288
* hard nofile 524288
root soft nofile 524288
root hard nofile 524288
LIMITS_EOF

# Auto-install protocols
echo ""
echo -e "\033[1;32m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e "\033[1;36m         AUTO-INSTALLING PROTOCOLS         \033[0m"
echo -e "\033[1;32m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo ""

# 1. Install Dropbear on ports 110 and 143
echo -e "\033[1;33m[1/4] Installing Dropbear (ports 110, 143)...\033[0m"
apt-get update -y >/dev/null 2>&1
apt-get install dropbear -y >/dev/null 2>&1
sed -i 's/NO_START=1/NO_START=0/g' /etc/default/dropbear
sed -i "s/DROPBEAR_PORT=22/DROPBEAR_PORT=110/g" /etc/default/dropbear
sed -i 's/DROPBEAR_EXTRA_ARGS=/DROPBEAR_EXTRA_ARGS="-p 143"/g' /etc/default/dropbear
service dropbear start >/dev/null 2>&1
/etc/init.d/dropbear restart >/dev/null 2>&1
[[ $(grep -c "/bin/false" /etc/shells) = '0' ]] && echo "/bin/false" >>/etc/shells
echo -e "\033[1;32m   ✓ Dropbear installed on ports 110, 143\033[0m"

# 2. Install SSL TUNNEL on port 443 connecting to Dropbear port 110
echo -e "\033[1;33m[2/4] Installing SSL TUNNEL (port 443 → 110)...\033[0m"
apt-get install stunnel4 -y >/dev/null 2>&1
cd /etc/stunnel/
wget -q https://raw.githubusercontent.com/MinaDiNabil/SSHPLUS-MANGER/main/Install/cert -O cert.pem
wget -q https://raw.githubusercontent.com/MinaDiNabil/SSHPLUS-MANGER/main/Install/key -O key.pem
chmod 600 cert.pem key.pem
sed -i 's/ENABLED=0/ENABLED=1/g' /etc/default/stunnel4
cat > /etc/stunnel/stunnel.conf <<-STUNNEL_EOF
cert = /etc/stunnel/cert.pem
key = /etc/stunnel/key.pem
client = no
socket = a:SO_REUSEADDR=1
socket = l:TCP_NODELAY=1
socket = r:TCP_NODELAY=1

[stunnel]
connect = 127.0.0.1:110
accept = 443
STUNNEL_EOF
chmod 644 /etc/stunnel/stunnel.conf
service stunnel4 stop >/dev/null 2>&1
service stunnel4 start >/dev/null 2>&1
service stunnel4 restart >/dev/null 2>&1
/etc/init.d/stunnel4 restart >/dev/null 2>&1
cd $HOME
echo -e "\033[1;32m   ✓ SSL TUNNEL installed on port 443 → 110\033[0m"

# 3. Install SOCKS SSH on port 9090
echo -e "\033[1;33m[3/4] Installing SOCKS SSH (port 9090)...\033[0m"
screen -dmS proxy python /etc/SSHPlus/proxy.py 9090
echo -e "netstat -tlpn | grep -w 9090 > /dev/null || {  screen -r -S 'proxy' -X quit;  screen -dmS proxy python /etc/SSHPlus/proxy.py 9090; }" >>/etc/autostart
echo -e "\033[1;32m   ✓ SOCKS SSH installed on port 9090\033[0m"

# 4. Install WEBSOCKET on multiple ports (80, 8080, 8880, 8888) connecting to SSH port 22
echo -e "\033[1;33m[4/4] Installing WEBSOCKET (ports 80, 8080, 8880, 8888 → 22)...\033[0m"
ws_ports=(80 8080 8880 8888)
ws_num=1
for ws_port in "${ws_ports[@]}"; do
	screen -dmS ws$ws_num python /etc/SSHPlus/wsproxy.py $ws_port 22 >/dev/null 2>&1
	echo -e "netstat -tlpn | grep -w $ws_port > /dev/null || screen -dmS ws$ws_num python /etc/SSHPlus/wsproxy.py $ws_port 22" >>/etc/autostart
	((ws_num++))
done
echo -e "\033[1;32m   ✓ WEBSOCKET installed on ports 80, 8080, 8880, 8888 → 22\033[0m"

# 5. Install SlowDNS using new script
echo -e "\033[1;33m[5/5] Installing SlowDNS (ports 53, 5300, 5353)...\033[0m"
cd /tmp
wget -q https://raw.githubusercontent.com/MinaDiNabil/update.link/refs/heads/main/slowdns-v3.1.sh -O slowdns-install.sh
chmod +x slowdns-install.sh
# Run SlowDNS installation in non-interactive mode
bash slowdns-install.sh >/dev/null 2>&1 || echo "SlowDNS installation attempted"
cd $HOME
echo -e "\033[1;32m   ✓ SlowDNS installation completed\033[0m"

echo ""
echo -e "\033[1;32m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e "\033[1;36m    ALL PROTOCOLS INSTALLED SUCCESSFULLY!    \033[0m"
echo -e "\033[1;32m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo ""
sleep 2

