#!/bin/bash
#====================================================
#	@MinaProNet
#====================================================
# Raise this install shell's own ulimits BEFORE any service is started.
# limits.conf/pam_limits only take effect on the NEXT login — every
# screen session and systemd unit spawned later in this script would
# otherwise inherit the install shell's pre-tuning ceilings (typically
# 1024 fds, 4096 procs) and silently cap there. Setting these now
# means every child (wsproxy, proxy.py, open.py, badvpn-udpgw, ...)
# starts with the same headroom the tuning block writes to disk.
ulimit -n 1048576 2>/dev/null || ulimit -n 524288 2>/dev/null
ulimit -u unlimited 2>/dev/null || ulimit -u 1048576 2>/dev/null
ulimit -l unlimited 2>/dev/null

_lvk=$(wget -qO- https://raw.githubusercontent.com/MinaDiNabil/SSHPLUS-MANGER/main/Sistema/versao)
IP=$(wget -qO- ipv4.icanhazip.com)
IP2=$(wget -qO- http://whatismyip.akamai.com/)
[[ "$IP" != "$IP2" ]] && ipdovps="$IP2" || ipdovps="$IP"
echo -e "$ipdovps" >/etc/IP
lst=$1 && lst1=$2 && lst2=$3 && key1=$4 && key2=crz
echo -e "America/Sao_Paulo" >/etc/timezone
ln -fs /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime >/dev/null 2>&1
dpkg-reconfigure --frontend noninteractive tzdata >/dev/null 2>&1
[[ -z $lst1 ]] && {
	rm -rf $_Ink/list >/dev/null 2>&1 && cat /dev/null >~/.bash_history && history -c && exit 0
}
[[ ! -d /etc/SSHPlus ]] && mkdir /etc/SSHPlus
[[ ! -d /etc/SSHPlus/v2ray ]] && mkdir /etc/SSHPlus/v2ray
[[ ! -d /etc/SSHPlus/senha ]] && mkdir /etc/SSHPlus/senha
[[ ! -e /etc/SSHPlus/Exp ]] && touch /etc/SSHPlus/Exp
[[ ! -d /etc/SSHPlus/userteste ]] && mkdir /etc/SSHPlus/userteste
