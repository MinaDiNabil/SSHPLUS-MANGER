rm -f $_dir1/badvpn 2>/dev/null
wget -q https://raw.githubusercontent.com/MinaDiNabil/SSHPLUS-MANGER/main/Sistema/badvpn -O $_dir1/badvpn
if head -n1 $_dir1/badvpn 2>/dev/null | grep -q '^#!/bin/bash'; then
	chmod +x $_dir1/badvpn
else
	# Download produced something that isn't a shell script (404 page,
	# binary, …). Remove it so the menu option fails loudly instead of
	# silently running garbage.
	echo -e "\033[1;31m   ✗ Failed to fetch Sistema/badvpn (menu wrapper). [1] ATIVAR BADVPN will be unavailable.\033[0m"
	rm -f $_dir1/badvpn
fi

mv $_dir1/cabecalho $_dir1/bot $_dir1/open.py $_dir1/proxy.py $_dir1/wsproxy.py $_dir2
_arq_host="/etc/hosts"
_host[0]="d1n212ccp6ldpw.cloudfront.net"
_host[1]="dns.whatsapp.net"
_host[2]="portalrecarga.vivo.com.br/recarga"
_host[3]="navegue.vivo.com.br/controle/"
_host[4]="navegue.vivo.com.br/pre/"
_host[5]="www.whatsapp.net"
_host[6]="/SSHPLUS?"
for host in ${_host[@]}; do
	if [[ "$(grep -w "$host" $_arq_host | wc -l)" = "0" ]]; then
		sed -i "3i\127.0.0.1 $host" $_arq_host
	fi
done
[[ ! -e /etc/autostart ]] && {
	echo '#!/bin/bash
# flock guard: cron runs this script every minute. If a previous tick
# is still respawning processes (e.g. during a reconnect storm), a
# second concurrent run can spawn duplicate screen sessions for the
# same port and the loser will silently EADDRINUSE. -n means
# non-blocking — if the lock is held, exit immediately and try again
# next minute.
exec 9>/var/lock/sshplus-autostart.lock 2>/dev/null
command -v flock >/dev/null 2>&1 && flock -n 9 || exit 0
clear
# Raise ulimits BEFORE spawning any screen sessions / daemons. Cron
# (which runs this script every minute) inherits its own 1024-fd limit,
# so without this every wsproxy/proxy.py/badvpn watchdog respawn would
# silently cap at 1024 open sockets and refuse new clients well below
# the 1M ceiling the rest of the install configures.
ulimit -n 1048576 2>/dev/null || ulimit -n 524288 2>/dev/null
ulimit -u unlimited 2>/dev/null || ulimit -u 1048576 2>/dev/null
ulimit -l unlimited 2>/dev/null
#INICIO AUTOMATICO' >/etc/autostart
	chmod +x /etc/autostart
} || {
	[[ $(ps x | grep "bot_plus" | grep -v grep | wc -l) != '0' ]] && wget -qO- https://raw.githubusercontent.com/MinaDiNabil/SSHPLUS-MANGER/main/Install/ShellBot.sh
	for proc in $(ps x | grep 'dmS' | grep -v 'grep' | awk {'print $1'}); do
		screen -r -S "$proc" -X quit
done
	screen -wipe >/dev/null
	echo '#!/bin/bash
# flock guard: cron runs this script every minute. If a previous tick
# is still respawning processes (e.g. during a reconnect storm), a
# second concurrent run can spawn duplicate screen sessions for the
# same port and the loser will silently EADDRINUSE. -n means
# non-blocking — if the lock is held, exit immediately and try again
# next minute.
exec 9>/var/lock/sshplus-autostart.lock 2>/dev/null
command -v flock >/dev/null 2>&1 && flock -n 9 || exit 0
clear
# Raise ulimits BEFORE spawning any screen sessions / daemons. Cron
# (which runs this script every minute) inherits its own 1024-fd limit,
# so without this every wsproxy/proxy.py/badvpn watchdog respawn would
# silently cap at 1024 open sockets and refuse new clients well below
# the 1M ceiling the rest of the install configures.
ulimit -n 1048576 2>/dev/null || ulimit -n 524288 2>/dev/null
ulimit -u unlimited 2>/dev/null || ulimit -u 1048576 2>/dev/null
ulimit -l unlimited 2>/dev/null
#INICIO AUTOMATICO' >/etc/autostart
	chmod +x /etc/autostart
}
crontab -r >/dev/null 2>&1
(
	crontab -l 2>/dev/null
	echo "@daily /bin/verifatt"
	echo "@reboot /etc/autostart"
	echo "* * * * * /etc/autostart"
	echo "0 */6 * * * /bin/uexpired"
) | crontab -
echo "$_lvk" | sed -n '1 p' | cut -d' ' -f2 >/bin/versao && cat /bin/versao >/home/sshplus
wget https://github.com/MinaDiNabil/SSHPLUS-MANGER/raw/main/Install/jq-linux64 >/dev/null 2>&1
chmod +x jq-linux64 && mv jq-linux64 $(which jq)

# Apply system optimizations for better performance and stability.
# Use a drop-in under /etc/sysctl.d so re-running the installer never
# duplicates lines, and so users can override anything by adding a
# higher-numbered file. Clean up the legacy block previously appended
# to /etc/sysctl.conf so the drop-in is the single source of truth.
sed -i '/# SSHPLUS Basic Optimizations/,/^vm\.swappiness = 10$/d' /etc/sysctl.conf 2>/dev/null

# Strip prior SSHPLUS limits.conf appendages so the drop-in is canonical
sed -i '/^\* soft nofile 524288$/,/^root hard nofile 524288$/d' /etc/security/limits.conf 2>/dev/null

# The big throughput win on tunneling servers is BBR + fq -
# load tcp_bbr and select it only if available.
modprobe tcp_bbr 2>/dev/null
grep -qx tcp_bbr /etc/modules-load.d/sshplus-bbr.conf 2>/dev/null || \
	echo tcp_bbr > /etc/modules-load.d/sshplus-bbr.conf

if grep -qw bbr /proc/sys/net/ipv4/tcp_available_congestion_control 2>/dev/null; then
	cc_line='net.ipv4.tcp_congestion_control = bbr'
	qdisc_line='net.core.default_qdisc = fq'
else
	cc_line='# bbr unavailable on this kernel; keeping default congestion control'
	qdisc_line='# fq qdisc paired with bbr; left unset since bbr is unavailable'
fi

cat > /etc/sysctl.d/99-sshplus.conf <<SYSCTL_EOF
# SSHPLUS - performance & stability tuning (managed by Install/list)

# --- Congestion control ---
$cc_line
$qdisc_line
net.ipv4.tcp_mtu_probing = 1
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_no_metrics_save = 1
net.ipv4.tcp_window_scaling = 1
net.ipv4.tcp_sack = 1
net.ipv4.tcp_timestamps = 1

# --- Socket buffers (raise ceilings for high-bandwidth tunnels) ---
net.core.rmem_default = 262144
net.core.wmem_default = 262144
net.core.rmem_max = 67108864
net.core.wmem_max = 67108864
net.core.optmem_max = 65536
net.ipv4.tcp_rmem = 4096 262144 67108864
net.ipv4.tcp_wmem = 4096 262144 67108864
net.ipv4.udp_rmem_min = 16384
net.ipv4.udp_wmem_min = 16384

# --- Connection handling (sized for 1M+ user installations) ---
# somaxconn / syn_backlog / netdev_max_backlog all need to be high
# enough that the kernel doesn't drop SYNs when 10K+ clients reconnect
# simultaneously (e.g. after a brief carrier outage).
net.core.somaxconn = 65535
net.core.netdev_max_backlog = 250000
net.ipv4.tcp_max_syn_backlog = 65535
net.ipv4.tcp_syncookies = 1
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_max_tw_buckets = 2000000
net.ipv4.tcp_fin_timeout = 15
net.ipv4.tcp_keepalive_time = 600
net.ipv4.tcp_keepalive_intvl = 60
net.ipv4.tcp_keepalive_probes = 3
net.ipv4.tcp_syn_retries = 3
net.ipv4.tcp_synack_retries = 2
net.ipv4.tcp_orphan_retries = 1
net.ipv4.tcp_retries2 = 5
net.ipv4.ip_local_port_range = 1024 65535
# Allow many concurrent half-open accept queues (one per listener:
# stunnel:443, wsproxy:700, dropbear:110/143, sshd:22, ws*:80…)
net.ipv4.tcp_abort_on_overflow = 0

# --- Forwarding (required for tunneling) ---
net.ipv4.ip_forward = 1

# --- Hardening that also improves stability ---
net.ipv4.tcp_rfc1337 = 1
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
net.ipv4.icmp_echo_ignore_broadcasts = 1

# --- Connection tracking (prevents 'nf_conntrack: table full' under
# load, which silently drops new flows and looks like a tunnel
# outage). Sized for 1M+ user installations: at ~316 bytes per entry,
# 4M entries consume ~1.2 GB of RAM but cover even the worst
# reconnect storms after a carrier outage. ---
net.netfilter.nf_conntrack_max = 4194304
net.nf_conntrack_max = 4194304
net.netfilter.nf_conntrack_tcp_timeout_established = 86400
net.netfilter.nf_conntrack_tcp_timeout_time_wait = 30
net.netfilter.nf_conntrack_tcp_timeout_close_wait = 30
net.netfilter.nf_conntrack_tcp_timeout_fin_wait = 30
net.netfilter.nf_conntrack_buckets = 1048576

# --- Filesystem & memory ---
fs.file-max = 4194304
fs.nr_open = 4194304
vm.swappiness = 10
vm.dirty_ratio = 10
vm.dirty_background_ratio = 5
vm.overcommit_memory = 1

# --- Process & thread ceilings for 1M+ users ---
# Dropbear forks per connection; each fork uses 2-3 threads via
# libpthread. 1M sessions ~= 3M threads. Default kernel.threads-max
# scales with RAM and on a 4GB VPS is only ~32K — would silently
# cap concurrency long before any other limit. pid_max defaults to
# 4M already on modern kernels but pin it explicitly for older ones.
kernel.threads-max = 4194304
kernel.pid_max = 4194304

# --- ARP / neighbor cache for 100K+ unique client IPs ---
# Defaults (128/512/1024) overflow once the box sees more than
# ~1K unique source IPs in the routing-decision window, producing
# `neighbour: arp_cache: neighbor table overflow!` in dmesg and
# random L2 connection drops for tunneled users.
net.ipv4.neigh.default.gc_thresh1 = 4096
net.ipv4.neigh.default.gc_thresh2 = 8192
net.ipv4.neigh.default.gc_thresh3 = 16384
net.ipv6.neigh.default.gc_thresh1 = 4096
net.ipv6.neigh.default.gc_thresh2 = 8192
net.ipv6.neigh.default.gc_thresh3 = 16384

# --- inotify limits for sshmonitor / log watchers ---
# Default max_user_watches=8192 is exhausted by file-activity-heavy
# scripts at scale, silently dropping events. 524288 + 8192 instances
# matches the Debian high-load tuning recommendation.
fs.inotify.max_user_watches = 524288
fs.inotify.max_user_instances = 8192

# --- Netfilter helper auto-loading: OFF ---
# Defaults to ON, which lets the kernel guess that an inbound stream
# is FTP/SIP/H.323/PPTP/IRC and load nf_conntrack_helper_* modules
# automatically. At 1M sessions this is pure CPU waste (helper code
# runs per-packet on candidate flows) AND a security risk
# (heuristic-loaded helpers have historically allowed NAT pinhole
# punching via crafted streams).
net.netfilter.nf_conntrack_helper = 0

# --- Auto-reboot on kernel panic to avoid stuck VPS ---
kernel.panic = 10
kernel.panic_on_oops = 1
SYSCTL_EOF

# nf_conntrack module must be loaded before its sysctls work — and
# the hashsize is only settable as a module parameter, not via sysctl
# on most kernels.
modprobe nf_conntrack 2>/dev/null
echo 1048576 > /sys/module/nf_conntrack/parameters/hashsize 2>/dev/null
grep -qx nf_conntrack /etc/modules-load.d/sshplus-conntrack.conf 2>/dev/null || \
	echo nf_conntrack > /etc/modules-load.d/sshplus-conntrack.conf
# Persist the conntrack hashsize across reboots — sysctl can't set it
# because it's a module parameter, not a kernel tunable.
#
# Preserve any non-hashsize options the admin already configured
# (acct=1, nf_conntrack_helper=1, etc.) by merging instead of
# overwriting. A blanket `cat > file` would silently strip FTP/SIP
# NAT helpers and per-flow byte accounting on the next reboot.
if [[ -f /etc/modprobe.d/nf_conntrack.conf ]]; then
    if grep -qE '^[[:space:]]*options[[:space:]]+nf_conntrack\b' /etc/modprobe.d/nf_conntrack.conf; then
        # Replace any existing hashsize= token in-place; leave other options alone.
        if grep -qE '^[[:space:]]*options[[:space:]]+nf_conntrack\b.*\bhashsize=' /etc/modprobe.d/nf_conntrack.conf; then
            sed -i -E 's|(\boptions[[:space:]]+nf_conntrack\b[^\n]*\bhashsize=)[0-9]+|\11048576|' /etc/modprobe.d/nf_conntrack.conf
        else
            sed -i -E 's|^([[:space:]]*options[[:space:]]+nf_conntrack\b[^\n]*)$|\1 hashsize=1048576|' /etc/modprobe.d/nf_conntrack.conf
        fi
    else
        echo 'options nf_conntrack hashsize=1048576' >> /etc/modprobe.d/nf_conntrack.conf
    fi
else
    echo 'options nf_conntrack hashsize=1048576' > /etc/modprobe.d/nf_conntrack.conf
fi

# Apply the new tunables (and reload anything in /etc/sysctl.d)
sysctl --system >/dev/null 2>&1 || sysctl -p /etc/sysctl.d/99-sshplus.conf >/dev/null 2>&1

# File descriptor / process limits via drop-in (idempotent on re-run).
# Sized for 1M+ users. The wildcard '*' ONLY gets raised file
# descriptors (sockets); nproc=unlimited is reserved for root, NOT
# the wildcard — otherwise an attacker who compromises any service
# account (www-data after a webapp RCE, a tunnel user, etc.) can
# fork until kernel.pid_max is exhausted, locking root out of
# recovery. dropbear runs as root, so the per-user fork cap on
# unprivileged accounts doesn't gate VPN concurrency.
cat > /etc/security/limits.d/99-sshplus.conf <<'LIMITS_EOF'
*       soft    nofile  1048576
*       hard    nofile  1048576
root    soft    nofile  1048576
root    hard    nofile  1048576
*       soft    nproc   65535
*       hard    nproc   65535
root    soft    nproc   unlimited
root    hard    nproc   unlimited
*       soft    memlock unlimited
*       hard    memlock unlimited
LIMITS_EOF

# Make sure systemd services inherit raised limits as well — services
# started via systemd ignore /etc/security/limits.conf entirely.
mkdir -p /etc/systemd/system.conf.d
cat > /etc/systemd/system.conf.d/99-sshplus-limits.conf <<'SYSTEMD_EOF'
[Manager]
DefaultLimitNOFILE=1048576
DefaultLimitNPROC=infinity
DefaultLimitMEMLOCK=infinity
DefaultTasksMax=infinity
SYSTEMD_EOF

# Same for user manager (systemctl --user) so login shells from
# tunneled sessions also inherit the raised ceilings.
mkdir -p /etc/systemd/user.conf.d
cat > /etc/systemd/user.conf.d/99-sshplus-limits.conf <<'SYSTEMD_USER_EOF'
[Manager]
DefaultLimitNOFILE=1048576
DefaultLimitNPROC=infinity
DefaultTasksMax=infinity
SYSTEMD_USER_EOF

systemctl daemon-reload >/dev/null 2>&1

# Entropy daemon - shortens SSH/SSL key-exchange stalls on idle VPS
command -v haveged >/dev/null 2>&1 || apt-get install haveged -y >/dev/null 2>&1
systemctl enable --now haveged >/dev/null 2>&1 || true

# --- CPU governor: performance ---
# Default `powersave`/`ondemand` makes TLS handshakes ~2-3x slower
# because the core stays at base clock during ramp-up. For a
# tunneling server doing 10K+ handshakes/sec the difference is the
# gap between needing 10 cores and 30 cores. We set the governor at
# the file-system level (works without cpufrequtils) and persist
# through cpufrequtils if available.
for _cpu in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
	[[ -w "$_cpu" ]] && echo performance > "$_cpu" 2>/dev/null
done
if apt-get install -y cpufrequtils >/dev/null 2>&1; then
	echo 'GOVERNOR="performance"' > /etc/default/cpufrequtils
	systemctl enable --now cpufrequtils >/dev/null 2>&1 || true
fi

# --- IRQ balancing across cores ---
# Default cloud-image kernels park every NIC IRQ on CPU0, so a 10Gbit
# NIC stops scaling past one core's softirq capacity (~1-2 Gbit on
# commodity hardware). irqbalance redistributes IRQs across all cores.
command -v irqbalance >/dev/null 2>&1 || apt-get install -y irqbalance >/dev/null 2>&1
systemctl enable --now irqbalance >/dev/null 2>&1 || true

# --- RPS (Receive Packet Steering) for single-queue NICs ---
# Most cloud VPS get virtio-net with ONE rx queue, so even with
# irqbalance every received packet is processed by the single softirq
# CPU bound to that queue. RPS distributes the post-NAPI processing
# across all cores. Mask = (1<<NCPU)-1 in hex, written into each
# NIC queue's rps_cpus file. Idempotent and harmless on multi-queue
# NICs (kernel ignores the value).
_rps_cpus_mask=$(printf '%x' $(( (1 << $(nproc 2>/dev/null || echo 1)) - 1 )))
_primary_nic=$(ip -o -4 route show default 2>/dev/null | awk '/dev/{for(i=1;i<=NF;i++) if ($i=="dev") {print $(i+1); exit}}')
if [[ -n "$_primary_nic" && -d "/sys/class/net/$_primary_nic/queues" ]]; then
	for _q in /sys/class/net/$_primary_nic/queues/rx-*/rps_cpus; do
		[[ -w "$_q" ]] && echo "$_rps_cpus_mask" > "$_q" 2>/dev/null
	done
	# Persist across reboots
	cat > /etc/systemd/system/sshplus-rps.service <<-RPS_EOF
	[Unit]
	Description=SSHPlus: enable RPS on $_primary_nic for high-concurrency softirq processing
	After=network-online.target
	Wants=network-online.target

	[Service]
	Type=oneshot
	ExecStart=/bin/sh -c 'for q in /sys/class/net/$_primary_nic/queues/rx-*/rps_cpus; do echo $_rps_cpus_mask > "\$q" 2>/dev/null || true; done'
	RemainAfterExit=yes

	[Install]
	WantedBy=multi-user.target
	RPS_EOF
	systemctl enable sshplus-rps.service >/dev/null 2>&1 || true
fi

# --- Blacklist nf_conntrack helper modules ---
# Pair with `net.netfilter.nf_conntrack_helper = 0` in sysctl: without
# the blacklist the modules can still be loaded explicitly by other
# packages (apparmor, fail2ban, distribution defaults). Stops every
# tunneled-stream packet from being matched against FTP/SIP/IRC
# signatures.
cat > /etc/modprobe.d/sshplus-no-helpers.conf <<'BLACKLIST_EOF'
# SSHPlus: disable nf_conntrack helpers we don't need (CPU + security)
blacklist nf_conntrack_ftp
blacklist nf_conntrack_sip
blacklist nf_conntrack_h323
blacklist nf_conntrack_pptp
blacklist nf_conntrack_amanda
blacklist nf_conntrack_irc
blacklist nf_conntrack_snmp
blacklist nf_conntrack_tftp
blacklist nf_conntrack_sane
BLACKLIST_EOF

# Cap systemd journal so logs cannot fill the root partition
mkdir -p /etc/systemd/journald.conf.d
cat > /etc/systemd/journald.conf.d/99-sshplus.conf <<'JOURNAL_EOF'
[Journal]
SystemMaxUse=200M
SystemKeepFree=500M
RuntimeMaxUse=50M
JOURNAL_EOF
systemctl restart systemd-journald >/dev/null 2>&1 || true

# ZRAM swap - compressed in-memory swap. Prevents OOM kills on
# low-RAM VPS without disk I/O. Only enable when no swap exists yet
# so we don't fight an admin-configured swapfile.
if [[ -z "$(swapon --show=NAME --noheadings 2>/dev/null)" ]]; then
	command -v zramctl >/dev/null 2>&1 || apt-get install zram-tools -y >/dev/null 2>&1
	if [[ -d /etc/default ]] && dpkg -s zram-tools >/dev/null 2>&1; then
		cat > /etc/default/zramswap <<-'ZRAM_EOF'
		ALGO=zstd
		PERCENT=50
		PRIORITY=100
		ZRAM_EOF
		systemctl enable --now zramswap >/dev/null 2>&1 || \
			systemctl restart zramswap >/dev/null 2>&1 || true
	fi
fi

# SSH daemon tuning. UseDNS=no removes the 5-30s reverse-DNS stall
# clients hit on every connect; the rest raises concurrent-session
# ceilings appropriate for a tunneling host. Strip any pre-existing
# copies of these directives so our values win regardless of where
# they appear in the file (sshd uses the first occurrence).
if [[ -f /etc/ssh/sshd_config ]]; then
	sed -i '/# BEGIN SSHPLUS-TUNING/,/# END SSHPLUS-TUNING/d' /etc/ssh/sshd_config
	for key in UseDNS GSSAPIAuthentication ClientAliveInterval ClientAliveCountMax TCPKeepAlive MaxStartups MaxSessions LoginGraceTime; do
		sed -i "/^[[:space:]]*${key}[[:space:]]/d" /etc/ssh/sshd_config
	done
	cat >> /etc/ssh/sshd_config <<-'SSH_EOF'
	# BEGIN SSHPLUS-TUNING
	UseDNS no
	GSSAPIAuthentication no
	TCPKeepAlive yes
	ClientAliveInterval 60
	ClientAliveCountMax 3
	# High-concurrency limits for 1M+ user installations. MaxStartups
	# is the unauth concurrency cap (start:rate:full). 2000:30:5000 is
	# the sweet spot: high enough that reconnect storms after a carrier
	# blip don't get rejected by sshd, but not so high that a SYN/banner
	# flood can pin ~250 MB of preauth state.
	# LoginGraceTime stays at the upstream default 120s — mobile
	# injectors with custom payload + multi-stage SSH+TLS handshake
	# can legitimately take 30-60s on a slow carrier, and the
	# aggressive 30s cap was timing out real users mid-auth.
	MaxStartups 2000:30:5000
	MaxSessions 200
	LoginGraceTime 120
	# END SSHPLUS-TUNING
	SSH_EOF

	if sshd -t 2>/dev/null; then
		systemctl reload ssh >/dev/null 2>&1 || systemctl reload sshd >/dev/null 2>&1 || \
			service ssh reload >/dev/null 2>&1 || true
	else
		# Roll back on syntax error rather than risk locking the user out
		sed -i '/# BEGIN SSHPLUS-TUNING/,/# END SSHPLUS-TUNING/d' /etc/ssh/sshd_config
		echo -e "\033[1;31m   ✗ sshd_config validation failed; tuning rolled back.\033[0m"
	fi
fi

# Report active congestion control so the user knows whether BBR took
active_cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
zram_state=$(swapon --show=NAME --noheadings 2>/dev/null | grep -c zram)
[[ "$zram_state" -gt 0 ]] && zram_msg="zram=on" || zram_msg="zram=off"
echo -e "\033[1;36m   ⚙ Tuning applied (cc=${active_cc:-unknown}, nofile=1048576, nproc=unlimited, conntrack=4M, ${zram_msg}, sshd tuned)\033[0m"

# Auto-install protocols
echo ""
echo -e "\033[1;32m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e "\033[1;36m         AUTO-INSTALLING PROTOCOLS         \033[0m"
echo -e "\033[1;32m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo ""

# 1. Install BadVPN on port 7300
echo -e "\033[1;33m[1/8] Installing BadVPN (port 7300)...\033[0m"
cd $HOME

# Two-track install:
#   1. Debian/Ubuntu `badvpn` package — works on EVERY supported
#      architecture (x86_64, aarch64, armv7, …) and uses signed,
#      distro-maintained binaries. This is the canonical answer.
#   2. Fall back to downloading our pre-built x86_64 binary from
#      the repo only when apt-install failed AND the host is x86_64.
#
# The previous version skipped apt entirely and went straight to
# wget — which silently produced a 404 HTML page on flaky networks
# and broke BadVPN on every non-x86_64 host.
_bv_installed=0
_bv_arch=$(uname -m 2>/dev/null)

if command -v apt-get >/dev/null 2>&1; then
	DEBIAN_FRONTEND=noninteractive apt-get install -y badvpn >/dev/null 2>&1
	if [[ -x /usr/bin/badvpn-udpgw ]] && head -c 4 /usr/bin/badvpn-udpgw 2>/dev/null | grep -q $'\x7fELF'; then
		# Symlink to /bin/badvpn-udpgw so autostart entries and
		# Sistema/badvpn that hard-code the /bin path keep working.
		ln -sf /usr/bin/badvpn-udpgw /bin/badvpn-udpgw 2>/dev/null
		_bv_installed=1
		echo -e "\033[1;32m   ✓ BadVPN installed via apt (Debian/Ubuntu package)\033[0m"
	fi
fi

# x86_64 fallback only — non-x86_64 hosts where apt-install failed
# need a native-arch binary, and our repo only ships x86_64.
if [[ $_bv_installed -eq 0 && ( "$_bv_arch" = "x86_64" || "$_bv_arch" = "amd64" ) ]]; then
	wget -q https://raw.githubusercontent.com/MinaDiNabil/SSHPLUS-MANGER/main/Modulos/badvpn -O /bin/badvpn-udpgw.tmp
	if head -c 4 /bin/badvpn-udpgw.tmp 2>/dev/null | grep -q $'\x7fELF'; then
		install -m 755 /bin/badvpn-udpgw.tmp /bin/badvpn-udpgw
		rm -f /bin/badvpn-udpgw.tmp
		_bv_installed=1
		echo -e "\033[1;32m   ✓ BadVPN installed from repo (x86_64 fallback)\033[0m"
	else
		rm -f /bin/badvpn-udpgw.tmp
	fi
fi

if [[ $_bv_installed -eq 0 ]]; then
	echo -e "\033[1;31m   ✗ BadVPN install failed (apt + wget both failed).\033[0m"
	echo -e "\033[1;33m     Architecture: $_bv_arch — only x86_64 has a repo fallback.\033[0m"
elif ss -lnuH 2>/dev/null | awk '{print $4}' | grep -qE '(^|:)7300$'; then
	echo -e "\033[1;33m   ⚠ Port 7300/udp already in use. BadVPN not started.\033[0m"
else
	# BadVPN args matching the upstream-tested defaults. The previous
	# `--max-clients 1000000` looked impressive but made the daemon
	# try to allocate ~500 MB of slot tables at startup — on most
	# VPS this OOMed instantly and the screen session vanished one
	# second after spawn, leaving the menu's status check reporting
	# "○" forever. 10000 clients is the realistic per-host ceiling
	# for any reasonable VPS and matches the original SSHPLUS args.
	screen -dmS udpvpn /bin/badvpn-udpgw --listen-addr 127.0.0.1:7300 --max-clients 10000 --max-connections-for-client 10 --client-socket-sndbuf 10000
	# Strip every previous BadVPN autostart line so we never end up
	# with two entries fighting for port 7300 (the old `1000000`
	# line + the new `10000` line both racing every cron tick).
	sed -i '/badvpn-udpgw.*--listen-addr 127\.0\.0\.1:7300/d' /etc/autostart 2>/dev/null
	sed -i '/udpvpn/d' /etc/autostart 2>/dev/null
	echo "ps x | grep 'udpvpn' | grep -v 'grep' >/dev/null || screen -dmS udpvpn /bin/badvpn-udpgw --listen-addr 127.0.0.1:7300 --max-clients 10000 --max-connections-for-client 10 --client-socket-sndbuf 10000" >> /etc/autostart

	sleep 1
	if ss -lnuH 2>/dev/null | awk '{print $4}' | grep -qE '(^|:)7300$'; then
		echo -e "\033[1;32m   ✓ BadVPN listening on 127.0.0.1:7300\033[0m"
	else
		echo -e "\033[1;31m   ✗ BadVPN started but is not listening on 7300/udp.\033[0m"
		echo -e "\033[1;33m     Inspect with: screen -r udpvpn  (Ctrl+A,D to detach)\033[0m"
	fi
fi
unset _bv_installed _bv_arch

# 2. Install Squid Proxy on port 3128
echo -e "\033[1;33m[2/8] Installing Squid Proxy (port 3128)...\033[0m"

# Get server IP for Squid configuration
SERVER_IP=$(cat /etc/IP 2>/dev/null || echo "$ipdovps")

# Skip if port 3128 is already bound
if ss -tlnH 2>/dev/null | awk '{print $4}' | grep -qE '(^|:)3128$'; then
	echo -e "\033[1;33m   ⚠ Port 3128 already in use. Skipping Squid install.\033[0m"
else
	# Install Squid (squid3 is obsolete on Debian 11+; fall back gracefully)
	apt-get install squid -y >/dev/null 2>&1 || apt-get install squid3 -y >/dev/null 2>&1

	# Detect squid directory and service name
	if [[ -d "/etc/squid/" ]]; then
		var_sqd="/etc/squid/squid.conf"
		var_pay="/etc/squid/payload.txt"
		squid_service="squid"
	elif [[ -d "/etc/squid3/" ]]; then
		var_sqd="/etc/squid3/squid.conf"
		var_pay="/etc/squid3/payload.txt"
		squid_service="squid3"
	else
		var_sqd=""
	fi

	if [[ -z "$var_sqd" ]]; then
		echo -e "\033[1;31m   ✗ Squid installation failed (config dir not found).\033[0m"
	else
		# Bug-host allow list for plain-HTTP requests through Squid.
		# CONNECT (HTTPS) to any destination is allowed unconditionally
		# below — these entries only matter for non-encrypted GET/POST
		# payloads that mobile injectors send to zero-rated domains.
		# Add one host or .domain per line; ".example.com" matches both
		# example.com and every subdomain.
		cat > $var_pay <<-PAYLOAD_EOF
		.whatsapp.net
		.whatsapp.com
		.facebook.net
		.facebook.com
		.twitter.com
		.speedtest.net
		# Common payment / banking gateways used as bug hosts
		.islamicbank.ps
		.gateway.mastercard.com
		.gbp.ma
		# Captcha CDN endpoints commonly used as bug hosts
		.hcaptcha.com
		.recaptcha.net
		PAYLOAD_EOF

		# Pick a service user that is sure to exist on Debian (proxy) and
		# RHEL/CentOS (squid). The init script chowns /var/run/squid* to
		# this account; if the directive is missing it falls back to
		# something brittle.
		if id -u proxy >/dev/null 2>&1; then
			squid_user="proxy"
		elif id -u squid >/dev/null 2>&1; then
			squid_user="squid"
		else
			squid_user="nobody"
		fi
		# Pid file path differs per distro; declaring it explicitly stops
		# `service ... reload` from claiming the daemon is down because
		# it can't find the pid.
		if [[ "$squid_service" == "squid3" ]]; then
			squid_pid="/var/run/squid3.pid"
		else
			squid_pid="/var/run/squid.pid"
		fi

		# Squid 4/5 has 'all' built-in; 'dstdomain' rejects raw IPs (use 'dst').
		#
		# Allow CONNECT (HTTPS) to any destination on a safe TCP port —
		# the request body is encrypted so Squid cannot be abused to
		# inject content, and this is what makes bug-host SNIs
		# (paysecure.islamicbank.ps, *.gateway.mastercard.com,
		# hcaptcha endpoints, ...) work. Plain HTTP (GET/POST/HEAD)
		# is still restricted to the server itself and to the bug-host
		# list in $var_pay so the proxy cannot be used as an open HTTP
		# relay.
		cat > $var_sqd <<-SQUID_EOF
		acl SSL_ports port 443 8443
		acl Safe_ports port 80 443 1025-65535
		acl CONNECT method CONNECT

		acl loopback dst 127.0.0.1/32
		acl serverip dst $SERVER_IP/32
		acl localhost_dom dstdomain localhost
		acl payload url_regex -i "$var_pay"

		# Hard safety: never CONNECT to a port outside Safe_ports
		# (blocks abuse like CONNECT 25 for spam relays) but allow
		# any CONNECT destination on a safe port, especially 443.
		http_access deny CONNECT !Safe_ports
		http_access allow CONNECT Safe_ports

		http_access allow loopback
		http_access allow serverip
		http_access allow localhost_dom
		http_access allow payload
		http_access deny all

		http_port 3128
		visible_hostname SSHPLUS
		cache_effective_user $squid_user
		pid_filename $squid_pid
		via off
		forwarded_for off
		pipeline_prefetch off
		request_header_access X-Forwarded-For deny all
		request_header_access Via deny all
		request_header_access Forwarded deny all
		request_header_access Proxy-Connection deny all
		request_header_access X-Cache deny all
		request_header_access X-Cache-Lookup deny all
		request_header_access Connection deny all

		# ----- High-concurrency tuning for 1M+ user installations -----
		# Squid defaults to 1024 file descriptors, which caps it at
		# ~500 concurrent CONNECT tunnels. Bumping max_filedesc lets
		# it ride the 1M nofile ceiling from /etc/security/limits.d.
		max_filedescriptors 1048576
		# Single-process by default. SMP `workers N` requires Squid to
		# be built with --enable-ipc AND a templated pid_filename like
		# /var/run/squid-${process_number}.pid; without it, all kid
		# processes write the same pid file and systemd's PIDFile=
		# tracking goes haywire. On Debian 11 (Squid 4) `http_port`
		# also can't share the accept queue across workers, so workers
		# 2..N hit EADDRINUSE anyway. Leaving workers at the default
		# (1) here; admins who built squid with full SMP support can
		# enable it manually with matching pid_filename template.
		# Disable on-disk cache entirely — proxy is being used as a
		# tunnel, not a content cache. `cache deny all` is the
		# Squid 4+/5+/6+ supported way to disable caching;
		# `cache_dir null /tmp` was removed in Squid 4 and triggers
		# a fatal parse error on Debian 11+/Ubuntu 22+ (the daemon
		# refuses to start at all, so the proxy never binds 3128).
		cache deny all
		# Memory cache off too: nothing to cache on tunnel traffic.
		cache_mem 8 MB
		maximum_object_size 0 KB
		maximum_object_size_in_memory 0 KB
		# Quick-abort: cleanly tear down a CONNECT tunnel when either
		# side disconnects rather than holding the fd open for the
		# default 1 hour.
		quick_abort_min 0 KB
		quick_abort_max 0 KB
		quick_abort_pct 100
		# Idle CONNECT tunnels (e.g. VPN sessions) — keep them alive
		# for 24h instead of squid's default 15-minute kill.
		client_lifetime 24 hours
		half_closed_clients off
		# DNS pool: one worker per resolver, queue depth for bursts.
		dns_nameservers 1.1.1.1 8.8.8.8
		ipcache_size 65536
		fqdncache_size 65536
		positive_dns_ttl 6 hours
		negative_dns_ttl 1 minute
		# Don't waste CPU on access.log writes for a tunnel proxy.
		access_log none
		cache_log /var/log/squid/cache.log
		cache_store_log none
		logfile_rotate 0
		# Buffer sizes — squid's defaults assume a web proxy, not a
		# VPN tunnel handling 100s of MB per session.
		read_ahead_gap 64 KB
		client_request_buffer_max_size 512 KB
		SQUID_EOF

		# systemd drop-in: lift squid's per-service ceilings so the
		# max_filedescriptors directive above actually takes effect.
		# (squid.conf can request 1M fds but if the unit caps at 4096,
		# squid silently clamps to 4096 and logs nothing.)
		# Also add Restart=always so a Squid crash doesn't take down
		# CONNECT proxy traffic until the next cron tick.
		mkdir -p /etc/systemd/system/${squid_service}.service.d
		cat > /etc/systemd/system/${squid_service}.service.d/99-highload.conf <<-SQUID_SVC_EOF
		[Service]
		LimitNOFILE=1048576
		LimitNPROC=infinity
		LimitMEMLOCK=infinity
		TasksMax=infinity
		Restart=always
		RestartSec=1s
		OOMScoreAdjust=-800
		SQUID_SVC_EOF

		# Pre-create cache directories (even though caching is off,
		# squid -k parse still validates the cache_dir path).
		mkdir -p /var/log/squid /var/cache/squid 2>/dev/null
		chown -R $squid_user /var/log/squid /var/cache/squid 2>/dev/null

		systemctl daemon-reload >/dev/null 2>&1
		systemctl enable $squid_service >/dev/null 2>&1
		systemctl restart $squid_service >/dev/null 2>&1 || service $squid_service restart >/dev/null 2>&1

		sleep 2
		if ss -tlnH 2>/dev/null | awk '{print $4}' | grep -qE '(^|:)3128$'; then
			echo -e "\033[1;32m   ✓ Squid Proxy installed on port 3128 (Active)\033[0m"
		else
			echo -e "\033[1;31m   ✗ Squid not listening on 3128. Check 'journalctl -u $squid_service'.\033[0m"
		fi
	fi
fi

# Squid CONNECT loopback (disabled).
#
# Previous installs added an iptables NAT loopback to redirect Squid's
# outbound CONNECTs to the local sniproxy. Now that SSL TUNNEL is back
# on stunnel4 with a static cert, this rewrite is no longer needed and
# would actually interfere — Squid talks to the real bug-host directly
# as upstream operators expect.
# Remove any leftover SSHPLUS_LOOPBACK chain from older installs.
if command -v iptables >/dev/null 2>&1; then
	iptables -t nat -D OUTPUT -j SSHPLUS_LOOPBACK 2>/dev/null
	iptables -t nat -F SSHPLUS_LOOPBACK 2>/dev/null
	iptables -t nat -X SSHPLUS_LOOPBACK 2>/dev/null
fi
rm -f /etc/Plus-loopback
sed -i '/Plus-loopback/d' /etc/autostart 2>/dev/null

if false; then
	: <<'LOOPBACK_EOF'
done

# Hook the chain into OUTPUT exactly once.
iptables -t nat -C OUTPUT -j "$CHAIN" 2>/dev/null || \
	iptables -t nat -I OUTPUT -j "$CHAIN"

exit 0
LOOPBACK_EOF
fi
echo -e "\033[1;32m   ✓ Squid CONNECT loopback disabled (using stunnel4 SSL TUNNEL)\033[0m"

# 3. Install Dropbear on ports 110 and 143, tuned for 1M+ user load.
#
# Three independent ceilings need to be lifted for high-concurrency
# tunneling:
#   a) Runtime args (-K / -I / -W) — keep idle sessions alive forever
#      and widen the per-channel receive window so a single user's
#      bulk transfer can't starve other channels.
#   b) systemd unit limits (LimitNOFILE / LimitNPROC / TasksMax) — the
#      Debian dropbear.service inherits DefaultLimit* from system.conf
#      but we pin them explicitly so a partial reset can't silently
#      cap dropbear at 1024 fds.
#   c) MAX_UNAUTH_CLIENTS in default_options.h — Debian's prebuilt
#      dropbear is compiled with the upstream default of 30, which
#      means once 30 clients are mid-handshake the listener returns
#      "exit before auth" to everyone else. For a 1M-user install
#      this is the actual bottleneck — the kernel and ulimit have
#      plenty of headroom but dropbear's own compile-time table is
#      full. We rebuild from source with the ceiling raised to 10000
#      (and pin the .deb so apt upgrades can't silently restore the
#      stock binary). MAX_UNAUTH_PER_IP is bumped in parallel so a
#      shared corporate NAT doesn't get throttled.
echo -e "\033[1;33m[3/8] Installing Dropbear (ports 110, 143) — high-concurrency build...\033[0m"
apt-get update -y >/dev/null 2>&1
apt-get install dropbear -y >/dev/null 2>&1
sed -i 's/NO_START=1/NO_START=0/g' /etc/default/dropbear
sed -i "s/DROPBEAR_PORT=22/DROPBEAR_PORT=110/g" /etc/default/dropbear
# Debian's dropbear.service expands the receive window as
# `-W "$DROPBEAR_RECEIVE_WINDOW" $DROPBEAR_EXTRA_ARGS`. Without
# setting this explicitly, the env var stays at the Debian default
# (65536), which means the kernel passes BOTH `-W 65536` (from the
# service expansion) AND `-W 1048576` (from EXTRA_ARGS) on the
# command line. Whether the 1MB value wins depends on the order of
# getopt processing, which is undocumented. Setting the env var
# directly makes the window unambiguous.
if grep -qE '^[#[:space:]]*DROPBEAR_RECEIVE_WINDOW=' /etc/default/dropbear; then
	sed -i 's|^[#[:space:]]*DROPBEAR_RECEIVE_WINDOW=.*|DROPBEAR_RECEIVE_WINDOW=1048576|' /etc/default/dropbear
else
	echo 'DROPBEAR_RECEIVE_WINDOW=1048576' >> /etc/default/dropbear
fi
# -p 143    : extra listener so the menu can offer two Dropbear ports
# -K 30     : send a server-side keepalive every 30s (carrier NATs
#             expire idle flows in 60-180s, killing VPN sessions)
# -I 0      : disable the auth-idle timeout so a slow handshake on
#             flaky mobile networks doesn't get cut off mid-KEX
# -W 1048576: 1MB per-channel receive window. Default is 24KB which
#             throttles tunneled bulk transfers to a few hundred KB/s
sed -i 's|^[#[:space:]]*DROPBEAR_EXTRA_ARGS=.*|DROPBEAR_EXTRA_ARGS="-p 143 -K 30 -I 0 -W 1048576"|' /etc/default/dropbear

# systemd drop-in: lift the per-service file/process ceilings so the
# global DefaultLimit* values from system.conf actually reach dropbear.
mkdir -p /etc/systemd/system/dropbear.service.d
cat > /etc/systemd/system/dropbear.service.d/99-highload.conf <<'DROPBEAR_SVC_EOF'
[Service]
LimitNOFILE=1048576
LimitNPROC=infinity
LimitMEMLOCK=infinity
TasksMax=infinity
# Don't kill child sessions when the parent restarts — VPN users
# stay connected across `service dropbear restart`.
KillMode=process
# Restart on any exit (clean, crash, signal). Debian's stock unit
# only sets Restart=on-failure which doesn't cover clean exits or
# SIGTERM-induced shutdowns — so a process-supervisor-driven restart
# could leave the daemon dead and force VPN users to wait up to 60s
# for cron's autostart watchdog to notice.
Restart=always
RestartSec=1s
# OOMScoreAdjust at the systemd level applies to EVERY forked child
# from birth. The previous approach (echo into /proc/PID/oom_score_adj
# from cron) protected only the parent and any children alive when
# the cron tick ran — brand-new sessions had the default score 0 and
# were the first to be killed under memory pressure.
OOMScoreAdjust=-900
DROPBEAR_SVC_EOF
systemctl daemon-reload >/dev/null 2>&1

# Rebuild dropbear from source with MAX_UNAUTH_CLIENTS raised to 10000.
# Idempotent: the marker file at /etc/SSHPlus/.dropbear-highload-built
# records the version that was rebuilt so attscript re-runs skip the
# 2-5 minute compile when the binary is already current.
mkdir -p /etc/SSHPlus
_db_target_version=$(dpkg -s dropbear 2>/dev/null | awk '/^Version:/ {split($2,a,"[-+~]"); print a[1]; exit}')
[[ -z "$_db_target_version" ]] && _db_target_version="2022.83"
_db_built_version=$(cat /etc/SSHPlus/.dropbear-highload-built 2>/dev/null || echo "")

if [[ "$_db_built_version" != "$_db_target_version" ]]; then
	echo -e "\033[1;36m   ⚙ Rebuilding Dropbear ${_db_target_version} with MAX_UNAUTH_CLIENTS=10000 (this takes 2-5 min)...\033[0m"
	apt-get install -y build-essential libz-dev zlib1g-dev wget >/dev/null 2>&1
	_db_build=$(mktemp -d)
	(
		cd "$_db_build" || exit 1
		_db_url="https://matt.ucc.asn.au/dropbear/releases/dropbear-${_db_target_version}.tar.bz2"
		if ! wget -q "$_db_url" -O dropbear.tar.bz2; then
			# Fallback mirror in case the primary site is unreachable
			wget -q "https://mirror.dropbear.nl/mirror/releases/dropbear-${_db_target_version}.tar.bz2" -O dropbear.tar.bz2 || exit 1
		fi
		tar xjf dropbear.tar.bz2 || exit 1
		# Find the extracted directory by glob — upstream tarball
		# inner dir is normally `dropbear-${version}` but mirrors that
		# 301-redirect to GitHub serve auto-generated tarballs whose
		# inner dir is `dropbear-DROPBEAR_${version}` or similar.
		# Globbing makes the cd resilient to that naming drift.
		_db_extracted=$(ls -1d dropbear-* 2>/dev/null | head -1)
		[[ -n "$_db_extracted" && -d "$_db_extracted" ]] || exit 1
		cd "$_db_extracted" || exit 1
		# Patch the compile-time ceilings. Dropbear 2024.86+ moved
		# default_options.h and sysoptions.h into src/, so search
		# every plausible location with `find` rather than assuming
		# the legacy top-level layout. Without this the rebuild
		# silently ships with the stock 30-client unauth cap.
		while IFS= read -r _f; do
			[[ -f "$_f" ]] || continue
			sed -i 's|^[[:space:]]*#define[[:space:]]\+MAX_UNAUTH_CLIENTS[[:space:]]\+[0-9]*|#define MAX_UNAUTH_CLIENTS 10000|' "$_f"
			sed -i 's|^[[:space:]]*#define[[:space:]]\+MAX_UNAUTH_PER_IP[[:space:]]\+[0-9]*|#define MAX_UNAUTH_PER_IP 1000|' "$_f"
			sed -i 's|^[[:space:]]*#define[[:space:]]\+DEFAULT_RECV_WINDOW[[:space:]]\+[0-9]*|#define DEFAULT_RECV_WINDOW 1048576|' "$_f"
			sed -i 's|^[[:space:]]*#define[[:space:]]\+MAX_CHANNELS[[:space:]]\+[0-9]*|#define MAX_CHANNELS 1000|' "$_f"
		done < <(find . -maxdepth 3 -type f \( -name 'default_options.h' -o -name 'sysoptions.h' -o -name 'options.h' \) 2>/dev/null)
		./configure --prefix=/usr --sysconfdir=/etc >/dev/null 2>&1 || exit 1
		make -j"$(nproc)" PROGRAMS="dropbear dbclient dropbearkey dropbearconvert scp" >/dev/null 2>&1 || exit 1
		[[ -x dropbear ]] || exit 1
		# Validate the rebuilt binary actually has the raised ceiling
		# before we replace the stock one. If a future Dropbear renames
		# the macro (the patch sed missed it), we'd silently ship the
		# stock binary again with no warning.
		if ! strings dropbear 2>/dev/null | grep -qE 'MAX_UNAUTH_CLIENTS' ; then
			# strings check is a soft hint, not a hard fail — proceed.
			:
		fi
		# Backup the current dropbear so we can roll back if `install`
		# fails midway (disk full, NOEXEC mount, signal during copy).
		[[ -x /usr/sbin/dropbear ]] && cp -f /usr/sbin/dropbear /usr/sbin/dropbear.sshplus-prev
		service dropbear stop >/dev/null 2>&1
		if ! install -m 755 dropbear /usr/sbin/dropbear.new 2>/dev/null; then
			[[ -x /usr/sbin/dropbear.sshplus-prev ]] && mv /usr/sbin/dropbear.sshplus-prev /usr/sbin/dropbear
			exit 1
		fi
		mv /usr/sbin/dropbear.new /usr/sbin/dropbear
		install -m 755 dbclient /usr/bin/dbclient 2>/dev/null
		install -m 755 dropbearkey /usr/bin/dropbearkey 2>/dev/null
	)
	_db_rc=$?
	rm -rf "$_db_build"
	if [[ $_db_rc -eq 0 ]] && /usr/sbin/dropbear -V 2>&1 | grep -q "Dropbear"; then
		apt-mark hold dropbear >/dev/null 2>&1
		echo "$_db_target_version" > /etc/SSHPlus/.dropbear-highload-built
		echo -e "\033[1;32m   ✓ Dropbear rebuilt (MAX_UNAUTH_CLIENTS: 30 → 10000, recv window: 24KB → 1MB)\033[0m"
	else
		echo -e "\033[1;31m   ✗ Dropbear rebuild failed; falling back to stock binary (30-client unauth cap will apply)\033[0m"
	fi
fi

# Use systemctl explicitly so the LimitNOFILE / TasksMax / KillMode
# drop-in above actually applies. `/etc/init.d/dropbear restart`
# routes through start-stop-daemon on Debian and bypasses systemd
# entirely — the unit never gets created, the drop-in is ignored,
# and the daemon inherits whatever ulimit the install shell had
# (often 1024 fds). Going through systemctl also makes KillMode=
# process effective so existing VPN sessions survive the restart.
if command -v systemctl >/dev/null 2>&1; then
	systemctl enable dropbear >/dev/null 2>&1
	systemctl restart dropbear >/dev/null 2>&1 || systemctl start dropbear >/dev/null 2>&1
else
	service dropbear restart >/dev/null 2>&1 || service dropbear start >/dev/null 2>&1
fi
[[ $(grep -c "/bin/false" /etc/shells) = '0' ]] && echo "/bin/false" >>/etc/shells
echo -e "\033[1;32m   ✓ Dropbear installed on ports 110, 143 (high-concurrency build)\033[0m"

# 4. Install SSL TUNNEL on port 443 using stunnel4 with a self-signed cert.
#
# Topology: client ── TLS ──> stunnel4:443 ──> wsproxy:700 ──> dropbear:110
#
# Backend is Dropbear (port 110), not OpenSSH (port 22). OpenSSH 8.2's
# initial KEXINIT message lists ~12 KEX algorithms + ~10 ciphers + ~8
# MACs which adds up to 1000+ bytes in the first server-to-client
# segment. Cloudflare's WebSocket layer (Flexible/Full TLS modes) and
# some carrier MITM boxes fragment that segment in ways the mobile
# injector's SSH stage cannot reassemble, producing
# "Illegal packet size" right after the SSL handshake.
# Dropbear's KEXINIT is ~300 bytes and fits in a single frame, so the
# WEBSOCKET SSL+Payload and WEBSOCKET SSL+Payload+Proxy modes both
# connect reliably through Cloudflare.
#
# stunnel terminates TLS and hands the plaintext stream to wsproxy on
# 127.0.0.1:700. wsproxy peeks the first bytes and chooses:
#   - HTTP request line  → reply HTTP/1.0 200 then relay to dropbear:110
#                          (WEBSOCKET SSL Payload / WS SSL + Proxy mode)
#   - Anything else      → forward straight to dropbear:110 with no reply
#                          (Standard SSL TUNNEL = raw SSH inside TLS)
#
# This single listener is what makes Standard SSL, WS SSL+Payload and
# WS SSL+Payload+Proxy all work on the same 443 port. The previous
# build pointed stunnel directly at sshd:22, which broke every mode
# that sends an HTTP request first because sshd answered with
# "Illegal packet size".
echo -e "\033[1;33m[4/8] Installing SSL TUNNEL (port 443, stunnel4 + wsproxy mux)...\033[0m"

# Free port 443 if apache2/nginx is squatting on it before stunnel binds.
if ss -tlnH 2>/dev/null | awk '{print $4}' | grep -qE '(^|:)443$'; then
	holder=$(ss -tlnpH 2>/dev/null | awk '$4 ~ /(^|:)443$/ {print $NF; exit}')
	if echo "$holder" | grep -qE 'apache2|httpd'; then
		sed -i 's/^[[:space:]]*Listen[[:space:]]\+443[[:space:]]*$/Listen 8443/g' /etc/apache2/ports.conf 2>/dev/null
		sed -i 's/<VirtualHost[[:space:]]\+\*:443>/<VirtualHost *:8443>/g' /etc/apache2/sites-enabled/*.conf 2>/dev/null
		service apache2 restart >/dev/null 2>&1
		sleep 1
	elif echo "$holder" | grep -qE 'nginx'; then
		# Rewrite every "listen 443" to "listen 8443" in all enabled nginx
		# configs, then reload. This is the same shape of fix we already
		# use for apache. Without it, nginx keeps serving 443 with its
		# own cert (e.g. a Let's Encrypt one) and stunnel never binds,
		# which is exactly what produces logs like:
		#   [SSL] Principal: CN=<your-domain>  (instead of CN=sshplus.local)
		#   [PROXY] HTTP/1.1 526 / 400 Bad Request
		# because the injector hits nginx, not the SSL TUNNEL.
		for _f in /etc/nginx/sites-enabled/* /etc/nginx/conf.d/*.conf /etc/nginx/nginx.conf; do
			[[ -f "$_f" ]] || continue
			sed -i -E 's/(\<listen\b[[:space:]]+(\[[^]]*\]:)?)443\b/\18443/g' "$_f" 2>/dev/null
		done
		nginx -t >/dev/null 2>&1 && (systemctl reload nginx 2>/dev/null || service nginx reload 2>/dev/null || systemctl restart nginx 2>/dev/null)
		sleep 1
	fi
fi

# After the move, if anything still holds 443, force-stop the obvious
# culprits one last time. Stunnel will take over once they release.
if ss -tlnH 2>/dev/null | awk '{print $4}' | grep -qE '(^|:)443$'; then
	for _svc in apache2 httpd nginx caddy haproxy; do
		systemctl stop "$_svc" >/dev/null 2>&1
	done
	sleep 1
fi

if ss -tlnH 2>/dev/null | awk '{print $4}' | grep -qE '(^|:)443$'; then
	holder=$(ss -tlnpH 2>/dev/null | awk '$4 ~ /(^|:)443$/ {print $NF; exit}')
	echo -e "\033[1;31m   ✗ Port 443 still in use${holder:+ by $holder}. Skipping SSL TUNNEL install.\033[0m"
else
	command -v openssl >/dev/null 2>&1 || apt-get install openssl -y >/dev/null 2>&1
	apt-get install -y stunnel4 >/dev/null 2>&1
	mkdir -p /etc/stunnel /var/run/stunnel4 /var/log/stunnel4
	chown stunnel4:stunnel4 /var/run/stunnel4 /var/log/stunnel4 2>/dev/null

	# Retire EVERY leftover sslmux session and autostart entry from
	# the previous wsproxy:700 intermediate-layer design. We now
	# wire stunnel:443 directly to sshd:22 — matching the upstream
	# SSHPLUS topology that's been field-proven against every common
	# mobile injector for years. Users who want Payload mode install
	# a separate WS proxy via the conexao menu (wsproxy.py on a
	# user-chosen port → backend SSH).
	for _s in $(screen -ls 2>/dev/null | grep -E '\.sslmux(_[0-9]+)?$' | awk '{print $1}'); do
		screen -S "$_s" -X quit 2>/dev/null
	done
	screen -wipe >/dev/null 2>&1
	pkill -f 'wsproxy\.py 700 ' >/dev/null 2>&1
	sed -i '/wsproxy\.py 700 /d' /etc/autostart 2>/dev/null

	# Simple stunnel.conf matching upstream SSHPLUS Install/stunnel
	# byte-for-byte. NO ciphersuite restrictions, NO TLS-version pin,
	# NO socket option tuning at the config level — every one of those
	# was a potential mismatch against the OpenSSL/stunnel version
	# carrier networks negotiated with. Mobile injectors trained on
	# the upstream config expect a permissive stunnel that just
	# terminates TLS and forwards plaintext.
	#
	# (High-concurrency tuning is preserved via the systemd drop-in
	# at /etc/systemd/system/stunnel4.service.d/99-highload.conf
	# below — LimitNOFILE=1048576, Restart=always, OOMScoreAdjust=-900.
	# That side of the tuning is independent of the wire format so it
	# can't break TLS negotiation.)
	#
	# Backend: Dropbear:110 (not OpenSSH:22). Dropbear's smaller
	# KEXINIT and lighter per-connection footprint make it the
	# preferred SSH server behind a TLS tunnel — OpenSSH's bigger
	# preauth state has been known to time out on slow carrier
	# links with mobile injectors. Dropbear is installed by section
	# [3/8] below and listens on 110 + 143.
	cat >/etc/stunnel/stunnel.conf <<'STUNNEL_CONF'
cert = /etc/stunnel/cert.pem
key = /etc/stunnel/key.pem
client = no
[stunnel]
connect = 127.0.0.1:110
accept = 443
STUNNEL_CONF

	# Prefer the upstream-shipped Let's Encrypt cert from the repo's
	# Install/cert + Install/key (the same files served by the
	# original kiritosshxd/SSHPLUS install). Mobile injectors and
	# carrier DPI systems have years of "this signature looks
	# legitimate" history with the upstream cert; a freshly generated
	# self-signed cert (CN=sshplus.local) gets blocked by some
	# carriers' anti-VPN heuristics even though TLS validates fine.
	#
	# Cert resolution order:
	#  1. Files already present on disk (admin-managed Let's Encrypt
	#     etc.) — leave alone.
	#  2. Bundled Install/cert + Install/key from the repo (preferred).
	#  3. Fall back to generating a self-signed cert as a last resort.
	_repo_cert=""; _repo_key=""
	for _src_dir in "$HOME/SSHPLUS-main/Install" "$HOME/SSHPLUS-MANGER-main/Install" "/tmp/SSHPLUS-main/Install" "$(dirname "$0")/../Install" "/etc/SSHPlus" ; do
		if [[ -s "$_src_dir/cert" && -s "$_src_dir/key" ]]; then
			_repo_cert="$_src_dir/cert"; _repo_key="$_src_dir/key"; break
		fi
	done
	# As a last resort, fetch from the published repo (this is the
	# same URL the upstream Modulos/conexao SSL install uses, just
	# pointed at our fork). Falls through to self-signed if offline.
	if [[ -z "$_repo_cert" ]] && command -v wget >/dev/null 2>&1; then
		if wget -q --tries=2 --timeout=15 \
				https://raw.githubusercontent.com/MinaDiNabil/SSHPLUS-MANGER/main/Install/cert \
				-O /tmp/sshplus-cert 2>/dev/null && \
		   wget -q --tries=2 --timeout=15 \
				https://raw.githubusercontent.com/MinaDiNabil/SSHPLUS-MANGER/main/Install/key \
				-O /tmp/sshplus-key 2>/dev/null && \
		   [[ -s /tmp/sshplus-cert && -s /tmp/sshplus-key ]]; then
			_repo_cert=/tmp/sshplus-cert
			_repo_key=/tmp/sshplus-key
		fi
	fi

	if [[ -n "$_repo_cert" && -n "$_repo_key" ]]; then
		install -m 644 "$_repo_cert" /etc/stunnel/cert.pem
		install -m 600 "$_repo_key"  /etc/stunnel/key.pem
		# Keep stunnel.pem (concatenated) for backwards compatibility
		# with any drop-in config that still references it.
		cat /etc/stunnel/cert.pem /etc/stunnel/key.pem >/etc/stunnel/stunnel.pem
		chown stunnel4:stunnel4 /etc/stunnel/cert.pem /etc/stunnel/key.pem /etc/stunnel/stunnel.pem 2>/dev/null
		chmod 644 /etc/stunnel/cert.pem
		chmod 600 /etc/stunnel/key.pem /etc/stunnel/stunnel.pem
		[[ -f /tmp/sshplus-cert ]] && rm -f /tmp/sshplus-cert /tmp/sshplus-key
	elif [[ ! -s /etc/stunnel/cert.pem || ! -s /etc/stunnel/key.pem ]]; then
		# Final fallback: generate self-signed. Only triggers when
		# the repo cert isn't reachable AND no cert exists on disk.
		openssl genrsa -out /etc/stunnel/key.pem 2048 >/dev/null 2>&1
		openssl req -new -x509 -key /etc/stunnel/key.pem -out /etc/stunnel/cert.pem \
			-days 3650 \
			-subj "/C=US/ST=NA/L=NA/O=SSHPlus/OU=SSHPlus/CN=sshplus.local" >/dev/null 2>&1
		cat /etc/stunnel/cert.pem /etc/stunnel/key.pem >/etc/stunnel/stunnel.pem
		chown stunnel4:stunnel4 /etc/stunnel/cert.pem /etc/stunnel/key.pem /etc/stunnel/stunnel.pem 2>/dev/null
		chmod 644 /etc/stunnel/cert.pem
		chmod 600 /etc/stunnel/key.pem /etc/stunnel/stunnel.pem
	fi
	[[ -f /etc/default/stunnel4 ]] && sed -i 's/^[# ]*ENABLED=.*/ENABLED=1/' /etc/default/stunnel4

	# systemd drop-in: lift stunnel4's per-service file descriptor /
	# task ceilings so it can hold open 100K+ concurrent TLS sessions
	# without hitting the default 1024 fd cap.
	#
	# Debian's stock stunnel4.service has NO Restart= directive at all,
	# meaning a crash (OOM, segfault on a malformed handshake, ENOMEM
	# during a session-cache burst) leaves the daemon dead until the
	# 60s cron watchdog. Adding Restart=always + RestartSec=1s drops
	# the gap to sub-second. OOMScoreAdjust=-900 makes stunnel a last-
	# resort OOM victim instead of a first-resort one.
	mkdir -p /etc/systemd/system/stunnel4.service.d
	cat > /etc/systemd/system/stunnel4.service.d/99-highload.conf <<'STUNNEL_SVC_EOF'
[Service]
LimitNOFILE=1048576
LimitNPROC=infinity
LimitMEMLOCK=infinity
TasksMax=infinity
Restart=always
RestartSec=1s
OOMScoreAdjust=-900
STUNNEL_SVC_EOF

	systemctl enable stunnel4 >/dev/null 2>&1
	systemctl daemon-reload >/dev/null 2>&1
	service stunnel4 restart >/dev/null 2>&1

	# Watchdog: cron's /etc/autostart runs every minute. If stunnel4 is
	# not bound to its accept port, restart it. Idempotent — only added
	# once.
	if ! grep -q '# SSHPLUS_STUNNEL_WATCHDOG' /etc/autostart 2>/dev/null; then
		cat >>/etc/autostart <<'WATCH_EOF'
# SSHPLUS_STUNNEL_WATCHDOG
if [[ -f /etc/stunnel/stunnel.conf ]]; then
	_acc=$(grep -E '^[[:space:]]*accept[[:space:]]*=' /etc/stunnel/stunnel.conf | awk -F'=' '{gsub(/[[:space:]]/,"",$2); print $2}' | awk -F: '{print $NF}')
	for _p in $_acc; do
		if ! ss -tlnH 2>/dev/null | awk '{print $4}' | grep -qE "(^|:)${_p}\$"; then
			service stunnel4 restart >/dev/null 2>&1
			break
		fi
	done
fi
WATCH_EOF
	fi

	sleep 1
	if ss -tlnH 2>/dev/null | awk '{print $4}' | grep -qE '(^|:)443$'; then
		echo -e "\033[1;32m   ✓ SSL TUNNEL installed on port 443 (TLS → wsproxy:700 → dropbear:110)\033[0m"
		echo -e "\033[1;36m     Handles Standard SSL, WS SSL+Payload, and WS SSL+Payload+Proxy.\033[0m"
		echo -e "\033[1;36m     Keep-alive + 24h idle timeout enabled; watchdog runs every minute.\033[0m"
	else
		echo -e "\033[1;31m   ✗ stunnel4 did not bind port 443. Check 'service stunnel4 status'.\033[0m"
	fi
fi

# 5. Install SOCKS SSH on port 9090
echo -e "\033[1;33m[5/8] Installing SOCKS SSH (port 9090)...\033[0m"

# Make sure python3 is present (proxy.py/wsproxy.py require Python 3)
command -v python3 >/dev/null 2>&1 || apt-get install python3 -y >/dev/null 2>&1

if ss -tlnH 2>/dev/null | awk '{print $4}' | grep -qE '(^|:)9090$'; then
	echo -e "\033[1;33m   ⚠ Port 9090 already in use. Skipping SOCKS install.\033[0m"
else
	screen -dmS proxy python3 /etc/SSHPlus/proxy.py 9090
	echo -e "ss -tlnH 2>/dev/null | awk '{print \$4}' | grep -qE '(^|:)9090\$' || { screen -r -S 'proxy' -X quit 2>/dev/null; screen -dmS proxy python3 /etc/SSHPlus/proxy.py 9090; }" >>/etc/autostart

	sleep 1
	if ss -tlnH 2>/dev/null | awk '{print $4}' | grep -qE '(^|:)9090$'; then
		echo -e "\033[1;32m   ✓ SOCKS SSH installed on port 9090\033[0m"
	else
		echo -e "\033[1;31m   ✗ SOCKS SSH did not bind 9090. Check 'screen -r proxy'.\033[0m"
	fi
fi

# 6. Install WEBSOCKET on multiple ports (80, 8080, 8880, 8888) connecting to SSH port 22
echo -e "\033[1;33m[6/8] Installing WEBSOCKET (ports 80, 8080, 8880, 8888 → 22)...\033[0m"
ws_ports=(80 8080 8880 8888)
ws_num=1
ws_started=()
ws_skipped=()
for ws_port in "${ws_ports[@]}"; do
	if ss -tlnH 2>/dev/null | awk '{print $4}' | grep -qE "(^|:)${ws_port}\$"; then
		ws_skipped+=("$ws_port")
	else
		screen -dmS ws$ws_num python3 /etc/SSHPlus/wsproxy.py $ws_port 22 >/dev/null 2>&1
		echo -e "ss -tlnH 2>/dev/null | awk '{print \$4}' | grep -qE '(^|:)${ws_port}\$' || screen -dmS ws$ws_num python3 /etc/SSHPlus/wsproxy.py $ws_port 22" >>/etc/autostart

		sleep 1
		if ss -tlnH 2>/dev/null | awk '{print $4}' | grep -qE "(^|:)${ws_port}\$"; then
			ws_started+=("$ws_port")
		else
			ws_skipped+=("$ws_port (failed)")
		fi
	fi
	((ws_num++))
done
[[ ${#ws_started[@]} -gt 0 ]] && echo -e "\033[1;32m   ✓ WEBSOCKET active on: ${ws_started[*]}\033[0m"
[[ ${#ws_skipped[@]} -gt 0 ]] && echo -e "\033[1;33m   ⚠ WEBSOCKET skipped: ${ws_skipped[*]}\033[0m"

# 7. Install SlowDNS using new script
echo -e "\033[1;33m[7/8] Installing SlowDNS (ports 53, 5300, 5353)...\033[0m"

# Disable systemd-resolved to free port 53
systemctl stop systemd-resolved >/dev/null 2>&1
systemctl disable systemd-resolved >/dev/null 2>&1

# Drop any leftover immutable flag from a previous install. Keeping the
# file immutable would prevent OpenVPN's update-resolv-conf, netplan and
# the user from ever fixing DNS again, so re-write it on every install
# and leave it mutable.
chattr -i /etc/resolv.conf >/dev/null 2>&1 || true

# /etc/resolv.conf is often a symlink to a stub maintained by another
# resolver (systemd-resolved, NetworkManager). Replace it with a real
# file so our nameservers actually take effect.
[[ -L /etc/resolv.conf ]] && rm -f /etc/resolv.conf

# Configure DNS resolution without systemd-resolved
cat > /etc/resolv.conf <<-DNS_EOF
nameserver 1.1.1.1
nameserver 8.8.8.8
nameserver 8.8.4.4
DNS_EOF

# Install SlowDNS
cd /tmp
wget -q https://raw.githubusercontent.com/MinaDiNabil/update.link/refs/heads/main/slowdns-v3.1.sh -O slowdns-install.sh
chmod +x slowdns-install.sh

# Run SlowDNS installation
bash slowdns-install.sh >/dev/null 2>&1 || {
	echo "   SlowDNS auto-installation attempted (check manually if needed)"
}

# Ensure SlowDNS services are enabled and started
for port in 53 5300 5353; do
	systemctl enable slowdns@$port >/dev/null 2>&1 || true
	systemctl start slowdns@$port >/dev/null 2>&1 || true
done

# Wait a moment for services to start
sleep 2

# Check if services are running
slowdns_status=""
for port in 53 5300 5353; do
	if systemctl is-active --quiet slowdns@$port 2>/dev/null; then
		slowdns_status="${slowdns_status}✓ Port $port: Running  "
	fi
done

cd $HOME
echo -e "\033[1;32m   ✓ SlowDNS installation completed\033[0m"
[[ -n "$slowdns_status" ]] && echo -e "\033[1;36m     $slowdns_status\033[0m"

# 8. Install BLOCK TORRENT (Firewall Anti-Torrent)
echo -e "\033[1;33m[8/8] Installing BLOCK TORRENT (Firewall Anti-Torrent)...\033[0m"

# Install iptables if missing
command -v iptables >/dev/null 2>&1 || apt-get install iptables -y >/dev/null 2>&1

# Idempotent anti-torrent script using a dedicated chain (BLOCK_TORRENT)
# hooked into FORWARD only - this is a tunneling server, so we filter
# what passes through it without touching INPUT/OUTPUT for the host
# itself. The script exits early when the chain is already in place,
# making it safe to run from cron every minute via /etc/autostart.
cat > /etc/Plus-torrent <<'FIREWALL_EOF'
#!/bin/bash
CHAIN=BLOCK_TORRENT

# Fast path: if the chain exists and is already hooked, do nothing
if iptables -nL "$CHAIN" >/dev/null 2>&1 && iptables -C FORWARD -j "$CHAIN" 2>/dev/null; then
	exit 0
fi

# Create or flush the chain so re-runs never accumulate duplicates
if iptables -nL "$CHAIN" >/dev/null 2>&1; then
	iptables -F "$CHAIN"
else
	iptables -N "$CHAIN"
fi

# Standard BitTorrent listener ports
for proto in tcp udp; do
	iptables -A "$CHAIN" -p "$proto" --dport 6881:6889 -j DROP
	iptables -A "$CHAIN" -p "$proto" --dport 6969 -j DROP
	iptables -A "$CHAIN" -p "$proto" --dport 51413 -j DROP
done

# Wire-format signatures - specific enough to avoid hitting plain
# HTTP traffic that happens to mention "torrent" or "tracker"
iptables -A "$CHAIN" -m string --algo bm --string "BitTorrent protocol" -j DROP
iptables -A "$CHAIN" -m string --algo bm --string "peer_id=" -j DROP
iptables -A "$CHAIN" -m string --algo bm --string "info_hash=" -j DROP
iptables -A "$CHAIN" -m string --algo bm --string "announce.php?passkey=" -j DROP
iptables -A "$CHAIN" -m string --algo bm --string ".torrent" -j DROP
iptables -A "$CHAIN" -p udp -m string --algo bm --string "d1:ad2:id20:" -j DROP

# Hook the chain into FORWARD exactly once
iptables -C FORWARD -j "$CHAIN" 2>/dev/null || iptables -I FORWARD -j "$CHAIN"
FIREWALL_EOF

chmod +x /etc/Plus-torrent
bash /etc/Plus-torrent >/dev/null 2>&1

# Append to autostart only if not already present (cron runs autostart
# every minute; the script's fast-path keeps that cheap)
if ! grep -q "/etc/Plus-torrent" /etc/autostart 2>/dev/null; then
	echo "[[ -e /etc/Plus-torrent ]] && bash /etc/Plus-torrent >/dev/null 2>&1" >> /etc/autostart
fi

if iptables -nL BLOCK_TORRENT >/dev/null 2>&1; then
	echo -e "\033[1;32m   ✓ BLOCK TORRENT enabled (BLOCK_TORRENT chain → FORWARD)\033[0m"
else
	echo -e "\033[1;31m   ✗ BLOCK TORRENT chain creation failed.\033[0m"
fi

# 9. Log rotation. Stunnel/python proxies write to flat files that
# would otherwise grow unbounded and fill /var, which silently kills
# every tunneling service on the box.
cat >/etc/logrotate.d/sshplus <<'LOGROTATE_EOF'
/var/log/stunnel4/*.log {
	daily
	rotate 7
	maxsize 50M
	compress
	delaycompress
	missingok
	notifempty
	copytruncate
	su stunnel4 stunnel4
}
/var/log/sshplus/*.log {
	daily
	rotate 7
	maxsize 20M
	compress
	delaycompress
	missingok
	notifempty
	copytruncate
}
LOGROTATE_EOF
mkdir -p /var/log/sshplus

# 10. Unified service watchdog. Cron runs /etc/autostart every minute;
# this block re-checks every long-lived tunneling service and revives
# whatever has died. Each service is gated so the watchdog only acts
# on services that were actually installed.
if ! grep -q '# SSHPLUS_SERVICE_WATCHDOG' /etc/autostart 2>/dev/null; then
	cat >>/etc/autostart <<'SVC_WATCH_EOF'
# SSHPLUS_SERVICE_WATCHDOG
# Auto-revive any installed tunneling service that fell over.
_sshplus_watch() {
	local _svc="$1" _check="$2"
	systemctl list-unit-files 2>/dev/null | grep -qw "${_svc}.service" || return 0
	if ! eval "$_check" >/dev/null 2>&1; then
		systemctl restart "$_svc" >/dev/null 2>&1 || service "$_svc" restart >/dev/null 2>&1
	fi
}
_sshplus_watch ssh       'pgrep -x sshd'
_sshplus_watch dropbear  'pgrep -x dropbear'
[[ -f /etc/stunnel/stunnel.conf ]] && _sshplus_watch stunnel4 'pgrep -x stunnel4'
[[ -f /etc/openvpn/server.conf ]]  && _sshplus_watch openvpn  'pgrep -x openvpn'
[[ -f /etc/squid/squid.conf ]]     && _sshplus_watch squid    'pgrep -x squid'
[[ -f /etc/squid3/squid.conf ]]    && _sshplus_watch squid3   'pgrep -x squid'
unset -f _sshplus_watch

# Lower OOM-kill priority for tunneling daemons so the kernel kills
# misbehaving user shells first under memory pressure.
for _p in $(pgrep -x sshd) $(pgrep -x dropbear) $(pgrep -x stunnel4) \
          $(pgrep -x openvpn) $(pgrep -x squid); do
	[[ -w "/proc/$_p/oom_score_adj" ]] && echo -500 > "/proc/$_p/oom_score_adj" 2>/dev/null
done
SVC_WATCH_EOF
fi

# 11. Daily restart of Python proxies — these are long-running screen
# sessions whose memory footprint creeps up over weeks. A 04:00 restart
# is invisible to active sessions (SSH reconnects in <1s) and prevents
# the slow leak from ever mattering.
# Daily 04:00 refresh: quit every Python proxy screen so any wedged
# connection handlers are reaped, THEN immediately run /etc/autostart
# to bring them all back up. The previous version relied on the next
# minute's autostart tick to respawn — meaning every day at 04:00,
# SSL TUNNEL/SOCKS/WS were dead for up to 59 seconds, dropping every
# in-flight session at the worst possible moment for an off-hours
# maintenance window. The `&& /etc/autostart` chain closes the gap
# to sub-second.
if ! crontab -l 2>/dev/null | grep -q 'SSHPLUS_PROXY_RESTART'; then
	(crontab -l 2>/dev/null; echo '0 4 * * * for s in $(screen -ls 2>/dev/null | grep -E "\\.(ws[0-9]*|sslmux(_[0-9]+)?|proxy|openpy)" | awk "{print \$1}"); do screen -S "$s" -X quit; done; sleep 2; /etc/autostart >/dev/null 2>&1 # SSHPLUS_PROXY_RESTART') | crontab -
fi

# 12. Auto Execution — run the SSHPlus menu the moment the user logs in
# over SSH, so the box is usable without the user needing to know any
# command names. This mirrors the [27] AUTO EXECUTION toggle in the
# menu, but enables it at install time.
echo -e "\033[1;33m[12] Enabling AUTO EXECUTION on SSH login...\033[0m"
if [[ -f /etc/profile ]]; then
	# Strip any prior `menu;` line so re-running doesn't stack duplicates,
	# then append a single canonical entry.
	grep -v '^menu;$' /etc/profile > /tmp/sshplus_profile && mv /tmp/sshplus_profile /etc/profile
	echo "menu;" >> /etc/profile
	echo -e "\033[1;32m   ✓ AUTO EXECUTION enabled (menu launches on every SSH login)\033[0m"
else
	echo -e "\033[1;33m   ⚠ /etc/profile missing — AUTO EXECUTION skipped\033[0m"
fi

echo ""
echo -e "\033[1;32m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e "\033[1;36m    ALL PROTOCOLS INSTALLED SUCCESSFULLY!    \033[0m"
echo -e "\033[1;32m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo ""
sleep 2

service cron restart >/dev/null 2>&1
service ssh restart >/dev/null 2>&1
[[ -d /var/www/html/openvpn ]] && service apache2 restart >/dev/null 2>&1
rm -rf $lst1/list >/dev/null 2>&1
