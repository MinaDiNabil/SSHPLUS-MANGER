#!/bin/bash
clear

# Raise this shell's own ulimits before spawning the BadVPN daemon.
# Cron-driven respawns inherit limits from /etc/autostart (set up at
# install time); when started interactively from the menu we need to
# lift them here so a single screen session can hold 1M+ open UDP
# flows instead of capping at the inherited 1024 fds.
ulimit -n 1048576 2>/dev/null || ulimit -n 524288 2>/dev/null
ulimit -u unlimited 2>/dev/null || ulimit -u 1048576 2>/dev/null

# Canonical BadVPN command line — kept in one variable so the screen
# launch, the autostart line, and the watchdog all use the same flags.
# Values match the high-concurrency tuning in Install/list section [1/8].
BADVPN_CMD="/bin/badvpn-udpgw --listen-addr 127.0.0.1:7300 --max-clients 1000000 --max-connections-for-client 100 --client-socket-sndbuf 1048576"
BADVPN_AUTOSTART="ps x | grep 'udpvpn' | grep -v 'grep' >/dev/null || screen -dmS udpvpn $BADVPN_CMD"

# Primary GitHub raw URL — same source the installer uses. Falls back
# to a mirror only if the primary is unreachable. The old Dropbox URL
# this script used to hit returned an HTML page (not a binary), which
# is why every "INSTALANDO O BADVPN" attempt silently succeeded with
# the menu reporting "ATIVO!" but `/bin/badvpn-udpgw` never existed.
BADVPN_URL_PRIMARY="https://raw.githubusercontent.com/MinaDiNabil/SSHPLUS-MANGER/main/Modulos/badvpn"
BADVPN_URL_FALLBACK="https://raw.githubusercontent.com/MinaDiNabil/SSHPLUS-MANGER/master/Modulos/badvpn"

fun_bar () {
comando[0]="$1"
comando[1]="$2"
 (
[[ -e $HOME/fim ]] && rm $HOME/fim
${comando[0]} -y > /dev/null 2>&1
${comando[1]} -y > /dev/null 2>&1
touch $HOME/fim
 ) > /dev/null 2>&1 &
 tput civis
echo -ne "\033[1;33m["
while true; do
   for((i=0; i<18; i++)); do
   echo -ne "\033[1;31m#"
   sleep 0.1s
   done
   [[ -e $HOME/fim ]] && rm $HOME/fim && break
   echo -e "\033[1;33m]"
   sleep 1s
   tput cuu1
   tput dl1
   echo -ne "\033[1;33m["
done
echo -e "\033[1;33m]\033[1;37m -\033[1;32m OK !\033[1;37m"
tput cnorm
}

[[ $(awk -F" " '{print $2}' /usr/lib/licence) != "@KIRITO_SSH" ]] && exit 0

# Verify a binary at $1 is an actual ELF executable (not an HTML
# error page from a dead mirror). Returns 0 if valid, 1 otherwise.
fun_is_elf () {
    [[ -s "$1" ]] || return 1
    head -c 4 "$1" 2>/dev/null | grep -q $'\x7fELF'
}

# Download the BadVPN binary, validate it, install to /bin. Returns 0
# on success, 1 on permanent failure (so the caller can show a clear
# error instead of silently pretending to start a non-existent binary).
fun_install_badvpn () {
    cd "$HOME" || return 1
    rm -f "$HOME/badvpn-udpgw.tmp"
    if wget -q --tries=2 --timeout=20 "$BADVPN_URL_PRIMARY" -O "$HOME/badvpn-udpgw.tmp" && fun_is_elf "$HOME/badvpn-udpgw.tmp"; then
        :
    elif wget -q --tries=2 --timeout=20 "$BADVPN_URL_FALLBACK" -O "$HOME/badvpn-udpgw.tmp" && fun_is_elf "$HOME/badvpn-udpgw.tmp"; then
        :
    else
        rm -f "$HOME/badvpn-udpgw.tmp"
        return 1
    fi
    install -m 755 "$HOME/badvpn-udpgw.tmp" /bin/badvpn-udpgw
    rm -f "$HOME/badvpn-udpgw.tmp"
    fun_is_elf /bin/badvpn-udpgw
}

# Start BadVPN (assumes /bin/badvpn-udpgw is already installed and
# validated). Refreshes the autostart entry to match the live command
# line so reboot respawns don't drift back to the legacy low-cap args.
fun_start_badvpn () {
    # Kill any stale udpvpn screen so the new high-cap one wins on the
    # 127.0.0.1:7300 bind.
    screen -ls 2>/dev/null | grep -qE '\.udpvpn\b' && screen -S udpvpn -X quit 2>/dev/null
    screen -wipe >/dev/null 2>&1
    screen -dmS udpvpn $BADVPN_CMD
    # Refresh autostart: drop every previous udpvpn line then re-add
    # the canonical one. This converges legacy installs (max-clients
    # 1000 / 10000) onto the current high-concurrency command line.
    [[ -f /etc/autostart ]] || { echo '#!/bin/bash' > /etc/autostart && chmod +x /etc/autostart; }
    sed -i '/udpvpn/d' /etc/autostart
    echo -e "$BADVPN_AUTOSTART" >> /etc/autostart
    sleep 1
}

fun_udp1 () {
    if [[ ! -x /bin/badvpn-udpgw ]] || ! fun_is_elf /bin/badvpn-udpgw; then
        clear
        echo -e "\033[1;32mINSTALANDO O BADVPN !\033[0m\n"
        fun_bar 'fun_install_badvpn'
        if [[ ! -x /bin/badvpn-udpgw ]] || ! fun_is_elf /bin/badvpn-udpgw; then
            echo -e "\n\033[1;31m  ✗ FALHA NO DOWNLOAD DO BADVPN!\033[0m"
            echo -e "\033[1;33m    Verifique a conexão com a internet e tente novamente.\033[0m"
            echo -e "\033[1;33m    URL: $BADVPN_URL_PRIMARY\033[0m"
            sleep 4
            menu
            return
        fi
        echo -e "\n\033[1;32mINICIANDO O BADVPN... \033[0m\n"
    else
        clear
        echo -e "\033[1;32mINICIANDO O BADVPN... \033[0m\n"
    fi
    fun_bar 'fun_start_badvpn'
    # Confirm the daemon is actually bound to 7300/udp before claiming
    # success — past versions reported "ATIVO!" even when the screen
    # session died one second after spawn.
    if ss -lnuH 2>/dev/null | awk '{print $5}' | grep -qE '(^|:)7300$'; then
        echo -e "\n  \033[1;32mBADVPN ATIVO !\033[0m"
        echo -e "\033[1;36m    Limite: 1.000.000 clientes / 100 conexões por cliente\033[0m"
    else
        echo -e "\n  \033[1;31m✗ BADVPN NÃO ESTÁ ESCUTANDO EM 7300/udp\033[0m"
        echo -e "\033[1;33m    Verifique: screen -r udpvpn\033[0m"
    fi
    sleep 3
    menu
}

fun_udp2 () {
    clear
    echo -e "\n\033[1;32mPARANDO O BADVPN...\033[0m\n"
    fun_stopbad () {
        sleep 1
        screen -r -S "udpvpn" -X quit
        screen -wipe 1>/dev/null 2>/dev/null
        [[ $(grep -wc "udpvpn" /etc/autostart) != '0' ]] && {
		    sed -i '/udpvpn/d' /etc/autostart
		}
        sleep 1
    }
    fun_bar 'fun_stopbad'
    echo -e "\n  \033[1;31mBADVPN PARADO !\033[0m"
    sleep 3
    menu
}

[[ $(ps x | grep "udpvpn"|grep -v grep |wc -l) = '0' ]] &&  fun_udp1 || fun_udp2
