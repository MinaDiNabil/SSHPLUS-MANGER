#!/bin/bash
# SSHPLUS — BadVPN UDP gateway menu wrapper
#
# Install strategy (tries in order, picks first that works):
#  1. apt-get install -y badvpn         — Debian 10/11, Ubuntu 18/20
#  2. Build from source via cmake       — works on EVERY arch + OS
#  3. Pre-built protected binary (repo) — LAST resort, x86_64 only,
#     requires /usr/lib/licence with "@KIRITO_SSH" content
#
# Why "build from source" is a real option here: udpgw is ~30 KB of
# C and the cmake config can scope down the build to ONLY udpgw via
# -DBUILD_NOTHING_BY_DEFAULT=1 -DBUILD_UDPGW=1. End-to-end build
# takes 30-90 seconds on a 2-vCPU VPS and the resulting binary is
# always native arch, native GLIBC, and has none of the license-
# check / anti-debug wrapper that the protected upstream binary
# carries (which silently exits when the licence file isn't where
# it expects).

clear

ulimit -n 1048576 2>/dev/null || ulimit -n 524288 2>/dev/null
ulimit -u unlimited 2>/dev/null || ulimit -u 1048576 2>/dev/null

# udpgw daemon command line. Args are intentionally minimal — the
# upstream binary uses --client-socket-sndbuf as an OPTIONAL flag,
# but some builds don't recognise it and refuse to start. We always
# omit it from the primary spawn; if power users want to set it,
# they can edit /etc/autostart.
BADVPN_BIN_CANDIDATES=(/usr/local/bin/badvpn-udpgw /usr/bin/badvpn-udpgw /bin/badvpn-udpgw)
BADVPN_BIN=""
BADVPN_ARGS="--listen-addr 127.0.0.1:7300 --max-clients 1000 --max-connections-for-client 10"

BADVPN_URL_PRIMARY="https://raw.githubusercontent.com/MinaDiNabil/SSHPLUS-MANGER/main/Modulos/badvpn"
BADVPN_SRC_URL="https://github.com/ambrop72/badvpn/archive/refs/tags/1.999.130.tar.gz"
BADVPN_LOG="/var/log/badvpn-udpvpn.log"

fun_bar () {
	comando[0]="$1"
	comando[1]="$2"
	(
		[[ -e $HOME/fim ]] && rm $HOME/fim
		${comando[0]} > /dev/null 2>&1
		[[ -n "${comando[1]}" ]] && ${comando[1]} > /dev/null 2>&1
		touch $HOME/fim
	) > /dev/null 2>&1 &
	tput civis
	echo -ne "\033[1;33m["
	while true; do
		for((i=0; i<18; i++)); do
			echo -ne "\033[1;31m#"
			sleep 0.1s
		done
		[[ -e $HOME/fim ]] && rm $HOME/fim && break
		echo -e "\033[1;33m]"
		sleep 1s
		tput cuu1
		tput dl1
		echo -ne "\033[1;33m["
	done
	echo -e "\033[1;33m]\033[1;37m -\033[1;32m OK !\033[1;37m"
	tput cnorm
}

[[ $(awk -F" " '{print $2}' /usr/lib/licence 2>/dev/null) != "@KIRITO_SSH" ]] && exit 0

# Magic-byte ELF check.
fun_is_elf () {
	[[ -s "$1" ]] || return 1
	head -c 4 "$1" 2>/dev/null | grep -q $'\x7fELF'
}

# Does the binary actually start a UDP listener? The protected
# upstream wrapper passes the ELF check, exits 0 silently when its
# license check fails. The only reliable way to tell a working
# binary from a wrapper-that-exits is to actually run it briefly
# and check for an open UDP port (or, since we don't want to bind
# 7300, just check that --help returns a recognisable usage string).
fun_is_real_udpgw () {
	local _out
	_out=$("$1" --help 2>&1 | head -20)
	# Real badvpn-udpgw prints "Usage:" with --listen-addr in the
	# help text. The protected wrapper either prints awk errors or
	# exits silently — neither contains "--listen-addr".
	echo "$_out" | grep -q -- '--listen-addr'
}

fun_find_badvpn_bin () {
	local _bin
	for _bin in "${BADVPN_BIN_CANDIDATES[@]}"; do
		if [[ -x "$_bin" ]] && fun_is_elf "$_bin" && fun_is_real_udpgw "$_bin"; then
			BADVPN_BIN="$_bin"
			return 0
		fi
	done
	BADVPN_BIN=""
	return 1
}

# Install attempt 1: Debian/Ubuntu package.
fun_install_apt () {
	command -v apt-get >/dev/null 2>&1 || return 1
	DEBIAN_FRONTEND=noninteractive apt-get install -y badvpn >/dev/null 2>&1
	[[ -x /usr/bin/badvpn-udpgw ]] && fun_is_real_udpgw /usr/bin/badvpn-udpgw
}

# Install attempt 2: build from source. Works on every arch + OS.
fun_install_source () {
	command -v apt-get >/dev/null 2>&1 || return 1
	# Build deps. cmake + a C compiler + libnspr/nss for the NCD
	# component (badvpn requires it even when we only build udpgw).
	DEBIAN_FRONTEND=noninteractive apt-get install -y \
		cmake build-essential libnspr4-dev libnss3-dev libssl-dev \
		wget tar >/dev/null 2>&1
	command -v cmake >/dev/null 2>&1 || return 1
	command -v cc >/dev/null 2>&1 || return 1

	local _build="/tmp/sshplus-badvpn-build.$$"
	rm -rf "$_build"
	mkdir -p "$_build" || return 1
	cd "$_build" || return 1

	wget -q --tries=3 --timeout=30 "$BADVPN_SRC_URL" -O badvpn.tar.gz || { cd /; rm -rf "$_build"; return 1; }
	tar -xzf badvpn.tar.gz 2>/dev/null || { cd /; rm -rf "$_build"; return 1; }
	local _src
	_src=$(ls -1d badvpn-* 2>/dev/null | head -1)
	[[ -n "$_src" && -d "$_src" ]] || { cd /; rm -rf "$_build"; return 1; }

	mkdir -p "$_src/build"
	cd "$_src/build" || { cd /; rm -rf "$_build"; return 1; }

	cmake .. -DBUILD_NOTHING_BY_DEFAULT=1 -DBUILD_UDPGW=1 >/dev/null 2>&1 || { cd /; rm -rf "$_build"; return 1; }
	make -j"$(nproc 2>/dev/null || echo 1)" >/dev/null 2>&1 || { cd /; rm -rf "$_build"; return 1; }

	[[ -x udpgw/badvpn-udpgw ]] || { cd /; rm -rf "$_build"; return 1; }
	install -m 755 udpgw/badvpn-udpgw /usr/local/bin/badvpn-udpgw
	ln -sf /usr/local/bin/badvpn-udpgw /bin/badvpn-udpgw 2>/dev/null
	cd /
	rm -rf "$_build"
	fun_is_real_udpgw /usr/local/bin/badvpn-udpgw
}

# Install attempt 3: pre-built protected wrapper from the repo.
# Only works when /usr/lib/licence exists with the expected
# "by: @KIRITO_SSH" content (the wrapper's anti-debug check).
fun_install_repo () {
	local _arch
	_arch=$(uname -m 2>/dev/null)
	case "$_arch" in
		x86_64|amd64) ;;
		*) return 1 ;;
	esac
	# Make sure the licence file the wrapper checks exists.
	if [[ ! -s /usr/lib/licence ]]; then
		echo 'by: @KIRITO_SSH' > /usr/lib/licence
	fi
	rm -f "$HOME/badvpn-udpgw.tmp"
	wget -q --tries=2 --timeout=20 "$BADVPN_URL_PRIMARY" -O "$HOME/badvpn-udpgw.tmp" || return 1
	fun_is_elf "$HOME/badvpn-udpgw.tmp" || { rm -f "$HOME/badvpn-udpgw.tmp"; return 1; }
	install -m 755 "$HOME/badvpn-udpgw.tmp" /bin/badvpn-udpgw
	rm -f "$HOME/badvpn-udpgw.tmp"
	# Note: fun_is_real_udpgw will FAIL on the protected wrapper
	# (it doesn't print --listen-addr in help) — but the wrapper
	# does actually run udpgw internally if the licence check passes.
	# So we return success based on ELF + size, not --help output.
	[[ -x /bin/badvpn-udpgw ]] && fun_is_elf /bin/badvpn-udpgw
}

fun_install_badvpn () {
	# Try each install method in turn. First success wins.
	fun_install_apt    && return 0
	fun_install_source && return 0
	fun_install_repo   && return 0
	return 1
}

# Start the daemon, logging stderr so we can show actual errors on
# failure instead of "exited immediately, ¯\_(ツ)_/¯".
fun_start_badvpn () {
	screen -ls 2>/dev/null | grep -qE '\.udpvpn([[:space:]]|$)' && screen -S udpvpn -X quit 2>/dev/null
	screen -wipe >/dev/null 2>&1
	# Spawn through bash -c so stderr can be redirected to a log
	# file. Plain `screen -dmS udpvpn $BIN $ARGS` loses stderr to
	# the (unread) screen scrollback.
	: >"$BADVPN_LOG" 2>/dev/null
	screen -dmS udpvpn bash -c "exec $BADVPN_BIN $BADVPN_ARGS 2>>$BADVPN_LOG"
	[[ -f /etc/autostart ]] || { echo '#!/bin/bash' > /etc/autostart && chmod +x /etc/autostart; }
	sed -i '/udpvpn/d' /etc/autostart
	echo "ps x | grep 'udpvpn' | grep -v 'grep' >/dev/null || screen -dmS udpvpn bash -c 'exec $BADVPN_BIN $BADVPN_ARGS 2>>$BADVPN_LOG'" >> /etc/autostart
	sleep 2
}

fun_udp1 () {
	# Port already taken?
	if ss -lnuH 2>/dev/null | awk '{print $4}' | grep -qE '(^|:)7300$'; then
		local _holder
		_holder=$(ss -lnupH 2>/dev/null | awk '$4 ~ /(^|:)7300$/ {print $NF; exit}')
		if echo "$_holder" | grep -q 'badvpn-udpgw'; then
			echo -e "\033[1;33m  ⚠ BADVPN JÁ ESTÁ ATIVO em 7300/udp\033[0m"
			sleep 3
			menu
			return
		fi
		clear
		echo -e "\033[1;31m  ✗ PORTA 7300/udp JÁ EM USO${_holder:+ por $_holder}\033[0m"
		echo -e "\033[1;33m    Libere a porta e tente novamente.\033[0m"
		sleep 4
		menu
		return
	fi

	# Resolve binary. Install if missing or broken.
	if ! fun_find_badvpn_bin; then
		clear
		echo -e "\033[1;32mINSTALANDO O BADVPN !\033[0m"
		echo -e "\033[1;36m  (tentando apt → build → repo, pode levar 1-3 min)\033[0m\n"
		fun_bar 'fun_install_badvpn'
		if ! fun_find_badvpn_bin; then
			# Last-resort: try the protected wrapper anyway. fun_is_real_udpgw
			# rejects it (no --listen-addr in help), but maybe it works.
			if [[ -x /bin/badvpn-udpgw ]] && fun_is_elf /bin/badvpn-udpgw; then
				BADVPN_BIN=/bin/badvpn-udpgw
			else
				echo -e "\n\033[1;31m  ✗ FALHA NA INSTALAÇÃO DO BADVPN!\033[0m"
				echo -e "\033[1;33m    Tentativas executadas:\033[0m"
				echo -e "\033[1;33m      1) apt-get install -y badvpn\033[0m"
				echo -e "\033[1;33m      2) build from source ($BADVPN_SRC_URL)\033[0m"
				echo -e "\033[1;33m      3) wget pre-built binary\033[0m"
				echo -e "\033[1;33m    Arquitetura detectada: $(uname -m 2>/dev/null)\033[0m"
				echo -e "\033[1;33m    Distro: $(. /etc/os-release 2>/dev/null; echo "$PRETTY_NAME")\033[0m"
				sleep 6
				menu
				return
			fi
		fi
		echo -e "\n\033[1;32mBADVPN instalado em: $BADVPN_BIN\033[0m"
		echo -e "\033[1;32mINICIANDO O BADVPN... \033[0m\n"
	else
		clear
		echo -e "\033[1;32mINICIANDO O BADVPN ($BADVPN_BIN)... \033[0m\n"
	fi

	fun_bar 'fun_start_badvpn'

	if ss -lnuH 2>/dev/null | awk '{print $4}' | grep -qE '(^|:)7300$'; then
		echo -e "\n  \033[1;32mBADVPN ATIVO !\033[0m"
		echo -e "\033[1;36m    Binário: $BADVPN_BIN\033[0m"
		echo -e "\033[1;36m    Endereço: 127.0.0.1:7300\033[0m"
		echo -e "\033[1;36m    Limite: 1000 clientes / 10 conexões por cliente\033[0m"
	else
		echo -e "\n  \033[1;31m✗ BADVPN NÃO ESTÁ ESCUTANDO EM 7300/udp\033[0m"
		echo -e "\033[1;33m    O daemon iniciou mas saiu imediatamente.\033[0m"
		if [[ -s "$BADVPN_LOG" ]]; then
			echo -e "\033[1;33m    Saída do daemon ($BADVPN_LOG):\033[0m"
			# Show the last 5 lines of stderr — usually enough to
			# explain what went wrong (missing library, bad arg, etc.)
			tail -n 5 "$BADVPN_LOG" 2>/dev/null | sed 's/^/      /'
		else
			echo -e "\033[1;33m    Sem output capturado. Tente manualmente:\033[0m"
			echo -e "\033[1;33m      $BADVPN_BIN $BADVPN_ARGS\033[0m"
		fi
		echo -e "\033[1;33m    Inspecione também: screen -r udpvpn  (Ctrl+A,D para sair)\033[0m"
	fi
	sleep 5
	menu
}

fun_udp2 () {
	clear
	echo -e "\n\033[1;32mPARANDO O BADVPN...\033[0m\n"
	fun_stopbad () {
		sleep 1
		screen -S udpvpn -X quit 2>/dev/null
		screen -wipe >/dev/null 2>&1
		pkill -x badvpn-udpgw 2>/dev/null
		[[ $(grep -wc "udpvpn" /etc/autostart 2>/dev/null) != '0' ]] && \
			sed -i '/udpvpn/d' /etc/autostart
		sleep 1
	}
	fun_bar 'fun_stopbad'
	echo -e "\n  \033[1;31mBADVPN PARADO !\033[0m"
	sleep 3
	menu
}

[[ $(ps x | grep "udpvpn" | grep -v grep | wc -l) = '0' ]] && fun_udp1 || fun_udp2
