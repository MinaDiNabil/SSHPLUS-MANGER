echo ""
sleep 2

# Network and system optimization for stability under heavy load.
#
# The previous version of this script blindly appended a SECOND
# sysctl block to /etc/sysctl.conf — with LOWER ceilings than
# Install/list's /etc/sysctl.d/99-sshplus.conf (nf_conntrack_max
# 1M vs 4M, tcp_max_syn_backlog 8K vs 65K, nproc unlimited for *
# = fork-bomb attack surface). Every run also DUPLICATED the
# block, building a snowball of conflicting directives until
# `sysctl -p` parse-failed.
#
# Install/list is now the single source of truth for tuning; this
# menu option just reloads the existing drop-ins and reports the
# active state. Admins can edit /etc/sysctl.d/99-sshplus.conf and
# /etc/security/limits.d/99-sshplus.conf directly for customisation.
echo -e "\033[1;32mReapplying network and system optimizations...\033[0m"
echo ""

# Clean up legacy duplicated blocks left in /etc/sysctl.conf by older
# versions of this script. Idempotent — only acts if the marker is
# present.
if grep -q '^# SSHPLUS Network Optimizations' /etc/sysctl.conf 2>/dev/null; then
    sed -i '/^# SSHPLUS Network Optimizations/,/^fs\.inotify\.max_user_watches = 524288$/d' /etc/sysctl.conf
    sed -i '/^# SSHPLUS Network Optimizations/,/^vm\.vfs_cache_pressure = 50$/d' /etc/sysctl.conf
    sed -i '/^# Applied on /d' /etc/sysctl.conf
fi

# Same for /etc/security/limits.conf — legacy `* nproc 1048576` is
# a security regression. Install/list now scopes nproc=unlimited to
# root only (the wildcard is capped at 65535).
if grep -qE '^\* (soft|hard) (nofile|nproc) 1048576' /etc/security/limits.conf 2>/dev/null; then
    sed -i '/^\* soft nofile 1048576$/d;/^\* hard nofile 1048576$/d' /etc/security/limits.conf
    sed -i '/^\* soft nproc 1048576$/d;/^\* hard nproc 1048576$/d' /etc/security/limits.conf
    sed -i '/^root soft nofile 1048576$/d;/^root hard nofile 1048576$/d' /etc/security/limits.conf
    sed -i '/^root soft nproc 1048576$/d;/^root hard nproc 1048576$/d' /etc/security/limits.conf
fi

# Make sure the drop-in is in place. If it's missing (admin removed
# it, or this is a partial install), fall back to a baseline so the
# menu option still does something useful.
if [[ ! -f /etc/sysctl.d/99-sshplus.conf ]]; then
    cat > /etc/sysctl.d/99-sshplus.conf <<'SYSCTL_FALLBACK_EOF'
# SSHPLUS - baseline tuning (write your installer for full config)
net.core.somaxconn = 65535
net.core.netdev_max_backlog = 250000
net.ipv4.tcp_max_syn_backlog = 65535
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_fin_timeout = 15
net.ipv4.tcp_keepalive_time = 600
net.ipv4.ip_local_port_range = 1024 65535
net.ipv4.ip_forward = 1
net.netfilter.nf_conntrack_max = 4194304
net.nf_conntrack_max = 4194304
fs.file-max = 4194304
fs.nr_open = 4194304
vm.swappiness = 10
fs.inotify.max_user_watches = 524288
fs.inotify.max_user_instances = 8192
SYSCTL_FALLBACK_EOF
fi

# Reload from drop-ins (canonical source of truth).
sysctl --system >/dev/null 2>&1 || sysctl -p /etc/sysctl.d/99-sshplus.conf >/dev/null 2>&1
ulimit -n 1048576 2>/dev/null || ulimit -n 524288 2>/dev/null

echo -e "\033[1;32m✓ Tuning reloaded from /etc/sysctl.d/99-sshplus.conf\033[0m"
echo -e "\033[1;33m  Active values:\033[0m"
echo -e "    \033[1;36mnf_conntrack_max:\033[1;37m       $(sysctl -n net.netfilter.nf_conntrack_max 2>/dev/null || echo unset)"
echo -e "    \033[1;36mtcp_max_syn_backlog:\033[1;37m    $(sysctl -n net.ipv4.tcp_max_syn_backlog 2>/dev/null || echo unset)"
echo -e "    \033[1;36msomaxconn:\033[1;37m              $(sysctl -n net.core.somaxconn 2>/dev/null || echo unset)"
echo -e "    \033[1;36mfile-max:\033[1;37m               $(sysctl -n fs.file-max 2>/dev/null || echo unset)"
echo -e "    \033[1;36mtcp_congestion_control:\033[1;37m $(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo unset)"
