echo ""
sleep 2

# Network and system optimization for stability under heavy load
echo -e "\033[1;32mApplying network and system optimizations...\033[0m"
echo ""

# Backup current sysctl settings
cp /etc/sysctl.conf /etc/sysctl.conf.backup-$(date +%Y%m%d) 2>/dev/null

# Apply TCP/IP optimizations
cat >> /etc/sysctl.conf << 'EOF'

# SSHPLUS Network Optimizations for Stability and Performance
# Applied on $(date)

# Increase maximum connections
net.core.somaxconn = 65535
net.core.netdev_max_backlog = 65536

# Increase TCP buffer sizes for better throughput
net.core.rmem_max = 134217728
net.core.wmem_max = 134217728
net.core.rmem_default = 16777216
net.core.wmem_default = 16777216
net.ipv4.tcp_rmem = 4096 87380 67108864
net.ipv4.tcp_wmem = 4096 65536 67108864

# Enable TCP Fast Open
net.ipv4.tcp_fastopen = 3

# Improve TCP performance
net.ipv4.tcp_congestion_control = bbr
net.core.default_qdisc = fq
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_no_metrics_save = 1

# Reduce TIME_WAIT connections
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_fin_timeout = 15
net.ipv4.tcp_max_tw_buckets = 1440000

# Increase connection tracking
net.netfilter.nf_conntrack_max = 1048576
net.nf_conntrack_max = 1048576

# Keepalive optimization for stability
net.ipv4.tcp_keepalive_time = 600
net.ipv4.tcp_keepalive_intvl = 60
net.ipv4.tcp_keepalive_probes = 3

# Increase local port range
net.ipv4.ip_local_port_range = 1024 65535

# SYN flood protection
net.ipv4.tcp_syncookies = 1
net.ipv4.tcp_syn_retries = 2
net.ipv4.tcp_synack_retries = 2
net.ipv4.tcp_max_syn_backlog = 8192

# Disable ICMP redirect acceptance
net.ipv4.conf.all.accept_redirects = 0
net.ipv6.conf.all.accept_redirects = 0

# Enable IP forwarding
net.ipv4.ip_forward = 1
net.ipv6.conf.all.forwarding = 1

# Memory and file limits
fs.file-max = 2097152
vm.swappiness = 10
vm.vfs_cache_pressure = 50

# Increase inotify limits
fs.inotify.max_user_instances = 8192
fs.inotify.max_user_watches = 524288

EOF

# Apply settings immediately
sysctl -p >/dev/null 2>&1

# Increase file descriptor limits
cat >> /etc/security/limits.conf << 'EOF'
* soft nofile 1048576
* hard nofile 1048576
* soft nproc 1048576
* hard nproc 1048576
root soft nofile 1048576
root hard nofile 1048576
root soft nproc 1048576
root hard nproc 1048576
EOF

# Update ulimit for current session
ulimit -n 1048576 2>/dev/null

echo -e "\033[1;32m✓ Network optimizations applied successfully!\033[0m"
echo -e "\033[1;33m✓ TCP BBR congestion control enabled\033[0m"
