  rm /tmp/att > /dev/null 2>&1

  echo -e " \033[1;33m MORE INFORMATION \033[1;31m(\033[1;36mTELEGRAM\033[1;31m): \033[1;37mEDIT:@MinaProNet\n"

  echo -e " \033[1;33mYou can still pull the latest fixes from the main branch"
  echo -e " (useful for hotfixes merged without a version bump).\n"

  echo -ne " \033[1;32mFORCE PULL LATEST FIXES FROM MAIN \033[1;31m? \033[1;33m[y/N]:\033[1;37m "; read force

  if [[ "$force" = y || "$force" = Y ]]; then

    echo -e "\n \033[1;32mFETCHING LATEST FIXES FROM MAIN BRANCH...\033[0m\n"

    fun_bar 'fun_force_update'

    if [[ -f /tmp/.sshplus_force_ok ]]; then
      rm /tmp/.sshplus_force_ok > /dev/null 2>&1
      echo -e "\n \033[1;32mLATEST FIXES APPLIED SUCCESSFULLY!\033[0m"
      # Surface the SSL TUNNEL state so the user can see at a glance
      # that they're now on the dynamic-SNI listener: every TLS
      # handshake gets a leaf cert generated to match its SNI, which
      # is what closes the long-running "works on the IP, fails on
      # the domain (or on the bug-host)" report once and for all.
      if screen -ls 2>/dev/null | grep -q '\.sniproxy_'; then
        local _ports
        _ports=$(screen -ls 2>/dev/null | awk '
          /\.sniproxy_/{
            split($1, a, "."); split(a[2], b, "_"); print b[2]
          }' | sort -nu | xargs)
        echo ""
        echo -e " \033[1;33mSSL TUNNEL: \033[1;36mDynamic SNI\033[1;33m on port(s): \033[1;32m$_ports\033[0m"
        echo -e " \033[1;37m The TLS cert is generated per-connection to match"
        echo -e " \033[1;37m whatever SNI the client sends — your own domain,"
        echo -e " \033[1;37m every bug-host SNI, anything. No per-host config."
        if [[ -s /etc/stunnel/sniproxy_ca.crt ]]; then
          local _cached
          _cached=$(ls -1 /etc/stunnel/sni_cache/*.crt 2>/dev/null | wc -l)
          echo -e " \033[1;33m Cached SNI leaf certs: \033[1;32m$_cached\033[0m"
        fi
      fi
    else
      echo -e "\n \033[1;31mFAILED TO FETCH FIXES FROM MAIN. Check connectivity and try again.\033[0m"
    fi

    sleep 4
  fi

  echo -ne " \033[1;31m ENTER \033[1;33mto return to \033[1;32mMENU!\033[0m"; read

  menu

} || {

