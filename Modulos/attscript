echo " "

fun_atts () {

  [[ -e /home/versao ]] && rm /home/versao

  [[ -e /tmp/att ]] && rm /tmp/att

	wget -c -P /home https://raw.githubusercontent.com/MinaDiNabil/SSHPLUS-MANGER/main/Install/versao

	[[ -f "/home/versao" ]] && mv /home/versao /tmp/att

	[[ ! -e /bin/versao ]] && rm -rf /bin/menu

} > /dev/null 2>&1

# Pull the latest module/source files from the main branch without
# re-running the full installer. Useful for picking up bug fixes that
# were merged without bumping the version number.
fun_force_update () {

  rm -f /tmp/.sshplus_force_ok > /dev/null 2>&1

  local tmpdir
  tmpdir=$(mktemp -d -t sshplus-update.XXXXXX) || return 1

  cd "$tmpdir" || { rm -rf "$tmpdir"; return 1; }

  wget -q https://github.com/MinaDiNabil/SSHPLUS-MANGER/archive/refs/heads/main.tar.gz -O main.tar.gz \
    || { cd "$HOME"; rm -rf "$tmpdir"; return 1; }

  tar -xzf main.tar.gz \
    || { cd "$HOME"; rm -rf "$tmpdir"; return 1; }

  local src="$tmpdir/SSHPLUS-MANGER-main"
  [[ ! -d "$src/Modulos" ]] && { cd "$HOME"; rm -rf "$tmpdir"; return 1; }

  # Modules that live in /bin/ and are invoked directly by the menu.
  local _mdls=(addhost delhost alterarsenha criarusuario expcleaner \
               mudardata remover criarteste verifbot droplimiter \
               alterarlimite ajuda sshmonitor badvpn userbackup \
               instsqd blockt otimizar menu speedtest banner \
               senharoot reiniciarservicos reiniciarsistema attscript \
               conexao delscript detalhes botssh infousers verifatt \
               limiter uexpired trojan-go onlineapp swapmemory \
               initbot initcheck pkill.sh)

  for _arq in "${_mdls[@]}"; do
    if [[ -f "$src/Modulos/$_arq" ]]; then
      cp -f "$src/Modulos/$_arq" "/bin/$_arq"
      dos2unix "/bin/$_arq" 2>/dev/null
      chmod +x "/bin/$_arq"
    fi
  done

  # Helper files that live in /etc/SSHPlus/ (not run from /bin/).
  mkdir -p /etc/SSHPlus 2>/dev/null
  local _plus=(cabecalho bot open.py proxy.py wsproxy.py)
  for _arq in "${_plus[@]}"; do
    if [[ -f "$src/Modulos/$_arq" ]]; then
      cp -f "$src/Modulos/$_arq" "/etc/SSHPlus/$_arq"
      dos2unix "/etc/SSHPlus/$_arq" 2>/dev/null
      chmod +x "/etc/SSHPlus/$_arq"
    fi
  done

  # Refresh the stunnel config template (kept for reference / re-installs).
  if [[ -f "$src/Install/stunnel" && -d /etc/stunnel ]]; then
    cp -f "$src/Install/stunnel" /etc/stunnel/stunnel.conf.sample 2>/dev/null
  fi

  cd "$HOME"
  rm -rf "$tmpdir"

  # Old installs shipped a static, expired Let's Encrypt certificate
  # for `sslpingudomain.tk`. Pulling new code never replaced it, so
  # SSL/TLS (SNI) clients dialing the user's own domain still saw the
  # wrong CN/SAN and rejected the handshake. fun_verify_cert detects
  # that situation (or any cert that is expired, missing, fails to
  # parse, or doesn't include /etc/stunnel/.domain) and rebuilds the
  # cert in place using the dynamic generator below.
  fun_verify_cert

  # Restart the payload multiplexers so the refreshed wsproxy.py takes
  # effect right away. /etc/autostart re-spawns them on the next minute
  # via cron, but doing it here avoids a downtime window.
  for s in $(screen -ls 2>/dev/null | grep '\.sslmux_' | awk '{print $1}'); do
    screen -S "$s" -X quit 2>/dev/null
  done
  [[ -x /etc/autostart ]] && /etc/autostart > /dev/null 2>&1
  # stop+sleep+start beats `restart` here: on Debian builds where the
  # unit is in failed state `restart` is a no-op and the new cert is
  # never loaded. fun_verify_cert may have already done this, so the
  # second pass is cheap when the unit is already up.
  service stunnel4 stop > /dev/null 2>&1
  /etc/init.d/stunnel4 stop > /dev/null 2>&1
  sleep 1
  service stunnel4 start > /dev/null 2>&1
  /etc/init.d/stunnel4 start > /dev/null 2>&1

  touch /tmp/.sshplus_force_ok
  return 0
}

# Regenerate /etc/stunnel/cert.pem and key.pem using the same logic the
# SSL TUNNEL menu uses. Reads /etc/stunnel/.domain for an optional
# user-supplied domain. Backs up the previous cert/key so a failed
# openssl invocation cannot leave the server with an empty cert.
fun_regen_cert () {
  [[ ! -d /etc/stunnel ]] && return 0
  command -v openssl >/dev/null 2>&1 || apt-get install openssl -y >/dev/null 2>&1

  local cert_ip cert_host cert_dom cert_cn n
  cert_ip=$(curl -s -m 5 https://api.ipify.org 2>/dev/null \
    || curl -s -m 5 https://ifconfig.me 2>/dev/null \
    || hostname -I 2>/dev/null | awk '{print $1}')
  [[ -z "$cert_ip" ]] && cert_ip="127.0.0.1"
  cert_host=$(hostname -f 2>/dev/null || hostname)
  [[ -z "$cert_host" || "$cert_host" == "localhost" || "$cert_host" == "(none)" ]] && cert_host="sshplus.local"
  cert_dom=""
  [[ -s /etc/stunnel/.domain ]] && cert_dom=$(head -n1 /etc/stunnel/.domain | tr -d '[:space:]')
  cert_cn="${cert_dom:-$cert_host}"

  [[ -s /etc/stunnel/cert.pem ]] && cp -a /etc/stunnel/cert.pem /etc/stunnel/cert.pem.bak
  [[ -s /etc/stunnel/key.pem  ]] && cp -a /etc/stunnel/key.pem  /etc/stunnel/key.pem.bak

  {
    echo '[req]'
    echo 'default_bits = 2048'
    echo 'prompt = no'
    echo 'default_md = sha256'
    echo 'distinguished_name = dn'
    echo 'x509_extensions = v3_ext'
    echo ''
    echo '[dn]'
    echo "CN = $cert_cn"
    echo ''
    echo '[v3_ext]'
    echo 'basicConstraints = CA:FALSE'
    echo 'keyUsage = critical, digitalSignature, keyEncipherment'
    echo 'extendedKeyUsage = serverAuth'
    echo 'subjectAltName = @alt_names'
    echo ''
    echo '[alt_names]'
    n=1; echo "DNS.$n = $cert_host"
    if [[ -n "$cert_dom" && "$cert_dom" != "$cert_host" ]]; then
      n=$((n+1)); echo "DNS.$n = $cert_dom"
      n=$((n+1)); echo "DNS.$n = *.$cert_dom"
    fi
    n=$((n+1)); echo "DNS.$n = localhost"
    echo "IP.1 = 127.0.0.1"
    [[ "$cert_ip" != "127.0.0.1" ]] && echo "IP.2 = $cert_ip"
  } > /etc/stunnel/openssl.cnf

  openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
    -keyout /etc/stunnel/key.pem \
    -out /etc/stunnel/cert.pem \
    -config /etc/stunnel/openssl.cnf \
    -extensions v3_ext >/dev/null 2>&1

  if [[ ! -s /etc/stunnel/cert.pem ]] || ! openssl x509 -in /etc/stunnel/cert.pem -noout >/dev/null 2>&1; then
    [[ -s /etc/stunnel/cert.pem.bak ]] && mv -f /etc/stunnel/cert.pem.bak /etc/stunnel/cert.pem
    [[ -s /etc/stunnel/key.pem.bak  ]] && mv -f /etc/stunnel/key.pem.bak  /etc/stunnel/key.pem
  fi
  rm -f /etc/stunnel/openssl.cnf /etc/stunnel/cert.pem.bak /etc/stunnel/key.pem.bak
  chmod 600 /etc/stunnel/cert.pem /etc/stunnel/key.pem 2>/dev/null

  if grep -qE '^[# ]*ENABLED=' /etc/default/stunnel4 2>/dev/null; then
    sed -i 's/^[# ]*ENABLED=.*/ENABLED=1/' /etc/default/stunnel4
  else
    [[ -f /etc/default/stunnel4 ]] && echo 'ENABLED=1' >> /etc/default/stunnel4
  fi
}

# Decide whether we need to regenerate the cert right now. Conditions:
#   - cert is missing or unreadable
#   - cert is the legacy `sslpingudomain.tk` Let's Encrypt cert that
#     pre-dates the dynamic generator (subject or SAN contains it)
#   - cert is expired or expires within 30 days
#   - the user changed /etc/stunnel/.domain after the cert was issued
#   - /etc/stunnel/.domain has a hostname that is not in the SAN block
fun_verify_cert () {
  [[ -e /etc/stunnel/stunnel.conf ]] || return 0
  command -v openssl >/dev/null 2>&1 || apt-get install openssl -y >/dev/null 2>&1
  command -v openssl >/dev/null 2>&1 || return 0

  local need=0
  if [[ ! -s /etc/stunnel/cert.pem ]] || ! openssl x509 -in /etc/stunnel/cert.pem -noout 2>/dev/null; then
    need=1
  elif openssl x509 -in /etc/stunnel/cert.pem -noout -subject -ext subjectAltName 2>/dev/null | grep -q "sslpingudomain"; then
    need=1
  elif ! openssl x509 -in /etc/stunnel/cert.pem -checkend $((30*24*3600)) >/dev/null 2>&1; then
    need=1
  elif [[ -s /etc/stunnel/.domain && /etc/stunnel/.domain -nt /etc/stunnel/cert.pem ]]; then
    need=1
  elif [[ -s /etc/stunnel/.domain ]]; then
    local want san
    want=$(head -n1 /etc/stunnel/.domain | tr -d '[:space:]')
    san=$(openssl x509 -in /etc/stunnel/cert.pem -noout -ext subjectAltName 2>/dev/null)
    echo "$san" | grep -qF "DNS:$want" || need=1
  fi

  if [[ $need -eq 1 ]]; then
    fun_regen_cert
  fi
}

echo -e "                              \033[1;31mBy MinaProNet\033[1;36m"

echo -e "   SSHPlus" | figlet

echo " "

echo -e "   \033[1;32mCHECKING FOR AVAILABLE UPDATES\033[0m\n"

fun_bar 'fun_atts'

[[ ! -f "/tmp/att" ]] && {

	echo -e "\n\033[1;31m ERROR CONNECTING TO SERVER\n"

	echo -ne "\033[1;31m ENTER \033[1;33mto return to \033[1;32mMENU!\033[0m"; read

	menu

}

echo " "

vrs1=$(sed -n '1 p' /bin/versao| sed -e 's/[^0-9]//ig')

vrs2=$(sed -n '1 p' /tmp/att | sed -e 's/[^0-9]//ig')

[[ "$vrs1" == "$vrs2" ]] && {

  echo -e " \033[1;36m     SCRIPT IS ALREADY UP TO DATE!\033[1;32m\n"

  rm /tmp/att > /dev/null 2>&1

  echo -e " \033[1;33m MORE INFORMATION \033[1;31m(\033[1;36mTELEGRAM\033[1;31m): \033[1;37mEDIT:@MinaProNet\n"

  echo -e " \033[1;33mYou can still pull the latest fixes from the main branch"
  echo -e " (useful for hotfixes merged without a version bump).\n"

  echo -ne " \033[1;32mFORCE PULL LATEST FIXES FROM MAIN \033[1;31m? \033[1;33m[y/N]:\033[1;37m "; read force

  if [[ "$force" = y || "$force" = Y ]]; then

    # If SSL TUNNEL is set up but the user never told us their public
    # domain, the auto-generated cert covers only the server hostname
    # and IP. Strict TLS clients dialing the user's own domain then
    # reject the handshake. Take the chance to ask once, here, while
    # we know the user is interactive and updating anyway.
    if [[ -e /etc/stunnel/stunnel.conf && ! -s /etc/stunnel/.domain ]]; then
      echo ""
      echo -e " \033[1;33mSSL TUNNEL is installed but no domain is configured.\033[0m"
      echo -e " \033[1;33mIf clients connect via a domain (e.g. \033[1;36mssh-servers.example.com\033[1;33m)"
      echo -e " \033[1;33mthe SSL certificate must include it, otherwise SSL/TLS (SNI)"
      echo -e " \033[1;33mclients dialing the domain are rejected at handshake time.\033[0m"
      echo ""
      echo -ne " \033[1;32mEnter your domain (empty = skip)\033[1;33m:\033[1;37m "
      read sslplus_dom
      sslplus_dom=$(echo "$sslplus_dom" | tr -d '[:space:]' | tr 'A-Z' 'a-z')
      if [[ -n "$sslplus_dom" ]]; then
        if [[ "$sslplus_dom" =~ ^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$ ]] && [[ "$sslplus_dom" == *.* ]]; then
          mkdir -p /etc/stunnel
          echo "$sslplus_dom" > /etc/stunnel/.domain
          echo -e " \033[1;32m✓ Domain saved; the certificate will be regenerated below.\033[0m"
        else
          echo -e " \033[1;31m✗ '$sslplus_dom' is not a valid domain — skipping.\033[0m"
        fi
      fi
      echo ""
    fi

    echo -e "\n \033[1;32mFETCHING LATEST FIXES FROM MAIN BRANCH...\033[0m\n"

    fun_bar 'fun_force_update'

    if [[ -f /tmp/.sshplus_force_ok ]]; then
      rm /tmp/.sshplus_force_ok > /dev/null 2>&1
      echo -e "\n \033[1;32mLATEST FIXES APPLIED SUCCESSFULLY!\033[0m"
      # Show the SAN block of the live cert so the user can confirm
      # at a glance whether their domain is covered by the SSL/TLS
      # (SNI) handshake.
      if [[ -s /etc/stunnel/cert.pem ]]; then
        echo ""
        echo -e " \033[1;33mSSL TUNNEL certificate now covers:\033[0m"
        openssl x509 -in /etc/stunnel/cert.pem -noout -ext subjectAltName 2>/dev/null \
          | awk '/X509v3 Subject Alternative Name:/{getline; print}' \
          | sed 's/, /\n/g; s/^[[:space:]]*//' \
          | awk '{print "   \033[1;36m• \033[1;37m" $0}'
        if [[ ! -s /etc/stunnel/.domain ]]; then
          echo ""
          echo -e " \033[1;33m To add a domain later: \033[1;36mconexao\033[1;33m → SSL TUNNEL → \033[1;31m[\033[1;36m4\033[1;31m]\033[1;33m CHANGE SSL DOMAIN\033[0m"
        fi
      fi
    else
      echo -e "\n \033[1;31mFAILED TO FETCH FIXES FROM MAIN. Check connectivity and try again.\033[0m"
    fi

    sleep 4
  fi

  echo -ne " \033[1;31m ENTER \033[1;33mto return to \033[1;32mMENU!\033[0m"; read

  menu

} || {

  echo -e "  \033[1;36mNEW UPDATE AVAILABLE!\033[1;33m\n"

  echo -e "  \033[1;33mMORE INFORMATION \033[1;31m(\033[1;36mTELEGRAM\033[1;31m): \033[1;37mEDIT:@MinaProNet\n"

  echo -e "  \033[1;32mUPDATE DETAILS:\033[0m\n"

  while read linha; do

    echo -e "  \033[1;37m- \033[1;33m$linha"

  done < "/tmp/att"

  echo " "

  echo -ne "  \033[1;32mDO YOU WANT TO UPDATE \033[1;31m? \033[1;33m[y/n]:\033[1;37m "; read res

  if [[ "$res" = y || "$res" = Y ]];then

    echo -e "\n\033[1;32m  STARTING UPDATE..."

    sleep 3

    wget https://raw.githubusercontent.com/MinaDiNabil/SSHPLUS-MANGER/main/Plus > /dev/null 2>&1

    chmod +x Plus

    ./Plus

    clear

    echo -e "\033[1;32mSCRIPT UPDATED SUCCESSFULLY\033[0m\n"

    rm /tmp/att > /dev/null 2>&1

    echo -ne "\033[1;31mENTER \033[1;33mto return to \033[1;32mMENU!\033[0m"; read

    menu

  else

    menu

  fi

}

