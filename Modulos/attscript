fun_atts () {

  [[ -e /home/versao ]] && rm /home/versao

  [[ -e /tmp/att ]] && rm /tmp/att

	wget -c -P /home https://raw.githubusercontent.com/MinaDiNabil/SSHPLUS-MANGER/main/Install/versao

	[[ -f "/home/versao" ]] && mv /home/versao /tmp/att

	[[ ! -e /bin/versao ]] && rm -rf /bin/menu

} > /dev/null 2>&1

# Pull the latest module/source files from the main branch without
# re-running the full installer. Useful for picking up bug fixes that
# were merged without bumping the version number.
fun_force_update () {

  rm -f /tmp/.sshplus_force_ok > /dev/null 2>&1

  local tmpdir
  tmpdir=$(mktemp -d -t sshplus-update.XXXXXX) || return 1

  cd "$tmpdir" || { rm -rf "$tmpdir"; return 1; }

  wget -q https://github.com/MinaDiNabil/SSHPLUS-MANGER/archive/refs/heads/main.tar.gz -O main.tar.gz \
    || { cd "$HOME"; rm -rf "$tmpdir"; return 1; }

  tar -xzf main.tar.gz \
    || { cd "$HOME"; rm -rf "$tmpdir"; return 1; }

  local src="$tmpdir/SSHPLUS-MANGER-main"
  [[ ! -d "$src/Modulos" ]] && { cd "$HOME"; rm -rf "$tmpdir"; return 1; }

  # Modules that live in /bin/ and are invoked directly by the menu.
  # "badvpn" is intentionally absent — Modulos/badvpn is the udpgw
  # ELF binary, not the menu wrapper. Copying it here would overwrite
  # /bin/badvpn with the binary and break the "[1] ATIVAR BADVPN"
  # menu option (silent failure: the binary runs with no args and
  # exits). The wrapper is copied from Sistema/badvpn after this loop.
  local _mdls=(addhost delhost alterarsenha criarusuario expcleaner \
               mudardata remover criarteste verifbot droplimiter \
               alterarlimite ajuda sshmonitor userbackup \
               instsqd blockt otimizar menu speedtest banner \
               senharoot reiniciarservicos reiniciarsistema attscript \
               conexao delscript detalhes botssh infousers verifatt \
               limiter uexpired trojan-go onlineapp swapmemory \
               initbot initcheck pkill.sh domaincheck)

  for _arq in "${_mdls[@]}"; do
    if [[ -f "$src/Modulos/$_arq" ]]; then
      cp -f "$src/Modulos/$_arq" "/bin/$_arq"
      dos2unix "/bin/$_arq" 2>/dev/null
      chmod +x "/bin/$_arq"
    fi
  done

  # BadVPN menu wrapper from Sistema/. Overwrites any binary that an
  # older attscript run mistakenly placed at /bin/badvpn.
  if [[ -f "$src/Sistema/badvpn" ]] && head -n1 "$src/Sistema/badvpn" 2>/dev/null | grep -q '^#!/bin/bash'; then
    cp -f "$src/Sistema/badvpn" /bin/badvpn
    dos2unix /bin/badvpn 2>/dev/null
    chmod +x /bin/badvpn
  fi

  # BadVPN binary from Modulos/. The udpgw daemon itself lives at
  # /bin/badvpn-udpgw; refresh it whenever the upstream binary changes
  # so a fresh attscript run also picks up any binary update.
  #
  # CRITICAL: Modulos/badvpn in the repo is an x86_64 ELF. The
  # previous version of this check only validated the leading 4 bytes
  # (ELF magic) which match ANY architecture — running attscript on
  # an aarch64 host would silently overwrite the working ARM binary
  # with a useless x86_64 one, and the next BadVPN respawn would die
  # with ENOEXEC. Verify the EM_X86_64 e_machine field (byte 18 =
  # 0x3e, byte 19 = 0x00) before installing, and only proceed if the
  # current host is actually x86_64.
  if [[ -f "$src/Modulos/badvpn" ]] && head -c 4 "$src/Modulos/badvpn" 2>/dev/null | grep -q $'\x7fELF'; then
    local _host_arch _bv_b18 _bv_b19
    _host_arch=$(uname -m 2>/dev/null)
    _bv_b18=$(od -An -tx1 -N1 -j18 "$src/Modulos/badvpn" 2>/dev/null | tr -d ' ')
    _bv_b19=$(od -An -tx1 -N1 -j19 "$src/Modulos/badvpn" 2>/dev/null | tr -d ' ')
    case "$_host_arch" in
      x86_64|amd64)
        # EM_X86_64 = 0x3e 0x00 little-endian
        if [[ "$_bv_b18" = "3e" && "$_bv_b19" = "00" ]]; then
          install -m 755 "$src/Modulos/badvpn" /bin/badvpn-udpgw
        fi
        ;;
      *)
        # Wrong-arch binary in repo for this host — leave existing
        # /bin/badvpn-udpgw alone. The user installed it via a
        # platform-specific path (listARM, native build, etc.) and we
        # must not clobber it with the x86_64 blob.
        :
        ;;
    esac
  fi

  # Helper files that live in /etc/SSHPlus/ (not run from /bin/).
  mkdir -p /etc/SSHPlus 2>/dev/null
  local _plus=(cabecalho bot open.py proxy.py wsproxy.py)
  # Remove any leftover sniproxy.py from older installs; SSL TUNNEL is
  # back on stunnel4 with a static self-signed cert.
  rm -f /etc/SSHPlus/sniproxy.py 2>/dev/null
  for _arq in "${_plus[@]}"; do
    if [[ -f "$src/Modulos/$_arq" ]]; then
      cp -f "$src/Modulos/$_arq" "/etc/SSHPlus/$_arq"
      dos2unix "/etc/SSHPlus/$_arq" 2>/dev/null
      chmod +x "/etc/SSHPlus/$_arq"
    fi
  done

  # Refresh the stunnel config template (kept for reference / re-installs).
  if [[ -f "$src/Install/stunnel" && -d /etc/stunnel ]]; then
    cp -f "$src/Install/stunnel" /etc/stunnel/stunnel.conf.sample 2>/dev/null
  fi

  cd "$HOME"
  rm -rf "$tmpdir"

  # Stop and clean up any sniproxy/sslmux screen sessions from older
  # installs — SSL TUNNEL is now back on stunnel4.
  for s in $(screen -ls 2>/dev/null | grep -E '\.(sslmux_|sniproxy_)' | awk '{print $1}'); do
    screen -S "$s" -X quit 2>/dev/null
  done
  sed -i '/sniproxy\.py/d;/sslmux_.*python3/d' /etc/autostart 2>/dev/null

  # Restart wsproxy/proxy/open screens so refreshed Python files take effect.
  for s in $(screen -ls 2>/dev/null | grep -E '\.(ws[0-9]*|proxy|openpy)' | awk '{print $1}'); do
    screen -S "$s" -X quit 2>/dev/null
  done

  # Make sure stunnel4 is running if its config exists, and that the
  # keep-alive watchdog is registered.
  if [[ -f /etc/stunnel/stunnel.conf && -s /etc/stunnel/stunnel.pem ]]; then
    mkdir -p /var/run/stunnel4 /var/log/stunnel4 2>/dev/null
    chown stunnel4:stunnel4 /var/run/stunnel4 /var/log/stunnel4 /etc/stunnel/stunnel.pem 2>/dev/null
    [[ -f /etc/default/stunnel4 ]] && sed -i 's/^[# ]*ENABLED=.*/ENABLED=1/' /etc/default/stunnel4

    # Free port 443 from nginx / apache / caddy if they're squatting on
    # it. Without this, the injector hits the wrong daemon, the SSL
    # TUNNEL never sees the traffic, and the client logs "HTTP/1.1 526"
    # or "HTTP/1.1 400 Bad Request" instead of a proper SSH handshake.
    _holder443=$(ss -tlnpH 2>/dev/null | awk '$4 ~ /(^|:)443$/ {print $NF; exit}')
    if echo "$_holder443" | grep -qE 'apache2|httpd'; then
      sed -i 's/^[[:space:]]*Listen[[:space:]]\+443[[:space:]]*$/Listen 8443/g' /etc/apache2/ports.conf 2>/dev/null
      sed -i 's/<VirtualHost[[:space:]]\+\*:443>/<VirtualHost *:8443>/g' /etc/apache2/sites-enabled/*.conf 2>/dev/null
      service apache2 restart >/dev/null 2>&1
    elif echo "$_holder443" | grep -qE 'nginx'; then
      for _f in /etc/nginx/sites-enabled/* /etc/nginx/conf.d/*.conf /etc/nginx/nginx.conf; do
        [[ -f "$_f" ]] || continue
        sed -i -E 's/(\<listen\b[[:space:]]+(\[[^]]*\]:)?)443\b/\18443/g' "$_f" 2>/dev/null
      done
      nginx -t >/dev/null 2>&1 && (systemctl reload nginx 2>/dev/null || service nginx reload 2>/dev/null || systemctl restart nginx 2>/dev/null)
    fi
    sleep 1

    # If anything (caddy/haproxy/leftover process) still owns 443,
    # force-stop it so stunnel4 can take over.
    if ss -tlnH 2>/dev/null | awk '{print $4}' | grep -qE '(^|:)443$'; then
      _holder443=$(ss -tlnpH 2>/dev/null | awk '$4 ~ /(^|:)443$/ {print $NF; exit}')
      if ! echo "$_holder443" | grep -qE 'stunnel'; then
        for _svc in apache2 httpd nginx caddy haproxy; do
          systemctl stop "$_svc" >/dev/null 2>&1
        done
      fi
      sleep 1
    fi

    # Migrate old installs whose stunnel.conf still points at the
    # wsproxy multiplexer on 127.0.0.1:700 (an earlier revision used
    # an intermediate Python relay between stunnel and sshd). The
    # multiplexer broke "SSL TUNNEL + Payload" in real-world tests
    # against carrier-NAT'd mobile injectors, so we revert to the
    # upstream SSHPLUS topology: stunnel:443 → sshd:22 directly.
    # Users who want Payload mode install a WS proxy on a different
    # port via the conexao menu (handled by wsproxy.py on the user
    # port → backend SSH).
    if grep -qE '^[[:space:]]*connect[[:space:]]*=[[:space:]]*127\.0\.0\.1:(700|80|110)[[:space:]]*$' /etc/stunnel/stunnel.conf 2>/dev/null; then
      sed -i 's|^[[:space:]]*connect[[:space:]]*=.*|connect = 127.0.0.1:22|' /etc/stunnel/stunnel.conf
    fi
    # Retire every legacy sslmux session bound to :700 and its
    # autostart entries (regardless of which backend port the legacy
    # spawn was using — 22, 80, 110, ...).
    for s in $(screen -ls 2>/dev/null | grep -E '\.sslmux(_[0-9]+)?$' | awk '{print $1}'); do
      screen -S "$s" -X quit 2>/dev/null
    done
    screen -wipe >/dev/null 2>&1
    pkill -f 'wsproxy\.py 700 ' >/dev/null 2>&1
    sed -i '/wsproxy\.py 700 /d' /etc/autostart 2>/dev/null

    systemctl enable stunnel4 >/dev/null 2>&1
    systemctl daemon-reload >/dev/null 2>&1
    service stunnel4 restart >/dev/null 2>&1
  fi

  # Force-restart every Python proxy screen so the refreshed wsproxy.py /
  # proxy.py / open.py code is actually running. screen -dmS without a
  # prior quit silently skips when a session with the same name already
  # exists, which is exactly how an old wsproxy keeps serving stale
  # logic after a /bin/attscript upgrade. Note: sslmux (port 700) is
  # NOT respawned — the SSL TUNNEL no longer routes through it.
  for s in $(screen -ls 2>/dev/null | grep -E '\.(sslmux(_[0-9]+)?|ws[0-9]*|proxy|openpy)' | awk '{print $1}'); do
    screen -S "$s" -X quit 2>/dev/null
  done
  screen -wipe >/dev/null 2>&1
  sleep 1

  # Refresh /etc/autostart with the unified watchdog + stunnel watchdog
  # blocks. Older installs that pre-date these blocks pick them up here.
  if ! grep -q '# SSHPLUS_STUNNEL_WATCHDOG' /etc/autostart 2>/dev/null; then
    cat >>/etc/autostart <<'WATCH_EOF'
# SSHPLUS_STUNNEL_WATCHDOG
if [[ -f /etc/stunnel/stunnel.conf ]]; then
	_acc=$(grep -E '^[[:space:]]*accept[[:space:]]*=' /etc/stunnel/stunnel.conf | awk -F'=' '{gsub(/[[:space:]]/,"",$2); print $2}' | awk -F: '{print $NF}')
	for _p in $_acc; do
		if ! ss -tlnH 2>/dev/null | awk '{print $4}' | grep -qE "(^|:)${_p}\$"; then
			service stunnel4 restart >/dev/null 2>&1
			break
		fi
	done
fi
WATCH_EOF
  fi
  if ! grep -q '# SSHPLUS_SERVICE_WATCHDOG' /etc/autostart 2>/dev/null; then
    cat >>/etc/autostart <<'SVC_WATCH_EOF'
# SSHPLUS_SERVICE_WATCHDOG
_sshplus_watch() {
	local _svc="$1" _check="$2"
	systemctl list-unit-files 2>/dev/null | grep -qw "${_svc}.service" || return 0
	if ! eval "$_check" >/dev/null 2>&1; then
		systemctl restart "$_svc" >/dev/null 2>&1 || service "$_svc" restart >/dev/null 2>&1
	fi
}
_sshplus_watch ssh       'pgrep -x sshd'
_sshplus_watch dropbear  'pgrep -x dropbear'
[[ -f /etc/stunnel/stunnel.conf ]] && _sshplus_watch stunnel4 'pgrep -x stunnel4'
[[ -f /etc/openvpn/server.conf ]]  && _sshplus_watch openvpn  'pgrep -x openvpn'
[[ -f /etc/squid/squid.conf ]]     && _sshplus_watch squid    'pgrep -x squid'
[[ -f /etc/squid3/squid.conf ]]    && _sshplus_watch squid3   'pgrep -x squid'
unset -f _sshplus_watch
for _p in $(pgrep -x sshd) $(pgrep -x dropbear) $(pgrep -x stunnel4) \
          $(pgrep -x openvpn) $(pgrep -x squid); do
	[[ -w "/proc/$_p/oom_score_adj" ]] && echo -500 > "/proc/$_p/oom_score_adj" 2>/dev/null
done
SVC_WATCH_EOF
  fi

  # Register logrotate config for stunnel / sshplus logs (idempotent).
  if [[ ! -f /etc/logrotate.d/sshplus ]]; then
    cat >/etc/logrotate.d/sshplus <<'LOGROTATE_EOF'
/var/log/stunnel4/*.log {
	daily
	rotate 7
	maxsize 50M
	compress
	delaycompress
	missingok
	notifempty
	copytruncate
	su stunnel4 stunnel4
}
/var/log/sshplus/*.log {
	daily
	rotate 7
	maxsize 20M
	compress
	delaycompress
	missingok
	notifempty
	copytruncate
}
LOGROTATE_EOF
    mkdir -p /var/log/sshplus
  fi

  # Add or refresh conntrack + overcommit_memory to sysctl drop-in.
  # Two phases:
  #   1. Append the block if it's entirely missing (fresh install
  #      that pre-dates the conntrack section).
  #   2. Bump in-place when an older attscript wrote the old 1M/256K
  #      ceilings — the install/list values are now 4M/1M to match
  #      1M+ user installations, and the prior `grep -q` guard meant
  #      legacy installs were frozen at the old caps forever.
  if [[ -f /etc/sysctl.d/99-sshplus.conf ]]; then
    if ! grep -q 'nf_conntrack_max' /etc/sysctl.d/99-sshplus.conf; then
      cat >>/etc/sysctl.d/99-sshplus.conf <<'CONNTRACK_EOF'

# --- Connection tracking (added by attscript upgrade, sized for 1M+ users) ---
net.netfilter.nf_conntrack_max = 4194304
net.nf_conntrack_max = 4194304
net.netfilter.nf_conntrack_tcp_timeout_established = 86400
net.netfilter.nf_conntrack_tcp_timeout_time_wait = 30
net.netfilter.nf_conntrack_tcp_timeout_close_wait = 30
net.netfilter.nf_conntrack_tcp_timeout_fin_wait = 30
net.netfilter.nf_conntrack_buckets = 1048576
vm.overcommit_memory = 1
CONNTRACK_EOF
    else
      # Bump legacy 1M ceiling to 4M in-place
      sed -i -E 's|^(net\.(netfilter\.)?nf_conntrack_max)[[:space:]]*=[[:space:]]*1048576[[:space:]]*$|\1 = 4194304|' /etc/sysctl.d/99-sshplus.conf
      sed -i -E 's|^(net\.netfilter\.nf_conntrack_buckets)[[:space:]]*=[[:space:]]*262144[[:space:]]*$|\1 = 1048576|' /etc/sysctl.d/99-sshplus.conf
    fi
    modprobe nf_conntrack 2>/dev/null
    echo 1048576 > /sys/module/nf_conntrack/parameters/hashsize 2>/dev/null
    sysctl --system >/dev/null 2>&1 || true
  fi

  # Register the daily proxy-restart cron entry that prevents long-term
  # memory creep in the Python proxies.
  if ! crontab -l 2>/dev/null | grep -q 'SSHPLUS_PROXY_RESTART'; then
    # Quit-and-respawn: chain `/etc/autostart` after the quit so the
    # proxies come back within ~2 seconds instead of waiting up to
    # 60s for the next per-minute autostart tick. Without this, every
    # day at 04:00 SSL TUNNEL/SOCKS/WS users got dropped for a minute.
    (crontab -l 2>/dev/null; echo '0 4 * * * for s in $(screen -ls 2>/dev/null | grep -E "\.(ws[0-9]*|sslmux(_[0-9]+)?|proxy|openpy)" | awk "{print \$1}"); do screen -S "$s" -X quit; done; sleep 2; /etc/autostart >/dev/null 2>&1 # SSHPLUS_PROXY_RESTART') | crontab -
  fi

  # Enable AUTO EXECUTION (menu;) on login if /etc/profile doesn't have it.
  if [[ -f /etc/profile ]] && ! grep -q '^menu;$' /etc/profile; then
    grep -v '^menu;$' /etc/profile > /tmp/sshplus_profile && mv /tmp/sshplus_profile /etc/profile
    echo "menu;" >> /etc/profile
  fi

  # Make sure BadVPN's screen session is alive on the next /etc/autostart tick.
  # Uses awk '{print $4}' — ss -lnuH prints the local address in $4, not $5
  # ($5 is the peer wildcard 0.0.0.0:* which never matches). Args MUST match
  # Install/list section [1/8] and Sistema/badvpn (--max-clients 1000). The
  # previous 10000 here was an outlier that turned the box into a far larger
  # UDP relay than the other two launch paths, amplifying the per-user DNS
  # fan-out that got the VPS suspended for abuse. Keep all three in lockstep.
  if [[ -x /bin/badvpn-udpgw ]] && ! ss -lnuH 2>/dev/null | awk '{print $4}' | grep -qE '(^|:)7300$'; then
    screen -dmS udpvpn /bin/badvpn-udpgw --listen-addr 127.0.0.1:7300 --max-clients 1000 --max-connections-for-client 10 --client-socket-sndbuf 10000 2>/dev/null
  fi

  # --- Anti-flood guardrails for ALREADY-INSTALLED boxes --------------
  # Fresh installs get these from Install/list sections [9/9] (anti-flood
  # chain) and the dnsmasq block. Existing servers pick them up HERE on
  # "force pull latest fixes" so the OVH DNS-flood / SMTP-relay
  # suspension cannot recur. Both halves are idempotent and the chain is
  # wired into the per-minute /etc/autostart tick so it self-heals.
  cat > /etc/Plus-antiflood <<'ANTIFLOOD_EOF'
#!/bin/bash
CHAIN=SSHPLUS_ANTIFLOOD
_hooked() { iptables -C "$1" -j "$CHAIN" 2>/dev/null; }
if iptables -nL "$CHAIN" >/dev/null 2>&1 && _hooked OUTPUT && _hooked FORWARD; then
	exit 0
fi
if iptables -nL "$CHAIN" >/dev/null 2>&1; then
	iptables -F "$CHAIN"
else
	iptables -N "$CHAIN"
fi
for proto in udp tcp; do
	iptables -A "$CHAIN" -p "$proto" --dport 53 \
		-m hashlimit --hashlimit-name "dnsflood_${proto}" \
		--hashlimit-mode srcip --hashlimit-above 500/sec \
		--hashlimit-burst 1000 -j DROP
done
for port in 25 465 587 2525; do
	iptables -A "$CHAIN" -p tcp --dport "$port" -j DROP
done
iptables -A "$CHAIN" -j RETURN
_hooked OUTPUT  || iptables -I OUTPUT  -j "$CHAIN"
_hooked FORWARD || iptables -I FORWARD -j "$CHAIN"
ANTIFLOOD_EOF
  chmod +x /etc/Plus-antiflood
  bash /etc/Plus-antiflood >/dev/null 2>&1
  if ! grep -q "/etc/Plus-antiflood" /etc/autostart 2>/dev/null; then
    echo "[[ -e /etc/Plus-antiflood ]] && bash /etc/Plus-antiflood >/dev/null 2>&1" >> /etc/autostart
  fi

  # Local DNS cache for boxes still pointed straight at public resolvers.
  # Always rewrite the config so existing boxes pick up the 10.8.0.1
  # listen-address (needed for OpenVPN clients) and bind-dynamic.
  if ! command -v dnsmasq >/dev/null 2>&1; then
    DEBIAN_FRONTEND=noninteractive apt-get install -y dnsmasq >/dev/null 2>&1
  fi
  if command -v dnsmasq >/dev/null 2>&1; then
    mkdir -p /etc/dnsmasq.d
    cat > /etc/dnsmasq.d/sshplus.conf <<'DNSMASQ_EOF'
listen-address=127.0.0.1,10.8.0.1
bind-dynamic
no-resolv
server=1.1.1.1
server=9.9.9.9
cache-size=10000
min-cache-ttl=60
dns-forward-max=150
DNSMASQ_EOF
    systemctl enable dnsmasq >/dev/null 2>&1
    systemctl restart dnsmasq >/dev/null 2>&1
    sleep 1
    if ss -lnH 'sport = :53' 2>/dev/null | grep -q '127.0.0.1:53'; then
      chattr -i /etc/resolv.conf >/dev/null 2>&1 || true
      [[ -L /etc/resolv.conf ]] && rm -f /etc/resolv.conf
      printf 'nameserver 127.0.0.1\nnameserver 1.1.1.1\n' > /etc/resolv.conf
    fi
  fi

  [[ -x /etc/autostart ]] && /etc/autostart > /dev/null 2>&1

  touch /tmp/.sshplus_force_ok
  return 0
}

# Install / refresh the iptables OUTPUT-chain DNAT that loops Squid's
# outbound CONNECTs back to the local sniproxy + wsproxy listeners.
# See the comment block in Install/list (search for /etc/Plus-loopback)
# for the long-form explanation. Brief version: when a mobile injector
# sends "CONNECT bug-host:443" to Squid, Squid resolves bug-host (e.g.
# paysecure.islamicbank.ps, easternbank.ap.gateway.mastercard.com,
# oauth2.gbp.ma, three-cust-imgs.hcaptcha.com, ...) to its real
# public IP and opens TCP to that real server — so the inner SSH
# stream never reaches the user's box, even though Squid replies
# "200 Connection established". The DNAT rewrites those destinations
# to 127.0.0.1, where sniproxy issues a leaf cert that matches the
# SNI and forwards plaintext to the SSH backend.
#
# Idempotent: re-running is cheap once the chain is in place. The
# rule is owner-scoped to the squid user so unrelated traffic on the
# box is never NATed.
fun_install_squid_loopback () {
  cat > /etc/Plus-loopback <<'LOOPBACK_EOF'
#!/bin/bash
set +e

CHAIN=SSHPLUS_LOOPBACK
TARGET_PORTS=(80 443 8080 8443 8880 8888)

SQUID_USER=""
for _u in proxy squid; do
	if id -u "$_u" >/dev/null 2>&1; then
		SQUID_USER="$_u"
		if pgrep -u "$_u" -x squid >/dev/null 2>&1; then
			break
		fi
	fi
done
[[ -z "$SQUID_USER" ]] && exit 0

command -v iptables >/dev/null 2>&1 || exit 0
modprobe iptable_nat 2>/dev/null
modprobe nf_nat 2>/dev/null

if iptables -t nat -nL "$CHAIN" >/dev/null 2>&1 && \
   iptables -t nat -C OUTPUT -j "$CHAIN" 2>/dev/null; then
	exit 0
fi

if iptables -t nat -nL "$CHAIN" >/dev/null 2>&1; then
	iptables -t nat -F "$CHAIN"
else
	iptables -t nat -N "$CHAIN"
fi

iptables -t nat -A "$CHAIN" -d 127.0.0.0/8 -j RETURN

for P in "${TARGET_PORTS[@]}"; do
	iptables -t nat -A "$CHAIN" -m owner --uid-owner "$SQUID_USER" \
		-p tcp --dport "$P" -j DNAT --to-destination "127.0.0.1:$P"
done

iptables -t nat -C OUTPUT -j "$CHAIN" 2>/dev/null || \
	iptables -t nat -I OUTPUT -j "$CHAIN"

exit 0
LOOPBACK_EOF
  chmod +x /etc/Plus-loopback
  bash /etc/Plus-loopback >/dev/null 2>&1

  if ! grep -q "/etc/Plus-loopback" /etc/autostart 2>/dev/null; then
    echo "[[ -e /etc/Plus-loopback ]] && bash /etc/Plus-loopback >/dev/null 2>&1" >> /etc/autostart
  fi
}

# Repair the Squid ACL on existing installs. The original config was:
#
#     acl url1 dstdomain -i 127.0.0.1
#     acl url2 dstdomain -i localhost
#     acl url3 dstdomain -i $ipdovps
#     acl url4 dstdomain -i /SSHPLUS?
#     acl payload url_regex -i "$var_pay"
#     acl all src 0.0.0.0/0
#     http_access allow url1
#     http_access allow url2
#     http_access allow url3
#     http_access allow url4
#     http_access allow payload
#     http_access deny all
#
# Any client-issued CONNECT (or GET) whose host wasn't 127.0.0.1,
# localhost, the server IP, "/SSHPLUS?", or one of the four payload
# domains hit `http_access deny all` and got refused. That's exactly
# the user-visible behaviour "the same connection works when I point
# the injector at the IP but fails when I point it at the domain":
# the IP path matches `url3`, the bug-host path matches nothing.
#
# Replace those lines with an ACL that allows CONNECT to any host on
# a safe TCP port (443/8443/80/...), keeps plain-HTTP restricted to
# the bug-host list to avoid open-relay abuse, and refreshes the
# payload list with the well-known carrier-zero-rated hosts so they
# work out of the box. Idempotent: re-running adds nothing if the
# config already has the new SSL_ports/CONNECT block.
fun_fix_squid_acl () {
  local _conf _pay _bak
  for _candidate in /etc/squid/squid.conf /etc/squid3/squid.conf; do
    if [[ -f "$_candidate" ]]; then
      _conf="$_candidate"
      _pay="${_candidate%/squid.conf}/payload.txt"
      break
    fi
  done
  [[ -z "$_conf" ]] && return 0

  # The freshness check matches a comment unique to the new config so
  # we can short-circuit when there is nothing to do.
  if grep -q '^acl SSL_ports port' "$_conf" 2>/dev/null \
     && grep -q 'http_access allow CONNECT Safe_ports' "$_conf" 2>/dev/null; then
    return 0
  fi

  _bak="${_conf}.pre-sshplus-bughost.bak"
  [[ -f "$_bak" ]] || cp -a "$_conf" "$_bak"

  local _ipdovps _portas
  _ipdovps=$(cat /etc/IP 2>/dev/null | tr -d '[:space:]')
  [[ -z "$_ipdovps" ]] && _ipdovps=$(curl -s -m 5 https://api.ipify.org 2>/dev/null)
  [[ -z "$_ipdovps" ]] && _ipdovps=$(hostname -I 2>/dev/null | awk '{print $1}')

  # Preserve any http_port lines the user added through the menu.
  _portas=$(awk '/^[[:space:]]*http_port[[:space:]]/ {print}' "$_conf")
  [[ -z "$_portas" ]] && _portas="http_port 3128"

  cat > "$_pay" <<-PAYLOAD_EOF
	# Bug-host allow list for plain-HTTP requests through Squid.
	# CONNECT (HTTPS) to any destination is already allowed
	# unconditionally on the SSL_ports below — these entries
	# only matter for non-encrypted GET/POST/HEAD payloads
	# that mobile injectors send to zero-rated domains.
	#
	# Add one host or .domain per line. Lines starting with
	# "#" are ignored. Wildcard form ".example.com" matches
	# example.com and every subdomain.
	.whatsapp.net
	.whatsapp.com
	.facebook.net
	.facebook.com
	.twitter.com
	.speedtest.net
	# Common payment / banking gateways used as bug hosts
	.islamicbank.ps
	.gateway.mastercard.com
	.gbp.ma
	# Captcha CDN endpoints commonly used as bug hosts
	.hcaptcha.com
	.recaptcha.net
	PAYLOAD_EOF

  cat > "$_conf" <<-CONF_EOF
	# Allow CONNECT (HTTPS) to any destination — the request body
	# is encrypted so Squid cannot be abused to inject content,
	# and this is what makes bug-host SNIs (paysecure.islamicbank.ps,
	# *.gateway.mastercard.com, hcaptcha endpoints, ...) work.
	# Plain HTTP (GET/POST/HEAD) is still restricted to the
	# server itself and to the bug-host list in $_pay so
	# the proxy cannot be used as an open HTTP relay.
	acl SSL_ports port 443 8443
	acl Safe_ports port 80 443 1025-65535
	acl CONNECT method CONNECT

	acl url1 dstdomain -i 127.0.0.1
	acl url2 dstdomain -i localhost
	acl url3 dstdomain -i $_ipdovps
	acl url4 dstdomain -i /SSHPLUS?
	acl payload url_regex -i "$_pay"
	acl all src 0.0.0.0/0

	# Hard safety: never CONNECT to a port outside Safe_ports
	# (blocks abuse like CONNECT 25 for spam relays) but allow
	# any CONNECT destination on a safe port, especially 443.
	http_access deny CONNECT !Safe_ports
	http_access allow CONNECT Safe_ports

	http_access allow url1
	http_access allow url2
	http_access allow url3
	http_access allow url4
	http_access allow payload
	http_access deny all

	#Portas
	$_portas
	#Nome squid
	visible_hostname SSHPLUS
	via off
	forwarded_for off
	pipeline_prefetch off
	CONF_EOF

  # Apply the new config; restart whichever flavour of Squid is here.
  if [[ "$_conf" == /etc/squid/squid.conf ]]; then
    /etc/init.d/squid restart >/dev/null 2>&1
    service squid restart >/dev/null 2>&1
  else
    /etc/init.d/squid3 restart >/dev/null 2>&1
    service squid3 restart >/dev/null 2>&1
  fi
}

# Migrate a legacy static-cert stunnel install to the dynamic-SNI
# sniproxy listener, in place. Idempotent: safe to call when sniproxy
# is already the listener — it just re-bootstraps the CA.
#
# This finally retires the cycle of "regenerate the cert, restart
# stunnel, hope the SAN happens to cover whatever hostname the client
# typed". With sniproxy the cert is generated per ClientHello to match
# whatever SNI showed up, so the user's own domain *and* every
# bug-host SNI used to bypass carrier billing all just work.
fun_migrate_to_sniproxy () {
  [[ ! -d /etc/stunnel ]] && mkdir -p /etc/stunnel 2>/dev/null
  command -v python3 >/dev/null 2>&1 || apt-get install python3 -y >/dev/null 2>&1
  command -v openssl >/dev/null 2>&1 || apt-get install openssl -y >/dev/null 2>&1
  [[ -f /etc/SSHPlus/sniproxy.py ]] || return 0

  python3 - <<'PY' >/dev/null 2>&1
import sys
sys.path.insert(0, '/etc/SSHPlus')
import sniproxy
sniproxy.ensure_ca()
sniproxy.ensure_default_leaf()
PY

  # Re-spawn sniproxy + sslmux pairs for every accept port we know
  # about. Sources:
  #   1. Legacy stunnel.conf [section] blocks (one per accept port).
  #   2. Existing sniproxy_PORT screen sessions (already migrated).
  # We rebuild from (1) because the matching wsproxy mux ports there
  # are guaranteed to be paired with a backend SSH/Dropbear port. For
  # (2) we leave the screen alone — the entry is already in autostart.
  if [[ -f /etc/stunnel/stunnel.conf ]]; then
    local _accept _connect _mux _backend _wsline
    while read -r _accept _connect; do
      [[ -z "$_accept" || -z "$_connect" ]] && continue
      _mux=${_connect##*:}
      # Look up which backend the existing wsproxy multiplexer was
      # forwarding to by reading its full command line. Falls back to
      # SSH:22 if the multiplexer process is gone.
      _wsline=$(ps -eo args 2>/dev/null \
        | awk -v m="$_mux" '/wsproxy\.py/ && $0 ~ ("wsproxy\\.py[[:space:]]+"m"[[:space:]]") {print; exit}')
      _backend=$(echo "$_wsline" | awk '{
        for (i=1;i<=NF;i++) if ($i ~ /wsproxy\.py$/) { print $(i+2); exit }
      }')
      [[ -z "$_backend" ]] && _backend=22
      # Stop any wsproxy currently bound to $_mux so the fresh one we
      # launch below can take over the port. Old installs named the
      # initial 443 multiplexer just `sslmux` (no port suffix) while
      # later additions use `sslmux_<port>`; kill both shapes plus any
      # bare process whose command line points at this mux port.
      for s in $(screen -ls 2>/dev/null | awk -v p="$_mux" '
        /\.sslmux/{
          name=$1; sub(/^[0-9]+\./, "", name); print name
        }'); do
        screen -S "$s" -X quit 2>/dev/null
      done
      screen -S sniproxy_${_accept} -X quit 2>/dev/null
      pkill -f "wsproxy\\.py[[:space:]]+${_mux}[[:space:]]" 2>/dev/null
      sleep 1
      screen -dmS sslmux_${_accept} python3 /etc/SSHPlus/wsproxy.py $_mux $_backend 127.0.0.1
      screen -dmS sniproxy_${_accept} python3 /etc/SSHPlus/sniproxy.py $_accept $_mux
      # Replace matching autostart lines so the new entries are canonical
      # (otherwise duplicates accumulate across update runs and a
      # legacy `sslmux` line would respawn the stale multiplexer every
      # minute).
      sed -i "/sslmux python3 \\/etc\\/SSHPlus\\/wsproxy\\.py ${_mux} /d" /etc/autostart 2>/dev/null
      sed -i "/sslmux_${_accept} python3/d" /etc/autostart 2>/dev/null
      sed -i "/sniproxy.py ${_accept} /d" /etc/autostart 2>/dev/null
      echo "ss -tlnH 2>/dev/null | awk '{print \$4}' | grep -qE '(^|:)${_mux}\$' || screen -dmS sslmux_${_accept} python3 /etc/SSHPlus/wsproxy.py $_mux $_backend 127.0.0.1" >>/etc/autostart
      echo "ss -tlnH 2>/dev/null | awk '{print \$4}' | grep -qE '(^|:)${_accept}\$' || screen -dmS sniproxy_${_accept} python3 /etc/SSHPlus/sniproxy.py $_accept $_mux" >>/etc/autostart
    done < <(awk '
      /^\[/ { acc=""; conn="" }
      $1=="accept"  && $2=="=" { acc=$3 }
      $1=="connect" && $2=="=" { conn=$3 }
      acc != "" && conn != "" { print acc, conn; acc=""; conn="" }
    ' /etc/stunnel/stunnel.conf)
  fi

  # Take stunnel down for good — sniproxy now owns those ports.
  service stunnel4 stop >/dev/null 2>&1
  systemctl disable stunnel4 >/dev/null 2>&1
  if [[ -f /etc/default/stunnel4 ]]; then
    sed -i 's/^[# ]*ENABLED=.*/ENABLED=0/' /etc/default/stunnel4
  fi
}

