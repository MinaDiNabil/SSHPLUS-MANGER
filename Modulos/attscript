# Pull the latest module/source files from the main branch without
# re-running the full installer. Useful for picking up bug fixes that
# were merged without bumping the version number.
fun_force_update () {

  rm -f /tmp/.sshplus_force_ok > /dev/null 2>&1

  local tmpdir
  tmpdir=$(mktemp -d -t sshplus-update.XXXXXX) || return 1

  cd "$tmpdir" || { rm -rf "$tmpdir"; return 1; }

  wget -q https://github.com/MinaDiNabil/SSHPLUS-MANGER/archive/refs/heads/main.tar.gz -O main.tar.gz \
    || { cd "$HOME"; rm -rf "$tmpdir"; return 1; }

  tar -xzf main.tar.gz \
    || { cd "$HOME"; rm -rf "$tmpdir"; return 1; }

  local src="$tmpdir/SSHPLUS-MANGER-main"
  [[ ! -d "$src/Modulos" ]] && { cd "$HOME"; rm -rf "$tmpdir"; return 1; }

  # Modules that live in /bin/ and are invoked directly by the menu.
  local _mdls=(addhost delhost alterarsenha criarusuario expcleaner \
               mudardata remover criarteste verifbot droplimiter \
               alterarlimite ajuda sshmonitor badvpn userbackup \
               instsqd blockt otimizar menu speedtest banner \
               senharoot reiniciarservicos reiniciarsistema attscript \
               conexao delscript detalhes botssh infousers verifatt \
               limiter uexpired trojan-go onlineapp swapmemory \
               initbot initcheck pkill.sh)

  for _arq in "${_mdls[@]}"; do
    if [[ -f "$src/Modulos/$_arq" ]]; then
      cp -f "$src/Modulos/$_arq" "/bin/$_arq"
      dos2unix "/bin/$_arq" 2>/dev/null
      chmod +x "/bin/$_arq"
    fi
  done

  # Helper files that live in /etc/SSHPlus/ (not run from /bin/).
  mkdir -p /etc/SSHPlus 2>/dev/null
  local _plus=(cabecalho bot open.py proxy.py wsproxy.py sniproxy.py)
  for _arq in "${_plus[@]}"; do
    if [[ -f "$src/Modulos/$_arq" ]]; then
      cp -f "$src/Modulos/$_arq" "/etc/SSHPlus/$_arq"
      dos2unix "/etc/SSHPlus/$_arq" 2>/dev/null
      chmod +x "/etc/SSHPlus/$_arq"
    fi
  done

  # Refresh the stunnel config template (kept for reference / re-installs).
  if [[ -f "$src/Install/stunnel" && -d /etc/stunnel ]]; then
    cp -f "$src/Install/stunnel" /etc/stunnel/stunnel.conf.sample 2>/dev/null
  fi

  cd "$HOME"
  rm -rf "$tmpdir"

  # Bootstrap the dynamic-SNI CA and migrate any legacy stunnel install
  # to sniproxy. Old installs were shipping a static self-signed cert
  # whose SAN had to match the user's domain *and* every bug-host SNI
  # the injector might send — an endless game of whack-a-mole that's
  # exactly what the dynamic listener gets rid of.
  fun_migrate_to_sniproxy

  # Patch the Squid HTTP proxy ACL. Old installs shipped a config that
  # explicitly denied any destination domain other than the server's
  # own IP and a tiny payload allow-list — so CONNECT requests to any
  # bug host (paysecure.islamicbank.ps, *.gateway.mastercard.com,
  # hcaptcha endpoints, ...) were rejected by Squid even when the SSH
  # tunnel itself was healthy. This is the actual reason "works on
  # the IP, fails on the domain" survived every previous fix.
  fun_fix_squid_acl

  # Stop legacy multiplexers (refreshed wsproxy.py takes effect on
  # respawn) and any leftover stunnel service. /etc/autostart will
  # re-spawn the sniproxy + sslmux pairs we just registered on the
  # next cron tick, but invoking it manually closes the gap.
  for s in $(screen -ls 2>/dev/null | grep -E '\.(sslmux_|sniproxy_)' | awk '{print $1}'); do
    screen -S "$s" -X quit 2>/dev/null
  done
  service stunnel4 stop > /dev/null 2>&1
  systemctl disable stunnel4 > /dev/null 2>&1
  [[ -x /etc/autostart ]] && /etc/autostart > /dev/null 2>&1

  touch /tmp/.sshplus_force_ok
  return 0
}

# Repair the Squid ACL on existing installs. The original config was:
#
#     acl url1 dstdomain -i 127.0.0.1
#     acl url2 dstdomain -i localhost
#     acl url3 dstdomain -i $ipdovps
#     acl url4 dstdomain -i /SSHPLUS?
#     acl payload url_regex -i "$var_pay"
#     acl all src 0.0.0.0/0
#     http_access allow url1
#     http_access allow url2
#     http_access allow url3
#     http_access allow url4
#     http_access allow payload
#     http_access deny all
#
# Any client-issued CONNECT (or GET) whose host wasn't 127.0.0.1,
# localhost, the server IP, "/SSHPLUS?", or one of the four payload
# domains hit `http_access deny all` and got refused. That's exactly
# the user-visible behaviour "the same connection works when I point
# the injector at the IP but fails when I point it at the domain":
# the IP path matches `url3`, the bug-host path matches nothing.
#
# Replace those lines with an ACL that allows CONNECT to any host on
# a safe TCP port (443/8443/80/...), keeps plain-HTTP restricted to
# the bug-host list to avoid open-relay abuse, and refreshes the
# payload list with the well-known carrier-zero-rated hosts so they
# work out of the box. Idempotent: re-running adds nothing if the
# config already has the new SSL_ports/CONNECT block.
fun_fix_squid_acl () {
  local _conf _pay _bak
  for _candidate in /etc/squid/squid.conf /etc/squid3/squid.conf; do
    if [[ -f "$_candidate" ]]; then
      _conf="$_candidate"
      _pay="${_candidate%/squid.conf}/payload.txt"
      break
    fi
  done
  [[ -z "$_conf" ]] && return 0

  # The freshness check matches a comment unique to the new config so
  # we can short-circuit when there is nothing to do.
  if grep -q '^acl SSL_ports port' "$_conf" 2>/dev/null \
     && grep -q 'http_access allow CONNECT Safe_ports' "$_conf" 2>/dev/null; then
    return 0
  fi

  _bak="${_conf}.pre-sshplus-bughost.bak"
  [[ -f "$_bak" ]] || cp -a "$_conf" "$_bak"

  local _ipdovps _portas
  _ipdovps=$(cat /etc/IP 2>/dev/null | tr -d '[:space:]')
  [[ -z "$_ipdovps" ]] && _ipdovps=$(curl -s -m 5 https://api.ipify.org 2>/dev/null)
  [[ -z "$_ipdovps" ]] && _ipdovps=$(hostname -I 2>/dev/null | awk '{print $1}')

  # Preserve any http_port lines the user added through the menu.
  _portas=$(awk '/^[[:space:]]*http_port[[:space:]]/ {print}' "$_conf")
  [[ -z "$_portas" ]] && _portas="http_port 3128"

  cat > "$_pay" <<-PAYLOAD_EOF
	# Bug-host allow list for plain-HTTP requests through Squid.
	# CONNECT (HTTPS) to any destination is already allowed
	# unconditionally on the SSL_ports below — these entries
	# only matter for non-encrypted GET/POST/HEAD payloads
	# that mobile injectors send to zero-rated domains.
	#
	# Add one host or .domain per line. Lines starting with
	# "#" are ignored. Wildcard form ".example.com" matches
	# example.com and every subdomain.
	.whatsapp.net
	.whatsapp.com
	.facebook.net
	.facebook.com
	.twitter.com
	.speedtest.net
	# Common payment / banking gateways used as bug hosts
	.islamicbank.ps
	.gateway.mastercard.com
	.gbp.ma
	# Captcha CDN endpoints commonly used as bug hosts
	.hcaptcha.com
	.recaptcha.net
	PAYLOAD_EOF

  cat > "$_conf" <<-CONF_EOF
	# Allow CONNECT (HTTPS) to any destination — the request body
	# is encrypted so Squid cannot be abused to inject content,
	# and this is what makes bug-host SNIs (paysecure.islamicbank.ps,
	# *.gateway.mastercard.com, hcaptcha endpoints, ...) work.
	# Plain HTTP (GET/POST/HEAD) is still restricted to the
	# server itself and to the bug-host list in $_pay so
	# the proxy cannot be used as an open HTTP relay.
	acl SSL_ports port 443 8443
	acl Safe_ports port 80 443 1025-65535
	acl CONNECT method CONNECT

	acl url1 dstdomain -i 127.0.0.1
	acl url2 dstdomain -i localhost
	acl url3 dstdomain -i $_ipdovps
	acl url4 dstdomain -i /SSHPLUS?
	acl payload url_regex -i "$_pay"
	acl all src 0.0.0.0/0

	# Hard safety: never CONNECT to a port outside Safe_ports
	# (blocks abuse like CONNECT 25 for spam relays) but allow
	# any CONNECT destination on a safe port, especially 443.
	http_access deny CONNECT !Safe_ports
	http_access allow CONNECT Safe_ports

	http_access allow url1
	http_access allow url2
	http_access allow url3
	http_access allow url4
	http_access allow payload
	http_access deny all

	#Portas
	$_portas
	#Nome squid
	visible_hostname SSHPLUS
	via off
	forwarded_for off
	pipeline_prefetch off
	CONF_EOF

  # Apply the new config; restart whichever flavour of Squid is here.
  if [[ "$_conf" == /etc/squid/squid.conf ]]; then
    /etc/init.d/squid restart >/dev/null 2>&1
    service squid restart >/dev/null 2>&1
  else
    /etc/init.d/squid3 restart >/dev/null 2>&1
    service squid3 restart >/dev/null 2>&1
  fi
}

# Migrate a legacy static-cert stunnel install to the dynamic-SNI
# sniproxy listener, in place. Idempotent: safe to call when sniproxy
# is already the listener — it just re-bootstraps the CA.
#
# This finally retires the cycle of "regenerate the cert, restart
# stunnel, hope the SAN happens to cover whatever hostname the client
# typed". With sniproxy the cert is generated per ClientHello to match
# whatever SNI showed up, so the user's own domain *and* every
# bug-host SNI used to bypass carrier billing all just work.
fun_migrate_to_sniproxy () {
  [[ ! -d /etc/stunnel ]] && mkdir -p /etc/stunnel 2>/dev/null
  command -v python3 >/dev/null 2>&1 || apt-get install python3 -y >/dev/null 2>&1
  command -v openssl >/dev/null 2>&1 || apt-get install openssl -y >/dev/null 2>&1
  [[ -f /etc/SSHPlus/sniproxy.py ]] || return 0

  python3 - <<'PY' >/dev/null 2>&1
import sys
sys.path.insert(0, '/etc/SSHPlus')
import sniproxy
sniproxy.ensure_ca()
sniproxy.ensure_default_leaf()
PY

  # Re-spawn sniproxy + sslmux pairs for every accept port we know
  # about. Sources:
  #   1. Legacy stunnel.conf [section] blocks (one per accept port).
  #   2. Existing sniproxy_PORT screen sessions (already migrated).
  # We rebuild from (1) because the matching wsproxy mux ports there
  # are guaranteed to be paired with a backend SSH/Dropbear port. For
  # (2) we leave the screen alone — the entry is already in autostart.
  if [[ -f /etc/stunnel/stunnel.conf ]]; then
    local _accept _connect _mux _backend _wsline
    while read -r _accept _connect; do
      [[ -z "$_accept" || -z "$_connect" ]] && continue
      _mux=${_connect##*:}
      # Look up which backend the existing wsproxy multiplexer was
      # forwarding to by reading its full command line. Falls back to
      # SSH:22 if the multiplexer process is gone.
      _wsline=$(ps -eo args 2>/dev/null \
        | awk -v m="$_mux" '/wsproxy\.py/ && $0 ~ ("wsproxy\\.py[[:space:]]+"m"[[:space:]]") {print; exit}')
      _backend=$(echo "$_wsline" | awk '{
        for (i=1;i<=NF;i++) if ($i ~ /wsproxy\.py$/) { print $(i+2); exit }
      }')
      [[ -z "$_backend" ]] && _backend=22
      # Stop any wsproxy currently bound to $_mux so the fresh one we
      # launch below can take over the port. Old installs named the
      # initial 443 multiplexer just `sslmux` (no port suffix) while
      # later additions use `sslmux_<port>`; kill both shapes plus any
      # bare process whose command line points at this mux port.
      for s in $(screen -ls 2>/dev/null | awk -v p="$_mux" '
        /\.sslmux/{
          name=$1; sub(/^[0-9]+\./, "", name); print name
        }'); do
        screen -S "$s" -X quit 2>/dev/null
      done
      screen -S sniproxy_${_accept} -X quit 2>/dev/null
      pkill -f "wsproxy\\.py[[:space:]]+${_mux}[[:space:]]" 2>/dev/null
      sleep 1
      screen -dmS sslmux_${_accept} python3 /etc/SSHPlus/wsproxy.py $_mux $_backend 127.0.0.1
      screen -dmS sniproxy_${_accept} python3 /etc/SSHPlus/sniproxy.py $_accept $_mux
      # Replace matching autostart lines so the new entries are canonical
      # (otherwise duplicates accumulate across update runs and a
      # legacy `sslmux` line would respawn the stale multiplexer every
      # minute).
      sed -i "/sslmux python3 \\/etc\\/SSHPlus\\/wsproxy\\.py ${_mux} /d" /etc/autostart 2>/dev/null
      sed -i "/sslmux_${_accept} python3/d" /etc/autostart 2>/dev/null
      sed -i "/sniproxy.py ${_accept} /d" /etc/autostart 2>/dev/null
      echo "ss -tlnH 2>/dev/null | awk '{print \$4}' | grep -qE '(^|:)${_mux}\$' || screen -dmS sslmux_${_accept} python3 /etc/SSHPlus/wsproxy.py $_mux $_backend 127.0.0.1" >>/etc/autostart
      echo "ss -tlnH 2>/dev/null | awk '{print \$4}' | grep -qE '(^|:)${_accept}\$' || screen -dmS sniproxy_${_accept} python3 /etc/SSHPlus/sniproxy.py $_accept $_mux" >>/etc/autostart
    done < <(awk '
      /^\[/ { acc=""; conn="" }
      $1=="accept"  && $2=="=" { acc=$3 }
      $1=="connect" && $2=="=" { conn=$3 }
      acc != "" && conn != "" { print acc, conn; acc=""; conn="" }
    ' /etc/stunnel/stunnel.conf)
  fi

  # Take stunnel down for good — sniproxy now owns those ports.
  service stunnel4 stop >/dev/null 2>&1
  systemctl disable stunnel4 >/dev/null 2>&1
  if [[ -f /etc/default/stunnel4 ]]; then
    sed -i 's/^[# ]*ENABLED=.*/ENABLED=0/' /etc/default/stunnel4
  fi
}

