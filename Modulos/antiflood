#!/bin/bash
# SSHPlus panel screen: ANTI-FLOOD / DDoS guard status and control.
# Surfaces the SSHPLUS_ANTIFLOOD iptables chain (built by /etc/Plus-antiflood)
# and the egress flood monitor (/etc/Plus-floodmon): shows live drop counters,
# who the monitor last caught, and lets the operator repair the guard, flip the
# monitor between log-only and auto-kill, and review/reset.
CHAIN=SSHPLUS_ANTIFLOOD
LOG=/var/log/sshplus-flood.log
CONF=/etc/SSHPlus/floodmon.conf

_hooked() { iptables -C "$1" -j "$CHAIN" 2>/dev/null; }

_count() { # sum packet counts of flood rules matching $1 in the chain
	iptables -nvxL "$CHAIN" 2>/dev/null | awk -v k="$1" '$0 ~ k {s+=$1} END{printf "%d", s+0}'
}

antiflood_screen() {
clear
echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e "\E[41;1;37m            ⇱ ANTI-FLOOD / DDoS GUARD ⇲           \E[0m"
echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"

if iptables -nL "$CHAIN" >/dev/null 2>&1 && _hooked OUTPUT && _hooked FORWARD; then
	sts=$(echo -e "\033[1;32m◉ ACTIVE\033[0m")
else
	sts=$(echo -e "\033[1;31m○ NOT ACTIVE\033[0m")
fi
if grep -q "/etc/Plus-floodmon" /etc/autostart 2>/dev/null; then
	mon=$(echo -e "\033[1;32m◉ ON\033[0m")
else
	mon=$(echo -e "\033[1;31m○ OFF\033[0m")
fi
act=log; [[ -r $CONF ]] && act=$(sed -n 's/^ACTION=//p' "$CONF" 2>/dev/null); act=${act:-log}
if [[ "$act" = kill ]]; then
	actd=$(echo -e "\033[1;31mKILL abuser session\033[0m")
else
	actd=$(echo -e "\033[1;33mLOG only\033[0m")
fi

echo -e "\033[1;37m Firewall guard : $sts"
echo -e "\033[1;37m Flood monitor  : $mon   \033[1;37mResponse: $actd"
echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e "\033[1;32m Dropped since last reset (packets):\033[0m"
printf "\033[1;37m   TCP SYN flood : \033[1;36m%s\033[0m\n" "$(_count synflood)"
printf "\033[1;37m   UDP flood     : \033[1;36m%s\033[0m\n" "$(_count udpflood)"
printf "\033[1;37m   ICMP flood    : \033[1;36m%s\033[0m\n" "$(_count icmpflood)"
printf "\033[1;37m   DNS flood     : \033[1;36m%s\033[0m\n" "$(_count dnsflood)"
echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e "\033[1;32m Last flood alerts:\033[0m"
if [[ -s "$LOG" ]]; then
	tail -n 5 "$LOG" 2>/dev/null | sed 's/^/   /;s/^/\o033[1;37m/;s/$/\o033[0m/'
else
	echo -e "\033[1;33m   (none — no egress flood detected)\033[0m"
fi
echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo ""
echo -e "\033[1;31m[\033[1;36m1\033[1;31m] \033[1;33mReapply / repair guard now"
echo -e "\033[1;31m[\033[1;36m2\033[1;31m] \033[1;33mToggle monitor response (LOG <-> KILL)"
echo -e "\033[1;31m[\033[1;36m3\033[1;31m] \033[1;33mView full flood log"
echo -e "\033[1;31m[\033[1;36m4\033[1;31m] \033[1;33mReset drop counters"
echo -e "\033[1;31m[\033[1;36m0\033[1;31m] \033[1;33mBack\033[0m"
echo ""
echo -ne "\033[1;32mOPTION \033[1;33m?\033[1;37m : "; read op

case "$op" in
	1)
		echo ""
		if [[ -x /etc/Plus-antiflood ]]; then
			bash /etc/Plus-antiflood >/dev/null 2>&1
			echo -e "\033[1;32mFirewall guard reapplied.\033[0m"
		else
			echo -e "\033[1;31m/etc/Plus-antiflood missing — run UPDATE SCRIPT (force pull latest fixes).\033[0m"
		fi
		[[ -x /etc/Plus-floodmon ]] && bash /etc/Plus-floodmon >/dev/null 2>&1
		sleep 2; antiflood_screen ;;
	2)
		mkdir -p /etc/SSHPlus 2>/dev/null
		if [[ "$act" = kill ]]; then
			sed -i '/^ACTION=/d' "$CONF" 2>/dev/null; echo "ACTION=log" >> "$CONF"
			echo -e "\n\033[1;33mMonitor set to LOG only.\033[0m"
		else
			sed -i '/^ACTION=/d' "$CONF" 2>/dev/null; echo "ACTION=kill" >> "$CONF"
			echo -e "\n\033[1;31mMonitor set to KILL: it will terminate the individual abusing"
			echo -e "tunnel session (non-root sshd/dropbear child) after 2 strikes.\033[0m"
			echo -e "\033[1;33mMaster daemons and shared services are never killed.\033[0m"
		fi
		sleep 3; antiflood_screen ;;
	3)
		clear
		echo -e "\E[44;1;37m               FLOOD LOG (all)                 \E[0m"; echo ""
		if [[ -s "$LOG" ]]; then
			tail -n 200 "$LOG" 2>/dev/null
		else
			echo -e "\033[1;33m(empty — no egress flood has been detected)\033[0m"
		fi
		echo -ne "\n\033[1;31mENTER \033[1;33mto return\033[0m"; read
		antiflood_screen ;;
	4)
		iptables -Z "$CHAIN" 2>/dev/null
		rm -f /etc/SSHPlus/.floodmon.state 2>/dev/null
		echo -e "\n\033[1;32mDrop counters reset.\033[0m"; sleep 2; antiflood_screen ;;
	0|00)
		return 0 ;;
	*)
		echo -e "\n\033[1;31mInvalid option !\033[0m"; sleep 1; antiflood_screen ;;
esac
}

antiflood_screen
