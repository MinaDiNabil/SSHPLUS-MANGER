			echo -e "\n\033[1;32mCONFIGURING SSL TUNNEL !\033[0m"
			echo ""
			ssl_conf() {
				# Spawn the local-only payload multiplexer that lets port ${porta}
				# accept SSL/TLS (SNI), WS SSL and WS Proxy on the same listener.
				command -v python3 >/dev/null 2>&1 || apt-get install python3 -y >/dev/null 2>&1
				# Pick a free local backend port. porta+10000 may overflow above
				# 65535 for high accept ports (e.g. 60000); fall back to a low
				# unprivileged offset and bump until something is free.
				sslmux_port=$((porta + 10000))
				if (( sslmux_port > 65535 )); then sslmux_port=$((10000 + (porta % 5000))); fi
				while ss -tlnH 2>/dev/null | awk '{print $4}' | grep -qE "(^|:)${sslmux_port}\$"; do
					sslmux_port=$((sslmux_port + 1))
					(( sslmux_port > 65535 )) && sslmux_port=10000
				done
				screen -dmS sslmux_${porta} python3 /etc/SSHPlus/wsproxy.py $sslmux_port $portssl 127.0.0.1
				echo -e "ss -tlnH 2>/dev/null | awk '{print \$4}' | grep -qE '(^|:)${sslmux_port}\$' || screen -dmS sslmux_${porta} python3 /etc/SSHPlus/wsproxy.py $sslmux_port $portssl 127.0.0.1" >>/etc/autostart
				cat > /etc/stunnel/stunnel.conf <<-EOF
cert = /etc/stunnel/cert.pem
key = /etc/stunnel/key.pem
client = no
socket = a:SO_REUSEADDR=1
socket = l:TCP_NODELAY=1
socket = r:TCP_NODELAY=1

[stunnel]
connect = 127.0.0.1:${sslmux_port}
accept = ${porta}
EOF
				chmod 644 /etc/stunnel/stunnel.conf
			}
			fun_bar 'ssl_conf'
			echo -e "\n\033[1;32mSTARTING SSL TUNNEL !\033[0m"
			echo ""
			fun_finssl() {
				service stunnel4 stop
				sleep 1
				service stunnel4 start
				sleep 1
				service stunnel4 restart
				/etc/init.d/stunnel4 restart
			}
		fun_bar 'fun_finssl'
		clear
		echo -e "\033[1;32m✓ SSL TUNNEL configured successfully\!\033[0m"
