	inst_ssl() {
		if netstat -nltp | grep 'stunnel4' 1>/dev/null 2>/dev/null; then
			[[ $(netstat -nltp | grep 'stunnel4' | wc -l) != '0' ]] && sslt=$(netstat -nplt | grep stunnel4 | awk {'print $4'} | awk -F ":" {'print $2'} | xargs) || sslt="\033[1;31mUNAVAILABLE"
			echo -e "\E[44;1;37m              MANAGE SSL TUNNEL               \E[0m"
			echo -e "\n\033[1;33mPORTS\033[1;37m: \033[1;32m$sslt"
			echo ""
			cur_dom=$( [[ -s /etc/stunnel/.domain ]] && head -n1 /etc/stunnel/.domain || echo "(auto)" )
			echo -e "\033[1;33mDOMAIN\033[1;37m: \033[1;32m$cur_dom"
			echo ""
			echo -e "\033[1;31m[\033[1;36m1\033[1;31m] \033[1;37m• \033[1;33mADD PORT\033[0m"
			echo -e "\033[1;31m[\033[1;36m2\033[1;31m] \033[1;37m• \033[1;33mREMOVE PORT\033[0m"
			echo -e "\033[1;31m[\033[1;36m3\033[1;31m] \033[1;37m• \033[1;33mREMOVE SSL TUNNEL\033[0m"
			echo -e "\033[1;31m[\033[1;36m4\033[1;31m] \033[1;37m• \033[1;33mCHANGE SSL DOMAIN\033[0m"
			echo -e "\033[1;31m[\033[1;36m0\033[1;31m] \033[1;37m• \033[1;33mBACK\033[0m"
			echo ""
			echo -ne "\033[1;32mWHAT DO YOU WANT TO DO \033[1;33m?\033[1;37m "
			read resposta
			echo ""
			[[ "$resposta" = '1' ]] && {
				clear
				echo -e "\E[44;1;37m         ADD PORT TO SSL TUNNEL         \E[0m\n"
				echo -ne "\033[1;32mWHICH PORT DO YOU WANT TO ADD \033[1;33m?\033[1;37m "
				read porta
				[[ -z "$porta" ]] && {
					echo -e "\n\033[1;31mInvalid port!"
					sleep 2
					inst_ssl
				}
				verif_ptrs $porta

				# Open firewall port if ufw is installed
				[[ -f "/usr/sbin/ufw" ]] && ufw allow ${porta}/tcp >/dev/null 2>&1

				# Get active SSH and Dropbear ports
				ssh_ports=$(grep 'Port' /etc/ssh/sshd_config 2>/dev/null | cut -d' ' -f2 | grep -v 'no' | xargs)
				dropbear_main=$(grep 'DROPBEAR_PORT=' /etc/default/dropbear 2>/dev/null | cut -d'=' -f2)
				dropbear_extra=$(grep 'DROPBEAR_EXTRA_ARGS=' /etc/default/dropbear 2>/dev/null | grep -oP '\-p \K[0-9]+' | xargs)
				all_ssh_ports="$ssh_ports $dropbear_main $dropbear_extra"

				echo -e "\n\033[1;33mACTIVE SSH/DROPBEAR PORTS:\033[0m"
				[[ -n "$ssh_ports" ]] && echo -e "  \033[1;32mOpenSSH:\033[1;37m $ssh_ports"
				[[ -n "$dropbear_main" ]] && echo -e "  \033[1;32mDropbear:\033[1;37m $dropbear_main $dropbear_extra"
				[[ -n "$all_ssh_ports" ]] || echo -e "  \033[1;31mNenhuma porta SSH ativa encontrada!"
				echo ""
				echo -ne "\033[1;32mEnter an active SSH/DROPBEAR port\033[1;33m:\033[1;37m "
				read portssl

				[[ -z "$portssl" ]] && {
					echo -e "\n\033[1;31mInvalid port!"
					sleep 2
					inst_ssl
				}
				echo -e "\n\033[1;32mADDING PORT TO SSL TUNNEL\033[0m"
				echo ""
				fun_addssl() {
					# Use the accept port to derive a unique [section] name so
					# add → remove → add cycles can never produce a duplicate
					# section (a counter would: removing stunnel1 from a config
					# that has stunnel/stunnel1/stunnel2 leaves count=2, and
					# the next add would collide with the existing stunnel2 and
					# stop stunnel4 from starting).
					service_name="stunnel_${porta}"
					# Spawn a payload multiplexer for this accept port so the SSL
					# tunnel transparently accepts SSL/TLS (SNI), WS SSL and WS Proxy.
					# Guard against porta+10000 > 65535 and against the chosen
					# local backend port being already taken.
					sslmux_port=$((porta + 10000))
					if (( sslmux_port > 65535 )); then sslmux_port=$((10000 + (porta % 5000))); fi
					while ss -tlnH 2>/dev/null | awk '{print $4}' | grep -qE "(^|:)${sslmux_port}\$"; do
						sslmux_port=$((sslmux_port + 1))
						(( sslmux_port > 65535 )) && sslmux_port=10000
					done
					screen -dmS sslmux_${porta} python3 /etc/SSHPlus/wsproxy.py $sslmux_port $portssl 127.0.0.1
					echo -e "ss -tlnH 2>/dev/null | awk '{print \$4}' | grep -qE '(^|:)${sslmux_port}\$' || screen -dmS sslmux_${porta} python3 /etc/SSHPlus/wsproxy.py $sslmux_port $portssl 127.0.0.1" >>/etc/autostart
					# Add new service section pointing to the mux (not directly to SSH)
					echo -e "\n[$service_name]\nconnect = 127.0.0.1:$sslmux_port\naccept = ${porta}" >> /etc/stunnel/stunnel.conf
					service stunnel4 restart
					/etc/init.d/stunnel4 restart
				}
				fun_bar 'fun_addssl'
				echo -e "\n\033[1;32mPORT ADDED SUCCESSFULLY\033[0m"
				sleep 3
				inst_ssl
			}
			[[ "$resposta" = '2' ]] && {
				clear
				echo -e "\E[41;1;37m         REMOVE PORT FROM SSL TUNNEL         \E[0m"
				echo -e "\n\033[1;33mPORTS IN USE: \033[1;37m$(netstat -nplt | grep stunnel4 | awk {'print $4'} | awk -F ":" {'print $2'} | xargs)\n"
				echo -ne "\033[1;32mWHICH PORT DO YOU WANT TO REMOVE \033[1;33m?\033[1;37m "
				read porta
				[[ -z "$porta" ]] && {
					echo -e "\n\033[1;31mInvalid port!"
					sleep 2
					inst_ssl
				}
				echo -e "\n\033[1;32mREMOVING PORT FROM SSL TUNNEL\033[0m"
				echo ""
				fun_delssl() {
					# Find the section that owns this accept port. Match the
					# accept line exactly: `grep "accept = $porta"` would also
					# pick up `accept = ${porta}0` (e.g. removing 8 would hit
					# 8443) and `grep -B 2` could capture the wrong [section]
					# header for sections longer than two lines.
					service_name=$(awk -v p="$porta" '
						/^\[/ { name=$0; sub(/^\[/, "", name); sub(/\].*/, "", name) }
						$1=="accept" && $2=="=" && $3==p { print name; exit }
					' /etc/stunnel/stunnel.conf)
					if [[ -n "$service_name" ]]; then
						# Remove the whole section up to the next blank line.
						sed -i "/^\[$service_name\]/,/^$/d" /etc/stunnel/stunnel.conf
						# Stop the payload multiplexer paired with this accept port
						screen -S sslmux_${porta} -X quit 2>/dev/null
						sed -i "/sslmux_${porta} python3/d" /etc/autostart 2>/dev/null
						service stunnel4 restart
						/etc/init.d/stunnel4 restart
					else
						echo -e "\033[1;31mPort not found!\033[0m"
						return 1
					fi
				}
				fun_bar 'fun_delssl'
				echo -e "\n\033[1;32mPORT REMOVED SUCCESSFULLY\033[0m"
				sleep 2
				inst_ssl
			}
			[[ "$resposta" = '4' ]] && {
				clear
				echo -e "\E[44;1;37m         CHANGE SSL DOMAIN          \E[0m\n"
				echo -e "\033[1;33mCurrent domain:\033[1;32m $cur_dom\033[0m"
				echo ""
				echo -e "\033[1;33mEnter your domain (leave empty to clear and use server hostname).\033[0m"
				echo -e "\033[1;33mIt will be added to the SSL certificate so SSL/TLS (SNI)\033[0m"
				echo -e "\033[1;33mworks when clients connect via the domain.\033[0m"
				echo ""
				echo -ne "\033[1;32mNew domain \033[1;33m:\033[1;37m "
				read new_dom
				new_dom=$(echo "$new_dom" | tr -d '[:space:]' | tr 'A-Z' 'a-z')
				if [[ -z "$new_dom" ]]; then
					rm -f /etc/stunnel/.domain
				else
					if [[ ! "$new_dom" =~ ^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$ ]] || [[ "$new_dom" != *.* ]]; then
						echo -e "\n\033[1;31mInvalid domain!\033[0m"
						sleep 2
						inst_ssl
					fi
					echo "$new_dom" > /etc/stunnel/.domain
				fi
				echo ""
				echo -e "\033[1;32mREGENERATING CERTIFICATE !\033[0m"
				echo ""
				fun_bar 'ssl_certif'
				service stunnel4 restart >/dev/null 2>&1
				/etc/init.d/stunnel4 restart >/dev/null 2>&1
				echo -e "\n\033[1;32m✓ Certificate updated\033[0m"
				sleep 3
				inst_ssl
			}
			[[ "$resposta" = '3' ]] && {
				echo -e "\033[1;32mREMOVING SSL TUNNEL !\033[0m"
				del_ssl() {
					service stunnel4 stop
					# Stop every SSL TUNNEL payload multiplexer
					for s in $(screen -ls 2>/dev/null | grep '\.sslmux_' | awk '{print $1}'); do
						screen -S "$s" -X quit 2>/dev/null
					done
					sed -i '/sslmux_.* python3/d' /etc/autostart 2>/dev/null
					apt-get remove stunnel4 -y
					apt-get autoremove stunnel4 -y
					apt-get purge stunnel4 -y
					rm -rf /etc/stunnel/stunnel.conf
					rm -rf /etc/default/stunnel4
					rm -rf /etc/stunnel/cert.cert
					rm -rf /etc/stunnel/key.key
					rm -f /etc/stunnel/cert.pem /etc/stunnel/key.pem /etc/stunnel/.domain
				}
				echo ""
				fun_bar 'del_ssl'
				echo ""
				echo -e "\033[1;32mSSL TUNNEL REMOVIDO COM SUCESSO!\033[0m"
				sleep 3
				fun_conexao
			}
		else
			clear
			echo -e "\E[44;1;37m              INSTALL SSL TUNNEL               \E[0m"
			echo ""
			# Get active SSH and Dropbear ports
			ssh_ports=$(grep 'Port' /etc/ssh/sshd_config 2>/dev/null | cut -d' ' -f2 | grep -v 'no' | xargs)
			dropbear_main=$(grep 'DROPBEAR_PORT=' /etc/default/dropbear 2>/dev/null | cut -d'=' -f2)
			dropbear_extra=$(grep 'DROPBEAR_EXTRA_ARGS=' /etc/default/dropbear 2>/dev/null | grep -oP '\-p \K[0-9]+' | xargs)
			all_ssh_ports="$ssh_ports $dropbear_main $dropbear_extra"

			echo -e "\033[1;33mACTIVE SSH/DROPBEAR PORTS:\033[0m"
			[[ -n "$ssh_ports" ]] && echo -e "  \033[1;32mOpenSSH:\033[1;37m $ssh_ports"
			[[ -n "$dropbear_main" ]] && echo -e "  \033[1;32mDropbear:\033[1;37m $dropbear_main $dropbear_extra"
			echo ""
			echo -e "\033[1;33mINFORMATION:\033[0m"
			echo -e "  SSL TUNNEL will encapsulate the SSH/DROPBEAR connection"
			echo -e "  You need to choose an active SSH port to connect"
			echo ""
			echo -ne "\033[1;32mEnter an active SSH/DROPBEAR port\033[1;33m:\033[1;37m "
			read portssl

			# Validate port
			[[ -z "$portssl" ]] && {
				echo -e "\n\033[1;31mInvalid port!"
				sleep 2
				inst_ssl
			}

			# Check if port is in the active list
			port_found=0
			for p in $all_ssh_ports; do
				[[ "$p" = "$portssl" ]] && port_found=1
			done

			if [[ $port_found -eq 0 ]]; then
				echo -e "\n\033[1;33m[\033[1;31m!\033[1;33m] WARNING: Port $portssl is not in the list of active ports"
				echo -ne "\033[1;32mDo you want to continue anyway \033[1;31m? \033[1;33m[y/n]:\033[1;37m "
				read confirma
				[[ "$confirma" != "y" ]] && inst_ssl
			fi
			clear
			echo -e "\E[44;1;37m           SSL TUNNEL INSTALLER             \E[0m"
			echo -e "\n\033[1;33mYOU ARE ABOUT TO INSTALL SSL TUNNEL !\033[0m"
			echo ""
			echo -e "\n\033[1;33mDEFINE A PORT FOR SSL TUNNEL !\033[0m"
			echo ""
			read -p "$(echo -e "\033[1;32mWHICH PORT DO YOU WANT TO USE? \033[1;37m")" -e -i 443 porta
		[[ -z "$porta" ]] && {
				echo ""
				echo -e "\033[1;31mInvalid port!"
				sleep 3
				clear
				fun_conexao
			}
			verif_ptrs $porta
			echo -e "\n\033[1;32mINSTALLING SSL TUNNEL !\033[1;33m"
			echo ""
			# Open firewall port if ufw is installed
			[[ -f "/usr/sbin/ufw" ]] && ufw allow ${porta}/tcp >/dev/null 2>&1
			fun_bar 'apt-get update -y' 'apt-get install stunnel4 -y'
			echo -e "\n\033[1;32mCREATING CERTIFICATES !\033[0m"
			echo ""
			ssl_certif() {
				cd /etc/stunnel/
				command -v openssl >/dev/null 2>&1 || apt-get install openssl -y >/dev/null 2>&1
				# Auto-detect public IP and FQDN; fall back to local identifiers
				# so the SAN block always has at least one usable entry.
				cert_ip=$(curl -s -m 5 https://api.ipify.org 2>/dev/null || curl -s -m 5 https://ifconfig.me 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}')
				[[ -z "$cert_ip" ]] && cert_ip="127.0.0.1"
				cert_host=$(hostname -f 2>/dev/null || hostname)
				[[ -z "$cert_host" || "$cert_host" == "localhost" || "$cert_host" == "(none)" ]] && cert_host="sshplus.local"
				# Optional user-supplied domain (saved by the CHANGE SSL DOMAIN menu)
				cert_dom=""
				[[ -s /etc/stunnel/.domain ]] && cert_dom=$(head -n1 /etc/stunnel/.domain | tr -d '[:space:]')
				cert_cn="${cert_dom:-$cert_host}"
				{
					echo '[req]'
					echo 'default_bits = 2048'
					echo 'prompt = no'
					echo 'default_md = sha256'
					echo 'distinguished_name = dn'
					echo 'x509_extensions = v3_ext'
					echo ''
					echo '[dn]'
					echo "CN = $cert_cn"
					echo ''
					echo '[v3_ext]'
