#!/bin/bash
#====================================================
#	@MinaProNet - SSHPLUS Manager v2.0
#====================================================
cor1='\033[41;1;37m'
cor2='\033[44;1;37m'
scor='\033[0m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
SCOLOR='\033[0m'

[[ $(awk -F" " '{print $2}' /usr/lib/licence) == "@KIRITO_SSH" ]] && {
	ram1=$(free -h | grep -i mem | awk {'print $2'})
	ram2=$(free -h | grep -i mem | awk {'print $4'})
	ram3=$(free -h | grep -i mem | awk {'print $3'})
	uso=$(top -bn1 | awk '/Cpu/ { cpu = "" 100 - $8 "%" }; END { print cpu }')
	system=$(cat /etc/issue.net)

	fun_bar() {
		comando[0]="$1"
		comando[1]="$2"
		(
			[[ -e $HOME/fim ]] && rm $HOME/fim
			[[ ! -d /etc/SSHPlus ]] && rm -rf /bin/menu
			${comando[0]} >/dev/null 2>&1
			${comando[1]} >/dev/null 2>&1
			touch $HOME/fim
		) >/dev/null 2>&1 &
		tput civis
		echo -ne "\033[1;33mWAIT \033[1;37m- \033[1;33m["
		while true; do
			for ((i = 0; i < 18; i++)); do
				echo -ne "\033[1;31m#"
				sleep 0.1s
			done
			[[ -e $HOME/fim ]] && rm $HOME/fim && break
			echo -e "\033[1;33m]"
			sleep 1s
			tput cuu1
			tput dl1
			echo -ne "\033[1;33mWAIT \033[1;37m- \033[1;33m["
		done
		echo -e "\033[1;33m]\033[1;37m -\033[1;32m OK !\033[1;37m"
		tput cnorm
	}

	verif_ptrs() {
		porta=$1
		PT=$(lsof -V -i tcp -P -n | grep -v "ESTABLISHED" | grep -v "COMMAND" | grep "LISTEN")
		for pton in $(echo -e "$PT" | cut -d: -f2 | cut -d' ' -f1 | uniq); do
			svcs=$(echo -e "$PT" | grep -w "$pton" | awk '{print $1}' | uniq)
			[[ "$porta" = "$pton" ]] && {
				echo -e "\n\033[1;31mPORT \033[1;33m$porta \033[1;31mIN USE BY \033[1;37m$svcs\033[0m"
				sleep 3
				fun_conexao
			}
		done
	}

	# Protocol installers integration
	install_wireguard() {
		bash /root/SSHPLUS-MANGER/Install/wireguard-install.sh
	}

	install_shadowsocks() {
		bash /root/SSHPLUS-MANGER/Install/shadowsocks-install.sh
	}

	install_hysteria1() {
		bash /root/SSHPLUS-MANGER/Install/hysteria1-install.sh
	}

	install_hysteria2() {
		bash /root/SSHPLUS-MANGER/Install/hysteria2-install.sh
	}

	install_websocket() {
		bash /root/SSHPLUS-MANGER/Install/websocket-install.sh
	}

	install_psiphon() {
		bash /root/SSHPLUS-MANGER/Install/psiphon-install.sh
	}

	slow_setup() {
		bash /root/SSHPLUS-MANGER/Install/slowdns-install.sh
	}

	inst_sqd() {
		if netstat -nltp | grep 'squid' 1>/dev/null 2>/dev/null; then
			echo -e "\E[41;1;37m            REMOVE SQUID PROXY              \E[0m"
			echo ""
			echo -ne "\033[1;32mDO YOU REALLY WANT TO REMOVE SQUID \033[1;31m? \033[1;33m[y/n]:\033[1;37m "
			read resp
			[[ "$resp" = 'y' ]] && {
				echo -e "\n\033[1;32mREMOVING SQUID PROXY!\033[0m"
				echo ""
				rem_sqd() {
					[[ -d "/etc/squid" ]] && {
						apt-get remove squid -y >/dev/null 2>&1
						apt-get purge squid -y >/dev/null 2>&1
						rm -rf /etc/squid >/dev/null 2>&1
					}
					[[ -d "/etc/squid3" ]] && {
						apt-get remove squid3 -y >/dev/null 2>&1
						apt-get purge squid3 -y >/dev/null 2>&1
						rm -rf /etc/squid3 >/dev/null 2>&1
						apt autoremove -y >/dev/null 2>&1
					}
				}
				fun_bar 'rem_sqd'
				echo -e "\n\033[1;32mSQUID REMOVED SUCCESSFULLY!\033[0m"
				sleep 2
				clear
				fun_conexao
			} || {
				echo -e "\n\033[1;31mReturning...\033[0m"
				sleep 2
				clear
				fun_conexao
			}
		else
			echo -e "\E[41;1;37m            SQUID PROXY INSTALLER              \E[0m"
			echo ""
			echo -ne "\033[1;32mDEFINE SQUID PORT \033[1;31m> \033[1;37m"
			read porta
			[[ -z "$porta" ]] && {
				echo ""
				echo -e "\033[1;31mINVALID PORT!\033[0m"
				sleep 2
				clear
				fun_conexao
			}
			verif_ptrs $porta
			echo ""
			inst_pct() {
				apt-get install squid3 -y >/dev/null 2>&1
				apt-get install apache2 -y >/dev/null 2>&1
				wget -qO- https://raw.githubusercontent.com/MinaDiNabil/SSHPLUS-MANGER/main/Install/squid3 >/etc/squid/squid.conf
				echo "http_port $porta" >>/etc/squid/squid.conf
				service squid restart >/dev/null 2>&1
				echo "PasswordAuthentication yes" >/etc/ssh/sshd_config
				service ssh restart
			}
			fun_bar 'inst_pct'
			echo -e "\n\033[1;32mSQUID PROXY INSTALLED!\033[0m"
			echo -e "\033[1;33mPORT: \033[1;37m$porta\033[0m"
			sleep 3
			clear
			fun_conexao
		fi
	}

	fun_conexao() {
		while true $x != "ok"; do
			[[ ! -e '/home/sshplus' ]] && exit 0
			clear
			echo -e "\E[44;1;37m              CONNECTION MODE                 \E[0m\n"

			# Services status check
			echo -e "\033[1;32mSERVICE: \033[1;33mOPENSSH \033[1;32mPORT: \033[1;37m$(grep 'Port' /etc/ssh/sshd_config | cut -d' ' -f2 | grep -v 'no' | xargs)" && sts6="\033[1;32m◉ "

			[[ "$(netstat -tlpn | grep 'squid' | wc -l)" != '0' ]] && {
				echo -e "\033[1;32mSERVICE: \033[1;33mSQUID \033[1;32mPORT: \033[1;37m$(netstat -nplt | grep 'squid' | awk -F ":" {'print $4'} | xargs)"
				sts1="\033[1;32m◉ "
			} || {
				sts1="\033[1;31m○ "
			}

			[[ "$(netstat -tlpn | grep 'dropbear' | wc -l)" != '0' ]] && {
				echo -e "\033[1;32mSERVICE: \033[1;33mDROPBEAR \033[1;32mPORT: \033[1;37m$(netstat -nplt | grep 'dropbear' | awk -F ":" {'print $4'} | xargs)"
				sts2="\033[1;32m◉ "
			} || {
				sts2="\033[1;31m○ "
			}

			[[ -e "/etc/stunnel/stunnel.conf" ]] && {
				echo -e "\033[1;32mSERVICE: \033[1;33mSSL TUNNEL \033[1;32mPORT: \033[1;37m$(netstat -nplt | grep 'stunnel' | awk {'print $4'} | cut -d: -f2 | xargs)"
				sts3="\033[1;32m◉ "
			} || {
				sts3="\033[1;31m○ "
			}

			[[ "$(netstat -tlpn | grep 'python' | wc -l)" != '0' ]] && {
				echo -e "\033[1;32mSERVICE: \033[1;33mPROXY SOCKS \033[1;32mPORT: \033[1;37m$(netstat -nplt | grep 'python' | awk {'print $4'} | cut -d: -f2 | xargs)"
				sts4="\033[1;32m◉ "
			} || {
				sts4="\033[1;31m○ "
			}

			[[ "$(netstat -tlpn | grep 'openvpn' | wc -l)" != '0' ]] && {
				echo -e "\033[1;32mSERVICE: \033[1;33mOPENVPN \033[1;32mPORT: \033[1;37m$(netstat -nplt | grep 'openvpn' | awk {'print $4'} | cut -d: -f2 | xargs)"
				sts5="\033[1;32m◉ "
			} || {
				sts5="\033[1;31m○ "
			}

			[[ "$(netstat -tlpn | grep 'sslh' | wc -l)" != '0' ]] && {
				echo -e "\033[1;32mSERVICE: \033[1;33mSSLH \033[1;32mPORT: \033[1;37m$(netstat -nplt | grep 'sslh' | awk {'print $4'} | cut -d: -f2 | xargs)"
				sts7="\033[1;32m◉ "
			} || {
				sts7="\033[1;31m○ "
			}

			[[ "$(netstat -tlpn | grep 'docker' | wc -l)" != '0' ]] && {
				echo -e "\033[1;32mSERVICE: \033[1;33mCHISEL \033[1;32mPORT: \033[1;37m$(netstat -nplt | grep 'docker' | awk {'print $4'} | cut -d: -f2 | xargs)"
				sts8="\033[1;32m◉ "
			} || {
				sts8="\033[1;31m○ "
			}

			[[ "$(ps x | grep 'slowdns' | grep -v 'grep' | wc -l)" != '0' ]] && {
				sts9="\033[1;32m◉ "
			} || {
				sts9="\033[1;31m○ "
			}

			[[ "$(netstat -tunlp | grep 'v2ray' | wc -l)" != '0' ]] && {
				xv2ray="\033[1;32m◉ "
			} || {
				xv2ray="\033[1;31m○ "
			}

			[[ "$(netstat -tunlp | grep 'trojan-go' | wc -l)" != '0' ]] && {
				trojansts="\033[1;32m◉ "
			} || {
				trojansts="\033[1;31m○ "
			}

			[[ "$(systemctl is-active wg-quick@wg0)" == "active" ]] && {
				wireguardsts="\033[1;32m◉ "
			} || {
				wireguardsts="\033[1;31m○ "
			}

			[[ "$(systemctl is-active shadowsocks-libev)" == "active" ]] && {
				shadowsockssts="\033[1;32m◉ "
			} || {
				shadowsockssts="\033[1;31m○ "
			}

			[[ "$(systemctl is-active hysteria-server)" == "active" ]] && {
				hysteria1sts="\033[1;32m◉ "
			} || {
				hysteria1sts="\033[1;31m○ "
			}

			[[ "$(systemctl is-active hysteria2-server)" == "active" ]] && {
				hysteria2sts="\033[1;32m◉ "
			} || {
				hysteria2sts="\033[1;31m○ "
			}

			[[ "$(systemctl is-active ws-stunnel)" == "active" ]] && {
				websocketsts="\033[1;32m◉ "
			} || {
				websocketsts="\033[1;31m○ "
			}

			[[ "$(systemctl is-active psiphon)" == "active" ]] && {
				psiphonsts="\033[1;32m◉ "
			} || {
				psiphonsts="\033[1;31m○ "
			}

			echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
			echo ""
			echo -e "\033[1;35m═══ VPN PROTOCOLS ═══\033[0m"
			echo -e "\033[1;31m[\033[1;36m01\033[1;31m] \033[1;37m• \033[1;33mOPENVPN $sts5"
			echo -e "\033[1;31m[\033[1;36m02\033[1;31m] \033[1;37m• \033[1;33mWIREGUARD $wireguardsts"
			echo -e "\033[1;31m[\033[1;36m03\033[1;31m] \033[1;37m• \033[1;33mV2RAY $xv2ray"
			echo ""
			echo -e "\033[1;35m═══ PROXY PROTOCOLS ═══\033[0m"
			echo -e "\033[1;31m[\033[1;36m04\033[1;31m] \033[1;37m• \033[1;33mSHADOWSOCKS $shadowsockssts"
			echo -e "\033[1;31m[\033[1;36m05\033[1;31m] \033[1;37m• \033[1;33mHYSTERIA v1 $hysteria1sts"
			echo -e "\033[1;31m[\033[1;36m06\033[1;31m] \033[1;37m• \033[1;33mHYSTERIA v2 $hysteria2sts"
			echo -e "\033[1;31m[\033[1;36m07\033[1;31m] \033[1;37m• \033[1;33mTROJAN-GO $trojansts"
			echo ""
			echo -e "\033[1;35m═══ TUNNEL PROTOCOLS ═══\033[0m"
			echo -e "\033[1;31m[\033[1;36m08\033[1;31m] \033[1;37m• \033[1;33mWEBSOCKET $websocketsts"
			echo -e "\033[1;31m[\033[1;36m09\033[1;31m] \033[1;37m• \033[1;33mSSL TUNNEL $sts3"
			echo -e "\033[1;31m[\033[1;36m10\033[1;31m] \033[1;37m• \033[1;33mSLOWDNS $sts9"
			echo -e "\033[1;31m[\033[1;36m11\033[1;31m] \033[1;37m• \033[1;33mPSIPHON $psiphonsts"
			echo ""
			echo -e "\033[1;35m═══ SSH SERVICES ═══\033[0m"
			echo -e "\033[1;31m[\033[1;36m12\033[1;31m] \033[1;37m• \033[1;33mOPENSSH $sts6"
			echo -e "\033[1;31m[\033[1;36m13\033[1;31m] \033[1;37m• \033[1;33mDROPBEAR $sts2"
			echo -e "\033[1;31m[\033[1;36m14\033[1;31m] \033[1;37m• \033[1;33mSQUID PROXY $sts1"
			echo -e "\033[1;31m[\033[1;36m15\033[1;31m] \033[1;37m• \033[1;33mPROXY SOCKS $sts4"
			echo -e "\033[1;31m[\033[1;36m16\033[1;31m] \033[1;37m• \033[1;33mSSLH $sts7"
			echo -e "\033[1;31m[\033[1;36m17\033[1;31m] \033[1;37m• \033[1;33mCHISEL $sts8"
			echo ""
			echo -e "\033[1;31m[\033[1;36m18\033[1;31m] \033[1;37m• \033[1;33mBACK \033[1;32m<\033[1;33m<\033[1;31m<"
			echo -e "\033[1;31m[\033[1;36m00\033[1;31m] \033[1;37m• \033[1;33mEXIT \033[1;32m<\033[1;33m<\033[1;31m< \033[0m"
			echo ""
			echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
			echo ""
			tput civis
			echo -ne "\033[1;32mSELECT AN OPTION \033[1;33m:\033[1;37m "
			read x
			tput cnorm
			clear
			case $x in
			1 | 01)
				bash /root/SSHPLUS-MANGER/Install/openvpn-install.sh
				;;
			2 | 02)
				install_wireguard
				;;
			3 | 03)
				v2raymanager
				exit
				;;
			4 | 04)
				install_shadowsocks
				;;
			5 | 05)
				install_hysteria1
				;;
			6 | 06)
				install_hysteria2
				;;
			7 | 07)
				trojan-go
				;;
			8 | 08)
				install_websocket
				;;
			9 | 09)
				bash /root/SSHPLUS-MANGER/Install/ssltunnel-install.sh
				;;
			10 | 10)
				slow_setup
				;;
			11 | 11)
				install_psiphon
				;;
			12 | 12)
				# OpenSSH management (keeping original function)
				echo -e "\033[1;33mOpenSSH is already active\033[0m"
				sleep 2
				;;
			13 | 13)
				# Dropbear management (keeping original function)
				echo -e "\033[1;33mDropbear management\033[0m"
				sleep 2
				;;
			14 | 14)
				inst_sqd
				;;
			15 | 15)
				# Proxy SOCKS management
				echo -e "\033[1;33mProxy SOCKS management\033[0m"
				sleep 2
				;;
			16 | 16)
				# SSLH management
				echo -e "\033[1;33mSSLH management\033[0m"
				sleep 2
				;;
			17 | 17)
				# Chisel management
				echo -e "\033[1;33mChisel management\033[0m"
				sleep 2
				;;
			18 | 18)
				menu
				;;
			0 | 00)
				echo -e "\033[1;31mExiting...\033[0m"
				sleep 2
				clear
				exit
				;;
			*)
				echo -e "\033[1;31mInvalid option!\033[0m"
				sleep 2
				;;
			esac
		done
	}
	fun_conexao
}
