	fun_sslh() {
		[[ "$(netstat -nltp | grep 'sslh' | wc -l)" = '0' ]] && {
			clear
			echo -e "\E[44;1;37m             SSLH INSTALLER               \E[0m\n"
			echo -e "\n\033[1;33m[\033[1;31m!\033[1;33m] \033[1;32mPORT \033[1;37m443 \033[1;32mWILL BE USED BY DEFAULT\033[0m\n"
			# SSLH and stunnel both want to bind 0.0.0.0:443. If stunnel is
			# already there, they will fight on every reboot and one of
			# them will silently fail. Refuse the install instead of
			# letting the user lock themselves out of SSL TUNNEL.
			if [[ -e /etc/stunnel/stunnel.conf ]] && netstat -nltp 2>/dev/null | awk '{print $4}' | grep -qE '(^|:)443$'; then
				echo -e "\n\033[1;31m[\033[1;33m!\033[1;31m] \033[1;33mSSL TUNNEL is already bound to port 443.\033[0m"
				echo -e "\033[1;33m    Remove SSL TUNNEL first or it will fight SSLH for the port.\033[0m"
				sleep 4
				fun_conexao
				return
			fi
			echo -ne "\033[1;32mDO YOU REALLY WANT TO INSTALL SSLH \033[1;31m? \033[1;33m[y/n]:\033[1;37m "
			read resp
			[[ "$resp" = 'y' ]] && {
				verif_ptrs 443
				fun_instsslh() {
					# Pick a single backend port. `xargs` of multiple
					# stunnel listeners would render `--ssl 127.0.0.1:A B`
					# which sslh rejects as a syntax error.
					[[ -e "/etc/stunnel/stunnel.conf" ]] && ptssl="$(netstat -nplt | grep 'stunnel' | awk '{print $4}' | cut -d: -f2 | head -n1)" || ptssl='3128'
					[[ -e "/etc/openvpn/server.conf" ]] && ptvpn="$(netstat -nplt | grep 'openvpn' | awk '{print $4}' | cut -d: -f2 | head -n1)" || ptvpn='1194'
					[[ -z "$ptssl" ]] && ptssl='3128'
					[[ -z "$ptvpn" ]] && ptvpn='1194'
					DEBIAN_FRONTEND=noninteractive apt-get -y install sslh
					echo -e "#Modo autónomo\n\nRUN=yes\n\nDAEMON=/usr/sbin/sslh\n\nDAEMON_OPTS='--user sslh --listen 0.0.0.0:443 --ssh 127.0.0.1:22 --ssl 127.0.0.1:$ptssl --http 127.0.0.1:80 --openvpn 127.0.0.1:$ptvpn --pidfile /var/run/sslh/sslh.pid'" >/etc/default/sslh
					[[ -f "/usr/sbin/ufw" ]] && ufw allow 443/tcp >/dev/null 2>&1
					/etc/init.d/sslh start && service sslh start
				}
				echo -e "\n\033[1;32mINSTALLING SSLH !\033[0m\n"
				fun_bar 'fun_instsslh'
				echo -e "\n\033[1;32mSTARTING SSLH !\033[0m\n"
				fun_bar '/etc/init.d/sslh restart && service sslh restart'
				[[ $(netstat -nplt | grep -w 'sslh' | wc -l) != '0' ]] && echo -e "\n\033[1;32mINSTALLED SUCCESSFULLY !\033[0m" || echo -e "\n\033[1;31mUNEXPECTED ERROR !\033[0m"
				sleep 3
				fun_conexao
			} || {
				echo -e "\n\033[1;31mReturning.."
				sleep 2
				fun_conexao
			}
		} || {
			clear
			echo -e "\E[41;1;37m             REMOVE SSLH               \E[0m\n"
			echo -ne "\033[1;32mDO YOU REALLY WANT TO REMOVE SSLH \033[1;31m? \033[1;33m[y/n]:\033[1;37m "
			read respo
			[[ "$respo" = "y" ]] && {
				fun_delsslh() {
					/etc/init.d/sslh stop && service sslh stop
					apt-get remove sslh -y
					apt-get purge sslh -y
				}
