#!/bin/bash
# Advanced Protocol Manager for SSHPLUS Manager
# Version: 2.0
# @MinaProNet

clear
[[ "$(whoami)" != "root" ]] && {
    echo -e "\033[1;31mError: You need to run as root\033[0m"
    exit 1
}

# Color codes
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;36m'
PURPLE='\033[1;35m'
NC='\033[0m' # No Color

# Check protocol status
check_protocol_status() {
    local protocol=$1
    case $protocol in
        "openvpn")
            systemctl is-active --quiet openvpn@server && echo -e "${GREEN}●${NC}" || echo -e "${RED}○${NC}"
            ;;
        "wireguard")
            systemctl is-active --quiet wg-quick@wg0 && echo -e "${GREEN}●${NC}" || echo -e "${RED}○${NC}"
            ;;
        "shadowsocks")
            systemctl is-active --quiet shadowsocks-libev && echo -e "${GREEN}●${NC}" || echo -e "${RED}○${NC}"
            ;;
        "hysteria1")
            systemctl is-active --quiet hysteria-server && echo -e "${GREEN}●${NC}" || echo -e "${RED}○${NC}"
            ;;
        "hysteria2")
            systemctl is-active --quiet hysteria2-server && echo -e "${GREEN}●${NC}" || echo -e "${RED}○${NC}"
            ;;
        "v2ray")
            systemctl is-active --quiet v2ray && echo -e "${GREEN}●${NC}" || echo -e "${RED}○${NC}"
            ;;
        "trojan")
            systemctl is-active --quiet trojan && echo -e "${GREEN}●${NC}" || echo -e "${RED}○${NC}"
            ;;
        "websocket")
            systemctl is-active --quiet ws-stunnel && echo -e "${GREEN}●${NC}" || echo -e "${RED}○${NC}"
            ;;
        "ssltunnel")
            systemctl is-active --quiet stunnel4 && echo -e "${GREEN}●${NC}" || echo -e "${RED}○${NC}"
            ;;
        "slowdns")
            systemctl is-active --quiet slowdns && echo -e "${GREEN}●${NC}" || echo -e "${RED}○${NC}"
            ;;
        "psiphon")
            systemctl is-active --quiet psiphon && echo -e "${GREEN}●${NC}" || echo -e "${RED}○${NC}"
            ;;
    esac
}

# Main menu
show_menu() {
    clear
    echo -e "${GREEN}════════════════════════════════════════${NC}"
    echo -e "${YELLOW}   PROTOCOL MANAGER - SSHPLUS v2.0${NC}"
    echo -e "${PURPLE}           @MinaProNet${NC}"
    echo -e "${GREEN}════════════════════════════════════════${NC}"
    echo ""
    echo -e "${BLUE}Status: ${GREEN}●${NC} Running | ${RED}○${NC} Stopped"
    echo ""
    echo -e "${YELLOW}═══ VPN Protocols ═══${NC}"
    echo -e "$(check_protocol_status openvpn) [1] OpenVPN"
    echo -e "$(check_protocol_status wireguard) [2] WireGuard"
    echo -e "$(check_protocol_status v2ray) [3] V2Ray"
    echo ""
    echo -e "${YELLOW}═══ Proxy Protocols ═══${NC}"
    echo -e "$(check_protocol_status shadowsocks) [4] Shadowsocks"
    echo -e "$(check_protocol_status hysteria1) [5] Hysteria v1"
    echo -e "$(check_protocol_status hysteria2) [6] Hysteria v2"
    echo -e "$(check_protocol_status trojan) [7] Trojan-Go"
    echo ""
    echo -e "${YELLOW}═══ Tunnel Protocols ═══${NC}"
    echo -e "$(check_protocol_status websocket) [8] WebSocket"
    echo -e "$(check_protocol_status ssltunnel) [9] SSL Tunnel"
    echo -e "$(check_protocol_status slowdns) [10] SlowDNS"
    echo -e "$(check_protocol_status psiphon) [11] Psiphon"
    echo ""
    echo -e "${YELLOW}═══ Management ═══${NC}"
    echo -e "[12] Install All Protocols"
    echo -e "[13] View All Status"
    echo -e "[14] Protocol Information"
    echo -e "[0] Exit"
    echo ""
    echo -e "${GREEN}════════════════════════════════════════${NC}"
    echo -ne "${BLUE}Select option:${NC} "
}

# Install protocol function
install_protocol() {
    local protocol=$1
    local script_path=$2

    if [[ -f "$script_path" ]]; then
        chmod +x "$script_path"
        bash "$script_path"
    else
        echo -e "${RED}Installation script not found: $script_path${NC}"
        sleep 2
    fi
}

# Protocol management function
manage_protocol() {
    local protocol=$1
    local service=$2
    local install_script=$3

    clear
    echo -e "${GREEN}════════════════════════════════════════${NC}"
    echo -e "${YELLOW}      $protocol Management${NC}"
    echo -e "${GREEN}════════════════════════════════════════${NC}"
    echo ""

    if systemctl is-active --quiet $service 2>/dev/null; then
        echo -e "${GREEN}Status: Running${NC}"
        echo ""
        echo -e "[1] Stop $protocol"
        echo -e "[2] Restart $protocol"
        echo -e "[3] View logs"
        echo -e "[4] Show configuration"
        echo -e "[5] Uninstall $protocol"
        echo -e "[0] Back"
        echo ""
        read -p "Select option: " opt

        case $opt in
            1)
                systemctl stop $service
                echo -e "${YELLOW}$protocol stopped${NC}"
                sleep 2
                ;;
            2)
                systemctl restart $service
                echo -e "${GREEN}$protocol restarted${NC}"
                sleep 2
                ;;
            3)
                journalctl -u $service -n 50 --no-pager
                echo ""
                read -p "Press Enter to continue..."
                ;;
            4)
                case $protocol in
                    "OpenVPN") cat /etc/openvpn/server.conf 2>/dev/null ;;
                    "WireGuard") cat /etc/wireguard/wg0.conf 2>/dev/null ;;
                    "Shadowsocks") cat /etc/shadowsocks-libev/config.json 2>/dev/null ;;
                    "Hysteria"*) cat /etc/hysteria*/config.* 2>/dev/null ;;
                    "V2Ray") cat /usr/local/etc/v2ray/config.json 2>/dev/null ;;
                    "WebSocket") cat /etc/websocket/ws-proxy.py 2>/dev/null ;;
                    "SSL Tunnel") cat /etc/stunnel/stunnel.conf 2>/dev/null ;;
                    "SlowDNS") slowdns-info 2>/dev/null ;;
                    "Psiphon") cat /opt/psiphon/config.json 2>/dev/null ;;
                esac
                echo ""
                read -p "Press Enter to continue..."
                ;;
            5)
                read -p "Are you sure you want to uninstall? [y/N]: " confirm
                if [[ $confirm =~ ^[Yy]$ ]]; then
                    systemctl stop $service
                    systemctl disable $service
                    echo -e "${GREEN}$protocol stopped and disabled${NC}"
                    sleep 2
                fi
                ;;
        esac
    else
        echo -e "${RED}Status: Stopped/Not Installed${NC}"
        echo ""
        echo -e "[1] Start $protocol (if installed)"
        echo -e "[2] Install/Reinstall $protocol"
        echo -e "[0] Back"
        echo ""
        read -p "Select option: " opt

        case $opt in
            1)
                systemctl start $service 2>/dev/null && {
                    echo -e "${GREEN}$protocol started${NC}"
                } || {
                    echo -e "${RED}Failed to start. Maybe not installed?${NC}"
                }
                sleep 2
                ;;
            2)
                install_protocol "$protocol" "$install_script"
                ;;
        esac
    fi
}

# View all status
view_all_status() {
    clear
    echo -e "${GREEN}════════════════════════════════════════${NC}"
    echo -e "${YELLOW}      Protocol Status Overview${NC}"
    echo -e "${GREEN}════════════════════════════════════════${NC}"
    echo ""

    protocols=(
        "openvpn@server:OpenVPN:1194"
        "wg-quick@wg0:WireGuard:51820"
        "shadowsocks-libev:Shadowsocks:8388"
        "hysteria-server:Hysteria v1:36712"
        "hysteria2-server:Hysteria v2:443"
        "v2ray:V2Ray:10085"
        "trojan:Trojan-Go:443"
        "ws-stunnel:WebSocket:80"
        "stunnel4:SSL Tunnel:443"
        "slowdns:SlowDNS:53"
        "psiphon:Psiphon:4443"
    )

    printf "%-20s %-15s %-10s\n" "Protocol" "Status" "Port"
    echo -e "${GREEN}────────────────────────────────────────${NC}"

    for proto in "${protocols[@]}"; do
        IFS=':' read -r service name port <<< "$proto"
        if systemctl is-active --quiet $service 2>/dev/null; then
            status="${GREEN}Running${NC}"
        else
            status="${RED}Stopped${NC}"
        fi
        printf "%-20s %-25s %-10s\n" "$name" "$(echo -e $status)" "$port"
    done

    echo ""
    echo -e "${GREEN}════════════════════════════════════════${NC}"
    read -p "Press Enter to continue..."
}

# Protocol information
protocol_info() {
    clear
    echo -e "${GREEN}════════════════════════════════════════${NC}"
    echo -e "${YELLOW}      Protocol Information${NC}"
    echo -e "${GREEN}════════════════════════════════════════${NC}"
    echo ""
    echo -e "${BLUE}VPN Protocols:${NC}"
    echo -e "  ${YELLOW}OpenVPN${NC}: Industry standard VPN, highly compatible"
    echo -e "  ${YELLOW}WireGuard${NC}: Modern, fast, simple VPN protocol"
    echo -e "  ${YELLOW}V2Ray${NC}: Advanced proxy with VMess/VLESS/Trojan"
    echo ""
    echo -e "${BLUE}Proxy Protocols:${NC}"
    echo -e "  ${YELLOW}Shadowsocks${NC}: SOCKS5 proxy for bypassing censorship"
    echo -e "  ${YELLOW}Hysteria v1${NC}: QUIC-based protocol for lossy networks"
    echo -e "  ${YELLOW}Hysteria v2${NC}: Latest version with improved features"
    echo -e "  ${YELLOW}Trojan-Go${NC}: Stealth proxy mimicking HTTPS traffic"
    echo ""
    echo -e "${BLUE}Tunnel Protocols:${NC}"
    echo -e "  ${YELLOW}WebSocket${NC}: WebSocket-based tunnel for SSH/VPN"
    echo -e "  ${YELLOW}SSL Tunnel${NC}: SSL/TLS tunnel (Stunnel)"
    echo -e "  ${YELLOW}SlowDNS${NC}: DNS tunneling for restricted networks"
    echo -e "  ${YELLOW}Psiphon${NC}: Multi-protocol tunnel with obfuscation"
    echo ""
    echo -e "${GREEN}════════════════════════════════════════${NC}"
    read -p "Press Enter to continue..."
}

# Install all protocols
install_all() {
    clear
    echo -e "${GREEN}════════════════════════════════════════${NC}"
    echo -e "${YELLOW}    Installing All Protocols${NC}"
    echo -e "${GREEN}════════════════════════════════════════${NC}"
    echo ""

    read -p "This will install all available protocols. Continue? [y/N]: " confirm
    if [[ ! $confirm =~ ^[Yy]$ ]]; then
        return
    fi

    scripts=(
        "openvpn-install.sh:OpenVPN"
        "wireguard-install.sh:WireGuard"
        "shadowsocks-install.sh:Shadowsocks"
        "hysteria1-install.sh:Hysteria v1"
        "hysteria2-install.sh:Hysteria v2"
        "v2ray-install.sh:V2Ray"
        "websocket-install.sh:WebSocket"
        "ssltunnel-install.sh:SSL Tunnel"
        "slowdns-install.sh:SlowDNS"
        "psiphon-install.sh:Psiphon"
    )

    for script_info in "${scripts[@]}"; do
        IFS=':' read -r script name <<< "$script_info"
        echo -e "${BLUE}Installing $name...${NC}"
        install_protocol "$name" "/root/SSHPLUS-MANGER/Install/$script"
        sleep 1
    done

    echo ""
    echo -e "${GREEN}All protocols installed!${NC}"
    read -p "Press Enter to continue..."
}

# Main loop
while true; do
    show_menu
    read option

    case $option in
        1) manage_protocol "OpenVPN" "openvpn@server" "/root/SSHPLUS-MANGER/Install/openvpn-install.sh" ;;
        2) manage_protocol "WireGuard" "wg-quick@wg0" "/root/SSHPLUS-MANGER/Install/wireguard-install.sh" ;;
        3) manage_protocol "V2Ray" "v2ray" "/root/SSHPLUS-MANGER/Install/v2ray-install.sh" ;;
        4) manage_protocol "Shadowsocks" "shadowsocks-libev" "/root/SSHPLUS-MANGER/Install/shadowsocks-install.sh" ;;
        5) manage_protocol "Hysteria v1" "hysteria-server" "/root/SSHPLUS-MANGER/Install/hysteria1-install.sh" ;;
        6) manage_protocol "Hysteria v2" "hysteria2-server" "/root/SSHPLUS-MANGER/Install/hysteria2-install.sh" ;;
        7) manage_protocol "Trojan-Go" "trojan" "/root/SSHPLUS-MANGER/Modulos/trojan-go" ;;
        8) manage_protocol "WebSocket" "ws-stunnel" "/root/SSHPLUS-MANGER/Install/websocket-install.sh" ;;
        9) manage_protocol "SSL Tunnel" "stunnel4" "/root/SSHPLUS-MANGER/Install/ssltunnel-install.sh" ;;
        10) manage_protocol "SlowDNS" "slowdns" "/root/SSHPLUS-MANGER/Install/slowdns-install.sh" ;;
        11) manage_protocol "Psiphon" "psiphon" "/root/SSHPLUS-MANGER/Install/psiphon-install.sh" ;;
        12) install_all ;;
        13) view_all_status ;;
        14) protocol_info ;;
        0) clear; exit 0 ;;
        *) echo -e "${RED}Invalid option!${NC}"; sleep 1 ;;
    esac
done
