#!/bin/bash
# Protocol Manager for SSHPLUS Manager
# Version: 1.0

clear
[[ "$(whoami)" != "root" ]] && {
    echo -e "\033[1;31mError: You need to run as root\033[0m"
    exit 1
}

# Color codes
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;36m'
NC='\033[0m' # No Color

# Check protocol status
check_protocol_status() {
    local protocol=$1
    case $protocol in
        "openvpn")
            systemctl is-active --quiet openvpn@server && echo -e "${GREEN}●${NC}" || echo -e "${RED}○${NC}"
            ;;
        "wireguard")
            systemctl is-active --quiet wg-quick@wg0 && echo -e "${GREEN}●${NC}" || echo -e "${RED}○${NC}"
            ;;
        "shadowsocks")
            systemctl is-active --quiet shadowsocks-libev && echo -e "${GREEN}●${NC}" || echo -e "${RED}○${NC}"
            ;;
        "hysteria")
            systemctl is-active --quiet hysteria-server && echo -e "${GREEN}●${NC}" || echo -e "${RED}○${NC}"
            ;;
        "v2ray")
            systemctl is-active --quiet v2ray && echo -e "${GREEN}●${NC}" || echo -e "${RED}○${NC}"
            ;;
        "trojan")
            systemctl is-active --quiet trojan && echo -e "${GREEN}●${NC}" || echo -e "${RED}○${NC}"
            ;;
    esac
}

# Main menu
show_menu() {
    clear
    echo -e "${GREEN}════════════════════════════════════════${NC}"
    echo -e "${YELLOW}      PROTOCOL MANAGER - SSHPLUS${NC}"
    echo -e "${GREEN}════════════════════════════════════════${NC}"
    echo ""
    echo -e "${BLUE}Status: ${GREEN}●${NC} Running | ${RED}○${NC} Stopped"
    echo ""
    echo -e "$(check_protocol_status openvpn) [1] OpenVPN"
    echo -e "$(check_protocol_status wireguard) [2] WireGuard"
    echo -e "$(check_protocol_status shadowsocks) [3] Shadowsocks"
    echo -e "$(check_protocol_status hysteria) [4] Hysteria"
    echo -e "$(check_protocol_status v2ray) [5] V2Ray"
    echo -e "$(check_protocol_status trojan) [6] Trojan-Go"
    echo ""
    echo -e "${YELLOW}[7]${NC} Install All Protocols"
    echo -e "${YELLOW}[8]${NC} View All Protocol Status"
    echo -e "${YELLOW}[0]${NC} Back to Main Menu"
    echo ""
    echo -e "${GREEN}════════════════════════════════════════${NC}"
    echo -ne "${BLUE}Select option:${NC} "
}

# Install protocol function
install_protocol() {
    local protocol=$1
    local script_path=$2

    if [[ -f "$script_path" ]]; then
        chmod +x "$script_path"
        bash "$script_path"
    else
        echo -e "${RED}Installation script not found: $script_path${NC}"
        sleep 2
    fi
}

# Protocol management function
manage_protocol() {
    local protocol=$1
    local service=$2

    clear
    echo -e "${GREEN}════════════════════════════════════════${NC}"
    echo -e "${YELLOW}      $protocol Management${NC}"
    echo -e "${GREEN}════════════════════════════════════════${NC}"
    echo ""

    if systemctl is-active --quiet $service; then
        echo -e "${GREEN}Status: Running${NC}"
        echo ""
        echo -e "[1] Stop $protocol"
        echo -e "[2] Restart $protocol"
        echo -e "[3] View logs"
        echo -e "[4] Uninstall $protocol"
        echo -e "[0] Back"
        echo ""
        read -p "Select option: " opt

        case $opt in
            1)
                systemctl stop $service
                echo -e "${YELLOW}$protocol stopped${NC}"
                sleep 2
                ;;
            2)
                systemctl restart $service
                echo -e "${GREEN}$protocol restarted${NC}"
                sleep 2
                ;;
            3)
                journalctl -u $service -n 50 --no-pager
                echo ""
                read -p "Press Enter to continue..."
                ;;
            4)
                read -p "Are you sure you want to uninstall? [y/N]: " confirm
                if [[ $confirm =~ ^[Yy]$ ]]; then
                    systemctl stop $service
                    systemctl disable $service
                    echo -e "${GREEN}$protocol stopped and disabled${NC}"
                    sleep 2
                fi
                ;;
        esac
    else
        echo -e "${RED}Status: Stopped${NC}"
        echo ""
        echo -e "[1] Start $protocol"
        echo -e "[2] Install/Reinstall $protocol"
        echo -e "[0] Back"
        echo ""
        read -p "Select option: " opt

        case $opt in
            1)
                systemctl start $service
                echo -e "${GREEN}$protocol started${NC}"
                sleep 2
                ;;
            2)
                case $protocol in
                    "OpenVPN")
                        install_protocol "OpenVPN" "/home/user/SSHPLUS-MANGER/Install/openvpn-install.sh"
                        ;;
                    "WireGuard")
                        install_protocol "WireGuard" "/home/user/SSHPLUS-MANGER/Install/wireguard-install.sh"
                        ;;
                    "Shadowsocks")
                        install_protocol "Shadowsocks" "/home/user/SSHPLUS-MANGER/Install/shadowsocks-install.sh"
                        ;;
                    "Hysteria")
                        install_protocol "Hysteria" "/home/user/SSHPLUS-MANGER/Install/hysteria-install.sh"
                        ;;
                esac
                ;;
        esac
    fi
}

# View all status
view_all_status() {
    clear
    echo -e "${GREEN}════════════════════════════════════════${NC}"
    echo -e "${YELLOW}      Protocol Status Overview${NC}"
    echo -e "${GREEN}════════════════════════════════════════${NC}"
    echo ""

    protocols=("openvpn@server:OpenVPN" "wg-quick@wg0:WireGuard" "shadowsocks-libev:Shadowsocks"
               "hysteria-server:Hysteria" "v2ray:V2Ray" "trojan:Trojan-Go")

    for proto in "${protocols[@]}"; do
        IFS=':' read -r service name <<< "$proto"
        if systemctl is-active --quiet $service 2>/dev/null; then
            status="${GREEN}Running${NC}"
            port=$(netstat -tlnp 2>/dev/null | grep -i "$name" | awk '{print $4}' | cut -d: -f2 | head -1)
        else
            status="${RED}Stopped${NC}"
            port="-"
        fi
        printf "%-20s %-15s Port: %s\n" "$name" "$(echo -e $status)" "$port"
    done

    echo ""
    echo -e "${GREEN}════════════════════════════════════════${NC}"
    read -p "Press Enter to continue..."
}

# Install all protocols
install_all() {
    clear
    echo -e "${GREEN}════════════════════════════════════════${NC}"
    echo -e "${YELLOW}    Installing All Protocols${NC}"
    echo -e "${GREEN}════════════════════════════════════════${NC}"
    echo ""

    read -p "This will install all available protocols. Continue? [y/N]: " confirm
    if [[ ! $confirm =~ ^[Yy]$ ]]; then
        return
    fi

    echo -e "${BLUE}Installing OpenVPN...${NC}"
    install_protocol "OpenVPN" "/home/user/SSHPLUS-MANGER/Install/openvpn-install.sh"

    echo -e "${BLUE}Installing WireGuard...${NC}"
    install_protocol "WireGuard" "/home/user/SSHPLUS-MANGER/Install/wireguard-install.sh"

    echo -e "${BLUE}Installing Shadowsocks...${NC}"
    install_protocol "Shadowsocks" "/home/user/SSHPLUS-MANGER/Install/shadowsocks-install.sh"

    echo -e "${BLUE}Installing Hysteria...${NC}"
    install_protocol "Hysteria" "/home/user/SSHPLUS-MANGER/Install/hysteria-install.sh"

    echo ""
    echo -e "${GREEN}All protocols installed!${NC}"
    read -p "Press Enter to continue..."
}

# Main loop
while true; do
    show_menu
    read option

    case $option in
        1) manage_protocol "OpenVPN" "openvpn@server" ;;
        2) manage_protocol "WireGuard" "wg-quick@wg0" ;;
        3) manage_protocol "Shadowsocks" "shadowsocks-libev" ;;
        4) manage_protocol "Hysteria" "hysteria-server" ;;
        5) v2raymanager ;;
        6) manage_protocol "Trojan-Go" "trojan" ;;
        7) install_all ;;
        8) view_all_status ;;
        0) clear; exit 0 ;;
        *) echo -e "${RED}Invalid option!${NC}"; sleep 1 ;;
    esac
done
