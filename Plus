    rm $HOME/Plus >/dev/null 2>&1
    exit 0
}

# ---------------------------------------------------------------
# Auto-install mode
# ---------------------------------------------------------------
# Enables silent / unattended installation. Triggered by:
#   * SSHPLUS_AUTO=1 in the environment
#   * --auto or -y on the command line
#   * stdin is not a TTY (piped install: curl … | bash)
#
# When enabled the script:
#   * Skips the "GENERATE FREE KEY [Y/N]" prompt (defaults to Y)
#   * Auto-detects the VPS architecture from `uname -m` so the user
#     never has to pick [1] x86_64 vs [2] aarch64 by hand
#   * Auto-confirms the "Keep current database" prompt with [1]
# Interactive runs (real TTY, no flag, no env var) are unchanged —
# the prompts still appear so a human can override the defaults.
SSHPLUS_AUTO="${SSHPLUS_AUTO:-0}"
for _arg in "$@"; do
    case "$_arg" in
        --auto|-y|--yes|--unattended) SSHPLUS_AUTO=1 ;;
    esac
done
[[ ! -t 0 ]] && SSHPLUS_AUTO=1

# Detect architecture once so both interactive and auto modes can use
# it. Map every value uname -m might return on a Linux VPS onto the
# script's [1]/[2] menu options.
_uname_m=$(uname -m 2>/dev/null)
case "$_uname_m" in
    x86_64|amd64)          AUTO_ARCH=1 ; AUTO_ARCH_NAME="x86_64" ;;
    aarch64|arm64|armv8*)  AUTO_ARCH=2 ; AUTO_ARCH_NAME="aarch64(ARM)" ;;
    *)                     AUTO_ARCH="" ; AUTO_ARCH_NAME="$_uname_m" ;;
esac

# Force IPv4 + cap timeouts; most VPS images advertise AAAA but route only v4.
cat >/etc/apt/apt.conf.d/99force-ipv4 <<'APT_CONF'
Acquire::ForceIPv4 "true";
Acquire::http::Timeout "15";
Acquire::https::Timeout "15";
Acquire::Retries "2";
APT_CONF
grep -q '^inet4_only' /etc/wgetrc 2>/dev/null || cat >>/etc/wgetrc <<'WGET_CONF'
inet4_only = on
timeout = 30
tries = 2
WGET_CONF
export DEBIAN_FRONTEND=noninteractive
_lnk=$(echo 'z1:y#x.5s0ul&p4hs$s.0a72d*n-e!v89e032:3r' | sed -e 's/[^a-z.]//ig' | rev)
_Ink=$(echo '/3×u3#s87r/l32o4×c1a×l1/83×l24×i0b×' | sed -e 's/[^a-z/]//ig')
_1nk=$(echo '/3×u3#s×87r/83×l2×4×i0b×' | sed -e 's/[^a-z/]//ig')
cd $HOME
fun_bar() {
    comando[0]="$1"
    comando[1]="$2"
    (
        [[ -e $HOME/fim ]] && rm $HOME/fim
        ${comando[0]} -y >/dev/null 2>&1
        ${comando[1]} -y >/dev/null 2>&1
        touch $HOME/fim
    ) >/dev/null 2>&1 &
    tput civis
    echo -ne "  \033[1;33mPLEASE WAIT \033[1;37m- \033[1;33m["
    while true; do
        for ((i = 0; i < 18; i++)); do
            echo -ne "\033[1;31m#"
            sleep 0.1s
        done
        [[ -e $HOME/fim ]] && rm $HOME/fim && break
        echo -e "\033[1;33m]"
        sleep 1s
        tput cuu1
        tput dl1
        echo -ne "  \033[1;33mPLEASE WAIT \033[1;37m- \033[1;33m["
    done
    echo -e "\033[1;33m]\033[1;37m -\033[1;32m OK !\033[1;37m"
    tput cnorm
}
function verif_key() {
    krm=$(echo '5:q-3gs2.o7%8:1' | rev)
    chmod +x $_Ink/list >/dev/null 2>&1
    [[ ! -e "$_Ink/list" ]] && {
